DATABASE_URL="postgresql://postgres:postgres@db:5432/futurerealm_sms?schema=public"
DIRECT_URL="postgresql://postgres:postgres@db:5432/futurerealm_sms?schema=public"
APP_URL="http://localhost:3000"
NEST_API_URL="http://localhost:4000"
API_PORT="4000"
# On Vercel, leave NEST_API_URL unset so /api/* is served by the bundled Nest function.
# Set APP_URL to your production domain, for example https://school.example.com
JWT_SECRET="replace-with-32-char-secret"
DEMO_MODE="true"
DEFAULT_SCHOOL_SLUG="greenfield-college"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_PUBLIC_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="FutureRealm SMS <noreply@futurerealm.local>"

# Delivery of queued SMS / email. Off until switched on AND a carrier has keys; only messages queued after DELIVERY_SINCE
# (default: when the API started) are ever sent, so old demo rows never reach real phones.
DELIVERY_ENABLED="false"
DELIVERY_SINCE=""
DELIVERY_INTERVAL_SECONDS="60"
TERMII_API_KEY=""
TERMII_SENDER_ID=""

# Principal, Proprietor and Bursar sign-ins ask for a code sent by email. That only works where mail can be delivered, so
# it is on when SMTP_HOST is set. "on" forces it, "off" disables it.
AUTH_EMAIL_MFA=""
REPORT_SCHEDULER=""

# Error reporting (optional). Leave empty and nothing is sent; set it on staging and production.
NEXT_PUBLIC_SENTRY_DSN=

# Product analytics (optional, PostHog). Leave empty and nothing is sent. Anonymous, no recording, route-only page views.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Readable error reports: set all three at build time to upload source maps to Sentry (optional).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Draft translations (Yoruba, Hausa, Igbo) stay off until a fluent speaker has reviewed them — see src/i18n/locales.ts.
NEXT_PUBLIC_ENABLE_DRAFT_LOCALES=false
