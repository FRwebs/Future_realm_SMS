{
  "name": "futurerealm-sms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "next dev",
    "dev:api": "npm run build:api && node --env-file=.env dist/api/backend/src/main.js",
    "build": "npm run prisma:generate && npm run prisma:deploy && npm run build:api && npm run build:web",
    "build:web": "next build",
    "build:api": "tsc -p backend/tsconfig.build.json && tsc-alias -p backend/tsconfig.build.json",
    "start": "concurrently -k -n api,web -c green,blue \"npm:start:api\" \"npm:start:web\"",
    "start:web": "next start",
    "start:api": "node --env-file=.env dist/api/backend/src/main.js",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:use:local": "node scripts/switch-db-profile.mjs local",
    "db:use:remote": "node scripts/switch-db-profile.mjs remote",
    "db:which": "node scripts/switch-db-profile.mjs status"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.2",
    "@nestjs/core": "^10.4.2",
    "@nestjs/platform-express": "^10.4.2",
    "@nestjs/swagger": "^8.1.0",
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "concurrently": "^9.0.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "jose": "^5.9.3",
    "lucide-react": "^0.469.0",
    "next": "^15.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@next/eslint-plugin-next": "^15.0.0",
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.4",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.12.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.13",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.1",
    "typescript-eslint": "^8.8.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}
