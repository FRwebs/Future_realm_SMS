{
  "name": "futurerealm-sms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "next dev",
    "dev:api": "npm run build:api && node --env-file=.env dist/api/backend/src/main.js",
    "build": "npm run prisma:generate && npm run prisma:deploy && npm run build:api && npm run build:web",
    "build:web": "next build",
    "build:api": "tsc -p backend/tsconfig.build.json && tsc-alias -p backend/tsconfig.build.json",
    "start": "concurrently -k -n api,web -c green,blue \"npm:start:api\" \"npm:start:web\"",
    "start:web": "next start",
    "start:api": "node --env-file=.env dist/api/backend/src/main.js",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:use:local": "node scripts/switch-db-profile.mjs local",
    "db:use:remote": "node scripts/switch-db-profile.mjs remote",
    "db:which": "node scripts/switch-db-profile.mjs status",
    "knip": "knip",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "api:types": "node scripts/generate-api-types.mjs",
    "test:visual": "playwright test tests/e2e/visual.spec.ts",
    "analyze": "ANALYZE=true next build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@nestjs/common": "^10.4.2",
    "@nestjs/core": "^10.4.2",
    "@nestjs/platform-express": "^10.4.2",
    "@nestjs/swagger": "^8.1.0",
    "@prisma/client": "^5.20.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/nextjs": "^11.9.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-table": "^9.3.1",
    "@types/compression": "^1.8.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.2",
    "concurrently": "^9.0.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.469.0",
    "next": "^15.0.0",
    "next-intl": "^4.14.9",
    "nodemailer": "^9.0.5",
    "nuqs": "^2.10.2",
    "otplib": "^12.0.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.12.0",
    "@next/bundle-analyzer": "^16.4.3",
    "@next/eslint-plugin-next": "^15.0.0",
    "@playwright/test": "^1.49.0",
    "@storybook/addon-a11y": "^10.6.4",
    "@storybook/addon-docs": "^10.6.4",
    "@storybook/nextjs-vite": "^10.6.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.4",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "eslint": "^9.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.4",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "knip": "^6.43.0",
    "msw": "^2.15.0",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "storybook": "^10.6.4",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.2"
  }
}
