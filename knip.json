{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/{page,layout,route,loading,error,not-found,global-error,default,template}.{ts,tsx}",
    "backend/src/main.ts",
    "scripts/**/*.{ts,mjs,js}",
    "tests/**/*.{ts,tsx}"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "backend/src/**/*.ts",
    "scripts/**/*",
    "tests/**/*.{ts,tsx}"
  ],
  "ignoreDependencies": [
    "tsconfig-paths",
    "ts-node",
    "tailwindcss",
    "swagger-ui-express"
  ],
  "rules": {
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "duplicates": "off",
    "enumMembers": "off"
  }
}
