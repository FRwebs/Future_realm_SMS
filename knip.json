{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/{page,layout,route,loading,error,not-found,global-error,default,template}.{ts,tsx}",
    "src/instrumentation.ts",
    "src/instrumentation-client.ts",
    "middleware.ts",
    "backend/src/main.ts",
    "prisma/seed.ts",
    "scripts/**/*.{ts,mjs,js}",
    "tests/**/*.{ts,tsx}"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "backend/src/**/*.ts",
    "scripts/**/*",
    "tests/**/*.{ts,tsx}"
  ],
  "ignore": [
    "src/lib/api/generated/**"
  ],
  "ignoreDependencies": [
    "tsc-alias",
    "tsconfig-paths",
    "ts-node",
    "autoprefixer",
    "postcss",
    "@next/eslint-plugin-next",
    "swagger-ui-express"
  ],
  "rules": {
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "duplicates": "off",
    "enumMembers": "off",
    "classMembers": "off"
  }
}
