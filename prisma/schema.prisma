// Platform Admin Panel BRD v4.0 · Module 2.11 — School Ownership Transfer.
// Never a field edit: evidence, notice, dual approval, and a new incoming-owner account rather
// than a handed-over login, so the audit trail never straddles two different people.
model OwnershipTransfer {
  id              String    @id @default(cuid())
  schoolId        String
  outgoingOwnerId String
  incomingOwnerId String?
  triggerType     String // VOLUNTARY_SALE, OWNER_INCAPACITATED, OWNER_DECEASED, DISPUTE
  evidenceNotes   String
  status          String    @default("EVIDENCE_COLLECTED") // EVIDENCE_COLLECTED, NOTICE_SENT, OBJECTION_RAISED, APPROVED, EXECUTED, FROZEN
  noticeSentAt    DateTime?
  holdExpiresAt   DateTime?
  objectionNote   String?
  approver1Id     String?
  approver1At     DateTime?
  approver2Id     String?
  approver2At     DateTime?
