model SyncDraft {
  id           String        @id @default(cuid())
  schoolId     String
  userId       String
  type         SyncDraftType
  payload      Json
  syncedAt     DateTime?
  createdAt    DateTime      @default(now())
  clientId     String?
  state        String        @default("PENDING")
  capturedAt   DateTime?
  deviceLabel  String?
  message      String?
  conflict     Json?
