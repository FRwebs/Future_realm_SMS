model ProfileDocument {
  id                 String    @id @default(cuid())
  schoolId           String
  userId             String
  title              String
  type               String
  fileName           String?
  fileUrl            String?
  mimeType           String?
  sizeBytes          Int?
  verificationStatus String    @default("PENDING")
  notes              String?
  uploadedById       String?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  school             School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user               User      @relation("ProfileDocumentUser", fields: [userId], references: [id], onDelete: Cascade)
  uploadedBy         User?     @relation("ProfileDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([schoolId, userId, deletedAt])
  @@index([schoolId, type, verificationStatus])
}

model ProfileEditRequest {
  id            String    @id @default(cuid())
  schoolId      String
  targetUserId  String
  requestedById String
  reviewedById  String?
  fields        Json
  reason        String?
  status        String    @default("PENDING")
  reviewComment String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  targetUser    User      @relation("ProfileEditRequestTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  requestedBy   User      @relation("ProfileEditRequestRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy    User?     @relation("ProfileEditRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([schoolId, targetUserId, status])
  @@index([schoolId, requestedById, createdAt])
  @@index([schoolId, status, createdAt])
}

model Role {
  id              String               @id @default(cuid())
  schoolId        String
  name            String
  slug            String
  description     String?
  isSystem        Boolean              @default(false)
  systemRole      UserRole?
  createdById     String?
  deletedAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  school          School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy       User?                @relation("RoleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  rolePermissions RolePermission[]
  userRoles       UserRoleAssignment[]

  @@unique([schoolId, slug])
  @@index([schoolId, isSystem, deletedAt])
  @@map("roles")
}

model Permission {
  id              String                   @id @default(cuid())
  key             String                   @unique
  module          String
  label           String
  description     String?
  createdAt       DateTime                 @default(now())
  rolePermissions RolePermission[]
  overrides       UserPermissionOverride[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id           String   @id @default(cuid())
  schoolId     String
  userId       String
  roleId       String
  assignedById String?
  createdAt    DateTime @default(now())
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy   User?    @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([schoolId, userId, roleId])
  @@index([schoolId, userId])
  @@index([schoolId, roleId])
  @@map("user_roles")
}

model UserPermissionOverride {
  id           String                 @id @default(cuid())
  schoolId     String
  userId       String
  permissionId String
  type         PermissionOverrideType
  setById      String?
  createdAt    DateTime               @default(now())
  school       School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user         User                   @relation("UserPermissionOverrideTarget", fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission             @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  setBy        User?                  @relation("UserPermissionOverrideSetBy", fields: [setById], references: [id], onDelete: SetNull)

  @@unique([schoolId, userId, permissionId])
  @@index([schoolId, userId, type])
  @@index([permissionId])
  @@map("user_permission_overrides")
}

model Guardian {
  id                 String                @id @default(cuid())
  schoolId           String
  userId             String?               @unique
  school             School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user               User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName          String
  lastName           String
  phone              String
  email              String?
  relationship       String
  occupation         String?
  address            String?
  canReceiveSms      Boolean               @default(true)
  canReceiveEmail    Boolean               @default(true)
  secondContactName  String?
  secondContactPhone String?
  language           String                @default("English")
  /// Marked deliberately — never counted as a failed activation.
  phoneOnly          Boolean               @default(false)
  phoneOnlyReason    String?
  phoneOnlyMode      String?
  createdAt          DateTime              @default(now())
  /// A merged-away record points at the survivor and is closed, never deleted.
  mergedIntoId       String?
  mergedAt           DateTime?
  students           StudentGuardian[]
  parentMeetings     ParentMeeting[]
  consents           FamilyConsent[]
  submissions        GuardianSubmission[]
  contacts           GuardianContact[]
  collectors         AuthorisedCollector[]

  @@index([schoolId, phone])
}

