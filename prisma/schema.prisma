/// One decision waiting on somebody.
///
/// Whichever service raises a decision writes a row here and keeps its own
/// record as the subject — subjectType and subjectId point back at the
/// ResultSheet, FeeWaiver, ProfileEditRequest or whatever else it is about.
/// The queue never has to know about those tables to list or order the work.
model ApprovalRequest {
  id            String         @id @default(cuid())
  schoolId      String
  kind          ApprovalKind
  /// The record this decision is about, e.g. "ResultSheet".
  subjectType   String
  subjectId     String?
  title         String
  summary       String?
  /// What this decision unblocks, in the requester's own words — "1 teacher ·
  /// 34 cards". Written when the decision is raised, because recomputing it per
  /// render costs a query for every row on the page.
  blocking      String?
  /// Higher sorts first; age breaks ties.
  priority      Int            @default(0)
  requestedById String?
  /// Who must decide: a named person, or anyone holding the role.
  assigneeId    String?
  assigneeRole  UserRole?
  status        ApprovalStatus @default(PENDING)
  /// Required on anything but an approval, so a refusal always says why.
  decisionNote  String?
  decidedById   String?
  decidedAt     DateTime?
  /// When it starts escalating, not when it stops mattering.
  escalatesAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  requestedBy   User?          @relation("ApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  assignee      User?          @relation("ApprovalAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  decidedBy     User?          @relation("ApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  // The queue read: one person's pending work, worst first.
  @@index([schoolId, assigneeId, status, priority])
  // The role read, for work routed to a role rather than a person.
  @@index([schoolId, assigneeRole, status, priority])
  // Finding the decision attached to a record.
  @@index([schoolId, subjectType, subjectId])
}

/// A message on a decision, or a line the system wrote about it.
///
/// The decision itself lives in whichever module raised it, so a thread is
/// keyed by "source:id" rather than by a foreign key: one conversation per
/// decision, whatever table the decision is in.
model ApprovalMessage {
  id        String   @id @default(cuid())
  schoolId  String
  itemKey   String
  authorId  String?
  /// COMMENT, or SYSTEM for what the queue itself did — an escalation, a reminder.
  kind      String   @default("COMMENT")
  body      String
  createdAt DateTime @default(now())
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author    User?    @relation("ApprovalMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([schoolId, itemKey, createdAt])
}

