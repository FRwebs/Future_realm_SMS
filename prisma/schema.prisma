model Term {
  id                            String                         @id @default(cuid())
  schoolId                      String
  academicSessionId             String
  school                        School                         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession               AcademicSession                @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  name                          String
  order                         Int
  startDate                     DateTime
  endDate                       DateTime
  isCurrent                     Boolean                        @default(false)
  /// The mid-term break, when the school takes one — taken out of the school days.
  breakStart                    DateTime?
  breakEnd                      DateTime?
  /// Make this the active term the day it opens, without anyone switching to it.
  activateOnOpen                Boolean                        @default(false)
  /// Which weekdays the school sits, as "MON" … "SUN". Counts the term's school days.
  schoolDays                    String[]                       @default(["MON", "TUE", "WED", "THU", "FRI"])
  assessmentWindows             AssessmentWindow[]
  timetableVersions             TimetableVersion[]
  resultSheets                  ResultSheet[]
  attendance                    StudentAttendance[]
  feeStructures                 FeeStructure[]
  assessments                   AssessmentComponent[]
  timetableEntries              TimetableEntry[]
  timetablePublishLogs          TimetablePublishLog[]
  exams                         ExamTimetableEntry[]
  resultPublications            ResultPublication[]
  curriculumTopics              CurriculumTopic[]
  schemeOfWork                  SchemeOfWork[]
