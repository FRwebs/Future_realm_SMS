// Platform Admin Panel BRD v4.0 · Module 2.10 — Web Address Registry & Dispute Resolution.
// Every address ever issued lives here (not only the one currently on the School record), so a
// held, retired, reserved or blocked address still has a place to carry its own history.
model WebAddressRecord {
  id                  String           @id @default(cuid())
  address             String           @unique
  schoolId            String?
  state               String           @default("LIVE") // LIVE, HELD, RETIRED, RESERVED, BLOCKED
  countryScope        String           @default("Nigeria")
  reservedReason      String?
  issuedAt            DateTime         @default(now())
  retiredAt           DateTime?
  releaseEligibleAt   DateTime?
  redirectFromAddress String?
  redirectExpiresAt   DateTime?
  changeReason        String?
  changedById         String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  school              School?          @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  disputes            AddressDispute[]

  @@index([state])
  @@index([schoolId])
}

model AddressDispute {
  id                      String            @id @default(cuid())
  claimedAddress          String
  webAddressRecordId      String?
  claimantSchoolName      String
  claimantContactName     String
  claimantContactEmail    String
  claimantContactPhone    String?
  evidenceNotes           String
  status                  String            @default("EVIDENCE_PENDING") // EVIDENCE_PENDING, HOLDER_CONTACTED, DECIDED
  holderNotifiedAt        DateTime?
  holderResponseDueAt     DateTime?
  holderRespondedAt       DateTime?
  holderResponse          String?
  outcome                 String? // NEGOTIATED, REASSIGNED, DECLINED
  qualifiedAddressOffered String?
  decidedById             String?
  decidedAt               DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  webAddressRecord        WebAddressRecord? @relation(fields: [webAddressRecordId], references: [id], onDelete: SetNull)
  decidedBy               User?             @relation("AddressDisputeDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status])
}

// Platform Admin Panel BRD v4.0 · Module 2.11 — School Ownership Transfer.
// Never a field edit: evidence, notice, dual approval, and a new incoming-owner account rather
// than a handed-over login, so the audit trail never straddles two different people.
model OwnershipTransfer {
  id              String    @id @default(cuid())
  schoolId        String
  outgoingOwnerId String
  incomingOwnerId String?
  triggerType     String // VOLUNTARY_SALE, OWNER_INCAPACITATED, OWNER_DECEASED, DISPUTE
  evidenceNotes   String
  status          String    @default("EVIDENCE_COLLECTED") // EVIDENCE_COLLECTED, NOTICE_SENT, OBJECTION_RAISED, APPROVED, EXECUTED, FROZEN
  noticeSentAt    DateTime?
  holdExpiresAt   DateTime?
  objectionNote   String?
  approver1Id     String?
  approver1At     DateTime?
  approver2Id     String?
  approver2At     DateTime?
  executedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  outgoingOwner   User      @relation("OwnershipTransferOutgoingOwner", fields: [outgoingOwnerId], references: [id])
  incomingOwner   User?     @relation("OwnershipTransferIncomingOwner", fields: [incomingOwnerId], references: [id], onDelete: SetNull)
  approver1       User?     @relation("OwnershipTransferApprover1", fields: [approver1Id], references: [id], onDelete: SetNull)
  approver2       User?     @relation("OwnershipTransferApprover2", fields: [approver2Id], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([status])
}

