model School {
  id                            String                         @id @default(cuid())
  name                          String
  slug                          String                         @unique
  category                      SchoolCategory
  isGroup                       Boolean                        @default(false)
  timezone                      String                         @default("Africa/Lagos")
  currency                      String                         @default("NGN")
  academicYearLabel             String                         @default("Session")
  termLabel                     String                         @default("Term")
  lowBandwidthMode              Boolean                        @default(true)
  address                       String?
  city                          String?
  state                         String?
  country                       String                         @default("Nigeria")
  ownerName                     String?
  ownerEmail                    String?
  ownerPhone                    String?
  subdomain                     String?                        @unique
  schoolCode                    String?                        @unique
  logoUrl                       String?
  primaryColor                  String?                        @default("#25593f")
  secondaryColor                String?                        @default("#c28c3d")
  plan                          SubscriptionPlan               @default(BASIC)
  status                        TenantStatus                   @default(TRIAL)
  billingStatus                 BillingStatus                  @default(TRIAL)
  trialEndsAt                   DateTime?
  suspendedAt                   DateTime?
  suspendedReason               String?
  archivedAt                    DateTime?
  lastPaymentAt                 DateTime?
  nextBillingAt                 DateTime?
  healthScore                   Int                            @default(70)
  storageUsedGb                 Float                          @default(0)
  studentLimit                  Int?
  staffLimit                    Int?
  storageLimitGb                Float?
  smsLimitPerMonth              Int?
  emailLimitPerMonth            Int?
  apiUsageCount                 Int                            @default(0)
  dpaStatus                     String                         @default("PENDING")
  accountManagerId              String?
  schoolGroupId                 String?
  featureFlags                  Json?
  deletedAt                     DateTime?
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  campuses                      Campus[]
  academicSessions              AcademicSession[]
  terms                         Term[]
  departments                   Department[]
  classLevels                   ClassLevel[]
  classRooms                    ClassRoom[]
  classAcademicAssignments      ClassAcademicAssignment[]
  configurationItems            ConfigurationItem[]
  skillDefinitions              SkillDefinition[]
  studentSkills                 StudentSkill[]
  users                         User[]
  profileDocuments              ProfileDocument[]
  profileEditRequests           ProfileEditRequest[]
  roles                         Role[]
  userRoles                     UserRoleAssignment[]
  userPermissionOverrides       UserPermissionOverride[]
  guardians                     Guardian[]
  students                      Student[]
  promotions                    PromotionRecord[]
  staffProfiles                 StaffProfile[]
  leaveRequests                 LeaveRequest[]
  staffAttendancePolicy         StaffAttendancePolicy?
  staffAttendanceAudits         StaffAttendanceAudit[]
  subjectCategories             SubjectCategory[]
  curriculumTopics              CurriculumTopic[]
  schemeOfWork                  SchemeOfWork[]
  sowTopics                     SowTopic[]
  sowTopicResources             SowTopicResource[]
  studentTopicProgress          StudentTopicProgress[]
  trainingPrograms              TrainingProgram[]
  trainingParticipants          TrainingParticipant[]
  admissionConfigs              AdmissionConfig[]
  admissions                    AdmissionApplication[]
  admissionHistories            AdmissionStatusHistory[]
  admissionComments             AdmissionComment[]
  admissionScreenings           AdmissionScreening[]
  admissionOffers               AdmissionOffer[]
  admissionPayments             AdmissionPaymentLink[]
  enrollmentConversions         EnrollmentConversionLog[]
  subjects                      Subject[]
  classSubjects                 ClassSubject[]
  gradingSchemes                GradingScheme[]
  gradeBands                    GradeBand[]
  assessments                   AssessmentComponent[]
  sectionAssessmentComponents   SectionAssessmentComponent[]
  academicAssessments           AcademicAssessment[]
  assessmentCandidates          AssessmentCandidate[]
  assessmentScoreAudits         AssessmentScoreAudit[]
  resultSheets                  ResultSheet[]
  scoreEntries                  ScoreEntry[]
  resultApprovals               ResultApproval[]
  resultPublications            ResultPublication[]
  broadsheets                   Broadsheet[]
  broadsheetApprovals           BroadsheetApprovalHistory[]
  reportCards                   ReportCard[]
  seniorSecondaryResultArchives SeniorSecondaryResultArchive[]
  studentAttendance             StudentAttendance[]
  staffAttendance               StaffAttendance[]
  periodDefinitions             PeriodDefinition[]
  assignments                   Assignment[]
  assignmentSubmissions         AssignmentSubmission[]
  feeStructures                 FeeStructure[]
  feeAssignments                FeeAssignment[]
  feeCategories                 FeeCategory[]
  feeItems                      FeeItem[]
  invoices                      Invoice[]
  payments                      Payment[]
  paymentGatewayConfigs         PaymentGatewayConfig[]
  gatewayTransactions           GatewayTransaction[]
  feeWaivers                    FeeWaiver[]
  scholarships                  Scholarship[]
  studentScholarships           StudentScholarship[]
  expenses                      Expense[]
  payrollRuns                   PayrollRun[]
  payrollItems                  PayrollItem[]
  budgetAllocations             BudgetAllocation[]
  announcements                 Announcement[]
  internalMessages              InternalMessage[]
  notificationLogs              NotificationLog[]
  calendarEvents                CalendarEvent[]
  timetableEntries              TimetableEntry[]
  timetablePublishLogs          TimetablePublishLog[]
  examTimetableEntries          ExamTimetableEntry[]
  transportRoutes               TransportRoute[]
  transportAssignments          TransportAssignment[]
  hostelBuildings               HostelBuilding[]
  hostelRooms                   HostelRoom[]
  hostelAllocations             HostelAllocation[]
  libraryBooks                  LibraryBook[]
  libraryLoans                  LibraryLoan[]
  auditLogs                     AuditLog[]
  syncDrafts                    SyncDraft[]
  integrationConfigs            IntegrationConfig[]
  disciplineRecords             DisciplineRecord[]
  counselingRecords             CounselingRecord[]
  healthVisits                  HealthVisit[]
  learningMaterials             LearningMaterial[]
  lessonPlans                   LessonPlan[]
  questionBankItems             QuestionBankItem[]
  visitorLogs                   VisitorLog[]
  inventoryItems                InventoryItem[]
  facilityLogs                  FacilityMaintenanceLog[]
  idCards                       IdCard[]
  parentMeetings                ParentMeeting[]
  externalExams                 ExternalExam[]
  examSeatingPlans              ExamSeatingPlan[]
  invigilationAssignments       InvigilationAssignment[]
  transportVehicles             TransportVehicle[]
  budgets                       Budget[]
  budgetLines                   BudgetLine[]
  resultEntryWindows            ResultEntryWindow[]
  promotionRules                PromotionRule[]
  subjectCombinations           SubjectCombination[]
  platformBillingTransactions   PlatformBillingTransaction[]
  platformInvoices              PlatformInvoice[]
  platformDiscounts             PlatformDiscount[]
  supportTickets                SupportTicket[]
  platformFeatureOverrides      PlatformFeatureFlagOverride[]
  platformAnnouncementViews     PlatformAnnouncementView[]
  crmInteractions               CrmInteraction[]
  crmNotes                      CrmNote[]
  onboardingChecklistItems      OnboardingChecklistItem[]
  npsResponses                  NpsResponse[]
  dataPrivacyRequests           DataPrivacyRequest[]
  platformSessions              PlatformSession[]
  loginAttempts                 LoginAttempt[]
  backupRecords                 BackupRecord[]
  apiUsageLogs                  ApiUsageLog[]
  schoolGroup                   SchoolGroup?                   @relation(fields: [schoolGroupId], references: [id], onDelete: SetNull)
  accountManager                User?                          @relation("SchoolAccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)

  @@index([status, billingStatus])
  @@index([country, state])
  @@index([accountManagerId])
}

model Campus {
  id         String                 @id @default(cuid())
  schoolId   String
  school     School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name       String
  code       String
  address    String?
  phone      String?
  createdAt  DateTime               @default(now())
  classRooms ClassRoom[]
  students   Student[]
  staff      StaffProfile[]
  admissions AdmissionApplication[]
  events     CalendarEvent[]

  @@unique([schoolId, code])
}

model AcademicSession {
  id                            String                         @id @default(cuid())
  schoolId                      String
  school                        School                         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name                          String
  startDate                     DateTime
  endDate                       DateTime
  isCurrent                     Boolean                        @default(false)
  students                      Student[]
  terms                         Term[]
  classAcademicAssignments      ClassAcademicAssignment[]
  curriculumTopics              CurriculumTopic[]
  schemeOfWork                  SchemeOfWork[]
  promotionsFrom                PromotionRecord[]              @relation("PromotionFromSession")
  promotionsTo                  PromotionRecord[]              @relation("PromotionToSession")
  hostelAllocs                  HostelAllocation[]
  feeStructures                 FeeStructure[]
  feeAssignments                FeeAssignment[]
  feeItems                      FeeItem[]
  invoices                      Invoice[]
  payrollRuns                   PayrollRun[]
  budgetAllocations             BudgetAllocation[]
  studentScholarships           StudentScholarship[]
  AdmissionApplication          AdmissionApplication[]
  AdmissionConfig               AdmissionConfig[]
  academicAssessments           AcademicAssessment[]
  sectionAssessmentComponents   SectionAssessmentComponent[]
  broadsheets                   Broadsheet[]
  reportCards                   ReportCard[]
  seniorSecondaryResultArchives SeniorSecondaryResultArchive[]
  resultEntryWindows            ResultEntryWindow[]
  subjectCombinations           SubjectCombination[]
  externalExams                 ExternalExam[]
  budgets                       Budget[]
  LessonPlan                    LessonPlan[]
  timetableEntries              TimetableEntry[]
  timetablePublishLogs          TimetablePublishLog[]

  @@unique([schoolId, name])
}

model Term {
  id                            String                         @id @default(cuid())
  schoolId                      String
  academicSessionId             String
  school                        School                         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession               AcademicSession                @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  name                          String
  order                         Int
  startDate                     DateTime
  endDate                       DateTime
  isCurrent                     Boolean                        @default(false)
  resultSheets                  ResultSheet[]
  attendance                    StudentAttendance[]
  feeStructures                 FeeStructure[]
  assessments                   AssessmentComponent[]
  timetableEntries              TimetableEntry[]
  timetablePublishLogs          TimetablePublishLog[]
  exams                         ExamTimetableEntry[]
  resultPublications            ResultPublication[]
  curriculumTopics              CurriculumTopic[]
  schemeOfWork                  SchemeOfWork[]
  AdmissionApplication          AdmissionApplication[]
  AdmissionConfig               AdmissionConfig[]
  academicAssessments           AcademicAssessment[]
  sectionAssessmentComponents   SectionAssessmentComponent[]
  broadsheets                   Broadsheet[]
  reportCards                   ReportCard[]
  seniorSecondaryResultArchives SeniorSecondaryResultArchive[]
  lessonPlans                   LessonPlan[]
  resultEntryWindows            ResultEntryWindow[]
  classAcademicAssignments      ClassAcademicAssignment[]
  studentSkills                 StudentSkill[]
  feeItems                      FeeItem[]
  invoices                      Invoice[]
  feeAssignments                FeeAssignment[]

  @@unique([academicSessionId, order])
}

model Department {
  id                 String              @id @default(cuid())
  schoolId           String
  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name               String
  code               String
  subjects           Subject[]
  classRooms         ClassRoom[]
  staff              StaffProfile[]
  lessonPlans        LessonPlan[]
  questionBankItems  QuestionBankItem[]
  resultEntryWindows ResultEntryWindow[]

  @@unique([schoolId, code])
}

model SubjectCategory {
  id          String    @id @default(cuid())
  schoolId    String?
  name        String
  description String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  school      School?   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjects    Subject[]

  @@unique([schoolId, name])
  @@index([schoolId, sortOrder])
}

model ClassLevel {
  id            String         @id @default(cuid())
  schoolId      String
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name          String
  section       SchoolCategory
  schoolSection SchoolSection?
  order         Int
  isActive      Boolean        @default(true)
  classRooms    ClassRoom[]

  @@unique([schoolId, name])
}

model ClassRoom {
  id                            String                         @id @default(cuid())
  schoolId                      String
  campusId                      String?
  classLevelId                  String
  departmentId                  String?
  shortName                     String?
  section                       String?
  category                      String?
  assistantClassTeacherId       String?
  room                          String?
  isActive                      Boolean                        @default(true)
  displayOrder                  Int                            @default(0)
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @default(now()) @updatedAt
  deletedAt                     DateTime?
  school                        School                         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus                        Campus?                        @relation(fields: [campusId], references: [id], onDelete: SetNull)
  classLevel                    ClassLevel                     @relation(fields: [classLevelId], references: [id], onDelete: Restrict)
  department                    Department?                    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  name                          String
  arm                           String
  capacity                      Int                            @default(40)
  students                      Student[]
  admissions                    AdmissionApplication[]
  classSubjects                 ClassSubject[]
  resultSheets                  ResultSheet[]
  attendance                    StudentAttendance[]
  timetable                     TimetableEntry[]
  exams                         ExamTimetableEntry[]
  assignments                   Assignment[]
  curriculumTopics              CurriculumTopic[]
  resultPublications            ResultPublication[]
  feeStructures                 FeeStructure[]
  feeItems                      FeeItem[]
  invoices                      Invoice[]
  openAdmissions                AdmissionConfig[]              @relation("AdmissionConfigOpenClasses")
  classTeacherId                String?
  academicAssessments           AcademicAssessment[]
  broadsheets                   Broadsheet[]
  reportCards                   ReportCard[]
  seniorSecondaryResultArchives SeniorSecondaryResultArchive[]
  disciplineRecords             DisciplineRecord[]
  learningMaterials             LearningMaterial[]
  lessonPlans                   LessonPlan[]
  questionBankItems             QuestionBankItem[]
  externalExams                 ExternalExam[]
  resultEntryWindows            ResultEntryWindow[]
  SubjectCombination            SubjectCombination[]
  classTeacher                  User?                          @relation("ClassRoomClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  assistantClassTeacher         User?                          @relation("ClassRoomAssistantTeacher", fields: [assistantClassTeacherId], references: [id], onDelete: SetNull)
  academicAssignments           ClassAcademicAssignment[]
  studentSkills                 StudentSkill[]
  timetablePublishLogs          TimetablePublishLog[]
  schemeOfWork                  SchemeOfWork[]

  @@unique([schoolId, name, arm])
  @@index([schoolId, isActive, deletedAt])
  @@index([schoolId, category])
  @@index([schoolId, classTeacherId])
  @@index([schoolId, displayOrder])
}

model ClassAcademicAssignment {
  id                      String          @id @default(cuid())
  schoolId                String
  classId                 String
  academicSessionId       String
  termId                  String?
  classTeacherId          String?
  assistantClassTeacherId String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  school                  School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classRoom               ClassRoom       @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicSession         AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  term                    Term?           @relation(fields: [termId], references: [id], onDelete: Cascade)
  classTeacher            User?           @relation("ClassAcademicAssignmentTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  assistantClassTeacher   User?           @relation("ClassAcademicAssignmentAssistant", fields: [assistantClassTeacherId], references: [id], onDelete: SetNull)

  @@unique([classId, academicSessionId, termId])
  @@index([schoolId, academicSessionId, termId])
  @@index([schoolId, classTeacherId])
}

model ConfigurationItem {
  id           String    @id @default(cuid())
  schoolId     String
  resource     String
  name         String
  code         String?
  description  String?
  data         Json?
  status       String    @default("ACTIVE")
  isDefault    Boolean   @default(false)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  deletedAt    DateTime?
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, resource, name])
  @@unique([schoolId, resource, code])
  @@index([schoolId, resource, status])
  @@index([schoolId, resource, displayOrder])
}

model SkillDefinition {
