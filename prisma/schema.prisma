  @@unique([schoolId, provider])
}

/// Where a staff appraisal is in its life.
///
/// The three states exist because an appraisal nobody has shown the person is
/// a secret file about them. DRAFT is the reviewer's working copy; SHARED
/// means the appraisee can read it; ACKNOWLEDGED means they have said so and
/// had the chance to respond in writing.
enum StaffAppraisalStatus {
  DRAFT
  SHARED
  ACKNOWLEDGED
}

/// One appraisal of one staff member, for one cycle.
model StaffAppraisal {
  id              String                 @id @default(cuid())
  schoolId        String
  staffId         String
  /// The person carrying out the review — a head of department or the principal.
  reviewerId      String
  termId          String?
  /// What this round is called in the school's own words, e.g. "Second Term 2025/2026".
  cycle           String
  status          StaffAppraisalStatus   @default(DRAFT)
  /// Mean of the criterion scores, stored so a list does not have to recompute it.
  overallScore    Float?
  strengths       String?
  improvements    String?
  reviewerComment String?
  /// The appraisee's own words. Only they can write here.
  staffComment    String?
  sharedAt        DateTime?
  acknowledgedAt  DateTime?
  /// When the appraisee submitted their own self-assessment. Until then the reviewer cannot read it.
  selfSubmittedAt DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  school          School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff           StaffProfile           @relation("StaffAppraisalSubject", fields: [staffId], references: [id], onDelete: Cascade)
  reviewer        User                   @relation("StaffAppraisalReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  term            Term?                  @relation(fields: [termId], references: [id], onDelete: SetNull)
  ratings         StaffAppraisalRating[]

  @@unique([staffId, cycle])
  @@index([schoolId, status, createdAt])
  @@index([schoolId, reviewerId, status])
}

/// A score against one named criterion, out of five.
model StaffAppraisalRating {
  id          String         @id @default(cuid())
  appraisalId String
  criterion   String
  score       Int
  comment     String?
  /// What the staff member rated themselves, and the figure the product itself holds for it.
  selfScore   Int?
  autoScore   Float?
  weight      Int?
  evidence    String?
  appraisal   StaffAppraisal @relation(fields: [appraisalId], references: [id], onDelete: Cascade)

  @@unique([appraisalId, criterion])
}

/// What makes an automation fire.
enum AutomationTrigger {
  FEE_DUE_SOON
  FEE_OVERDUE
  CONSECUTIVE_ABSENCE
  RESULT_PUBLISHED
  TERM_STARTING
  BIRTHDAY
  /// The four a school cannot switch off, and the rest the mockup names.
  RESULT_REVISED
  PAYMENT_REVERSAL
  EMERGENCY_BROADCAST
  APPROVAL_DECISION
  ABSENCE_RECORDED
  INVOICE_PUBLISHED
}

/// A standing rule that sends something without anybody pressing a button.
///
/// Stored rather than hard-coded because the point of the page is that a
/// school can see — and switch off — every message the product sends on its
/// behalf. `lastRunAt` and `sendCount` are what make that auditable: a rule
/// nobody can see firing is indistinguishable from one that is broken.
model AutomationRule {
  id           String            @id @default(cuid())
  schoolId     String
  name         String
  trigger      AutomationTrigger
  /// Trigger-specific threshold, e.g. days before due, or absences in a row.
  threshold    Int?
  channel      String            @default("SMS")
  audience     String            @default("Guardians")
  template     String
  /// When it fires, in the words the rules table shows — "Immediately", "16:00 daily", "Day 14".
  timing       String?
  /// A mandatory rule cannot be switched off by the school. Four of them exist
  /// because a parent must be told: a result published or revised, money leaving
  /// a ledger, an emergency. Each carries its one-sentence reason.
  isMandatory  Boolean           @default(false)
  lockedReason String?
  isActive     Boolean           @default(true)
  lastRunAt    DateTime?
  sendCount    Int               @default(0)
  createdById  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  school       School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, isActive])
}

/// A report somebody actually generated.
///
/// /v1/reports streams a PDF and keeps no record of it, so the product could
/// not answer "who exported the whole student roll last term". This records
/// that: what was produced, by whom, over what period, and how large.
model GeneratedReport {
  id            String   @id @default(cuid())
  schoolId      String
  kind          String
  title         String
  format        String   @default("PDF")
  /// What the report covered, in the school's own terms.
  scope         String?
  rowCount      Int?
  sizeBytes     Int?
  generatedById String?
  generatedAt   DateTime @default(now())
  /// Which standard report, dataset, return or saved definition this was ("STANDARD:broadsheet", "RETURN:<id>").
  code          String?
  /// The file itself, kept so a filed return can be downloaded again exactly as it was produced.
  content       String?
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  generatedBy   User?    @relation("GeneratedReportBy", fields: [generatedById], references: [id], onDelete: SetNull)

  @@index([schoolId, generatedAt])
}

/// One rung ladder a person is mapped onto. `steps` is [{ name, gross }]; `allowances` is
/// [{ name, who, basis, rate, treat }]. A band is the only way a person gets paid.
model PayBand {
  id              String         @id @default(cuid())
  schoolId        String
  code            String
  name            String
  covers          String
  coversGroup     String         @default("Other")
  steps           Json
  allowances      Json
  employerPension Float          @default(10)
  currency        String         @default("NGN")
  nextReview      DateTime?
  isOpen          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  school          School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff           StaffProfile[]

  @@unique([schoolId, code])
  @@index([schoolId, isOpen])
}

/// Money owed or paid outside the monthly run, with the reason it exists.
model OffCyclePayment {
