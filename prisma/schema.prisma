model ProfileDocument {
  id                 String    @id @default(cuid())
  schoolId           String
  userId             String
  title              String
  type               String
  fileName           String?
  fileUrl            String?
  mimeType           String?
  sizeBytes          Int?
  verificationStatus String    @default("PENDING")
  notes              String?
  /// Who issued it, and when it lapses — so a renewal can be asked for before it does.
  issuedBy           String?
  expiresOn          DateTime?
  uploadedById       String?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  school             School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user               User      @relation("ProfileDocumentUser", fields: [userId], references: [id], onDelete: Cascade)
  uploadedBy         User?     @relation("ProfileDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([schoolId, userId, deletedAt])
  @@index([schoolId, type, verificationStatus])
}

model ProfileEditRequest {
  id            String    @id @default(cuid())
  schoolId      String
  targetUserId  String
  requestedById String
  reviewedById  String?
  fields        Json
  reason        String?
  status        String    @default("PENDING")
  reviewComment String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  targetUser    User      @relation("ProfileEditRequestTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  requestedBy   User      @relation("ProfileEditRequestRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy    User?     @relation("ProfileEditRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([schoolId, targetUserId, status])
  @@index([schoolId, requestedById, createdAt])
  @@index([schoolId, status, createdAt])
}

model Role {
  id              String               @id @default(cuid())
  schoolId        String
  name            String
  slug            String
  description     String?
  isSystem        Boolean              @default(false)
  systemRole      UserRole?
  createdById     String?
  deletedAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  school          School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy       User?                @relation("RoleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  rolePermissions RolePermission[]
  userRoles       UserRoleAssignment[]

  @@unique([schoolId, slug])
  @@index([schoolId, isSystem, deletedAt])
  @@map("roles")
}

model Permission {
  id              String                   @id @default(cuid())
  key             String                   @unique
  module          String
  label           String
  description     String?
  createdAt       DateTime                 @default(now())
  rolePermissions RolePermission[]
  overrides       UserPermissionOverride[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id           String   @id @default(cuid())
  schoolId     String
  userId       String
  roleId       String
  assignedById String?
  createdAt    DateTime @default(now())
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy   User?    @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([schoolId, userId, roleId])
  @@index([schoolId, userId])
  @@index([schoolId, roleId])
  @@map("user_roles")
}

model UserPermissionOverride {
  id           String                 @id @default(cuid())
  schoolId     String
  userId       String
  permissionId String
  type         PermissionOverrideType
  setById      String?
  createdAt    DateTime               @default(now())
  school       School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user         User                   @relation("UserPermissionOverrideTarget", fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission             @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  setBy        User?                  @relation("UserPermissionOverrideSetBy", fields: [setById], references: [id], onDelete: SetNull)

  @@unique([schoolId, userId, permissionId])
  @@index([schoolId, userId, type])
  @@index([permissionId])
  @@map("user_permission_overrides")
}

model Guardian {
  id                       String                @id @default(cuid())
  schoolId                 String
  userId                   String?               @unique
  school                   School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user                     User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName                String
  lastName                 String
  phone                    String
  email                    String?
  relationship             String
  occupation               String?
  address                  String?
  canReceiveSms            Boolean               @default(true)
  canReceiveEmail          Boolean               @default(true)
  secondContactName        String?
  secondContactPhone       String?
  language                 String                @default("English")
  /// Marked deliberately — never counted as a failed activation.
  phoneOnly                Boolean               @default(false)
  phoneOnlyReason          String?
  phoneOnlyMode            String?
  /// A safeguarding restriction: nobody from the platform may open this guardian's account while it stands.
  safeguardingRestrictedAt DateTime?
  safeguardingNote         String?
  safeguardingById         String?
  createdAt                DateTime              @default(now())
  /// A merged-away record points at the survivor and is closed, never deleted.
  mergedIntoId             String?
  mergedAt                 DateTime?
  students                 StudentGuardian[]
  parentMeetings           ParentMeeting[]
  consents                 FamilyConsent[]
  submissions              GuardianSubmission[]
  contacts                 GuardianContact[]
  collectors               AuthorisedCollector[]

  @@index([schoolId, phone])
}

model Student {
  id                            String                         @id @default(cuid())
  schoolId                      String
  campusId                      String?
  userId                        String?                        @unique
  currentClassId                String?
  currentSessionId              String?
  school                        School                         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus                        Campus?                        @relation(fields: [campusId], references: [id], onDelete: SetNull)
  user                          User?                          @relation(fields: [userId], references: [id], onDelete: SetNull)
  currentClass                  ClassRoom?                     @relation(fields: [currentClassId], references: [id], onDelete: SetNull)
  currentSession                AcademicSession?               @relation(fields: [currentSessionId], references: [id], onDelete: SetNull)
  admissionNumber               String
  studentNumber                 String?
  firstName                     String
  lastName                      String
  middleName                    String?
  gender                        Gender
  dateOfBirth                   DateTime
  admissionDate                 DateTime
  registeredAdmission           AdmissionApplication?          @relation("AdmissionRegisteredStudent")
  status                        StudentStatus                  @default(ACTIVE)
  nationality                   String                         @default("Nigerian")
  stateOfOrigin                 String?
  religion                      String?
  address                       String?
  previousSchool                String?
  languageAtHome                String?
  houseName                     String?
  photoUrl                      String?
  changeRequests                StudentChangeRequest[]
  collectors                    AuthorisedCollector[]
  submissions                   GuardianSubmission[]
  medicalRecord                 MedicalRecord?
  documents                     StudentDocument[]
  behaviorLogs                  BehaviorLog[]
  skills                        StudentSkill[]
  disciplineRecords             DisciplineRecord[]
  counselingRecords             CounselingRecord[]
  healthVisits                  HealthVisit[]
  guardians                     StudentGuardian[]
  promotions                    PromotionRecord[]
  resultSheets                  ResultSheet[]
  scoreEntries                  ScoreEntry[]
  attendance                    StudentAttendance[]
  assignmentSubmissions         AssignmentSubmission[]
  feeAssignments                FeeAssignment[]
  invoices                      Invoice[]
  payments                      Payment[]
  feeWaivers                    FeeWaiver[]
  studentScholarships           StudentScholarship[]
  installmentPlans              InstallmentPlan[]
  financialClearances           FinancialClearance[]
  transport                     TransportAssignment[]
  hostelAllocation              HostelAllocation[]
  libraryLoans                  LibraryLoan[]
  assessmentCandidates          AssessmentCandidate[]
  reportCards                   ReportCard[]
  seniorSecondaryResultArchives SeniorSecondaryResultArchive[]
  idCards                       IdCard[]
  parentMeetings                ParentMeeting[]
  examSeatingPlans              ExamSeatingPlan[]
  subjectCombinations           SubjectCombination[]
  topicProgress                 StudentTopicProgress[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId, currentClassId])
}

model StudentGuardian {
  studentId  String
  guardianId String
  isPrimary  Boolean  @default(false)
  /// What this guardian may see about this one child.
  visibility Json?
  canCollect Boolean  @default(true)
  relation   String?
  linkedAt   DateTime @default(now())
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
  /// Finding a guardian's children — the primary key only leads with the child.
  @@index([guardianId])
}

model MedicalRecord {
  id         String  @id @default(cuid())
  studentId  String  @unique
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  bloodGroup String?
  genotype   String?
  allergies  String?
  conditions String?
  notes      String?
}

model StudentDocument {
  id           String    @id @default(cuid())
  studentId    String
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  label        String
  fileName     String
  fileUrl      String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime  @default(now())
  source       String?
  documentOn   DateTime?
  verifiedAt   DateTime?
  verifiedById String?
  note         String?
}

model BehaviorLog {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  category     String
  description  String
  severity     String
  loggedAt     DateTime @default(now())
  actionTaken  String?
  outcome      String?
  visibleTo    String?
  recordedById String?
}

model PromotionRecord {
  id            String           @id @default(cuid())
  schoolId      String
  studentId     String
  fromClassId   String?
  toClassId     String?
  fromSessionId String?
  toSessionId   String?
  decision      String
  promotedAt    DateTime         @default(now())
  school        School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student       Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromSession   AcademicSession? @relation("PromotionFromSession", fields: [fromSessionId], references: [id], onDelete: SetNull)
  toSession     AcademicSession? @relation("PromotionToSession", fields: [toSessionId], references: [id], onDelete: SetNull)
}

model AdmissionApplication {
  id                    String                   @id @default(cuid())
  schoolId              String
  campusId              String?
  academicSessionId     String?
  termId                String?
  desiredClassId        String?
  reviewerId            String?
  registeredStudentId   String?                  @unique
  school                School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus                Campus?                  @relation(fields: [campusId], references: [id], onDelete: SetNull)
  academicSession       AcademicSession?         @relation(fields: [academicSessionId], references: [id], onDelete: SetNull)
  term                  Term?                    @relation(fields: [termId], references: [id], onDelete: SetNull)
  desiredClass          ClassRoom?               @relation(fields: [desiredClassId], references: [id], onDelete: SetNull)
  registeredStudent     Student?                 @relation("AdmissionRegisteredStudent", fields: [registeredStudentId], references: [id], onDelete: SetNull)
  applicationNo         String
  firstName             String
  lastName              String
  middleName            String?
  gender                Gender
  dateOfBirth           DateTime
  guardianName          String
  guardianPhone         String
  guardianEmail         String?
  emergencyContactName  String?
  emergencyContactPhone String?
  address               String?
  previousSchool        String?
  medicalNotes          String?
  duplicateFlag         Boolean                  @default(false)
  duplicateReason       String?
  applicationFeeStatus  AdmissionPaymentStatus   @default(PENDING)
  feeWaived             Boolean                  @default(false)
  applicantPortalToken  String?
  documents             AdmissionDocument[]
  reviews               AdmissionReview[]
  screenings            AdmissionScreening[]
  offers                AdmissionOffer[]
  comments              AdmissionComment[]
  history               AdmissionStatusHistory[]
  paymentLinks          AdmissionPaymentLink[]
  conversionLog         EnrollmentConversionLog?
  status                ApplicationStatus        @default(SUBMITTED)
  notes                 String?
  submittedAt           DateTime                 @default(now())
  decidedAt             DateTime?
  acceptedAt            DateTime?
  enrolledAt            DateTime?

  @@unique([schoolId, applicationNo])
  @@index([schoolId, status])
  @@index([schoolId, guardianPhone])
  @@index([schoolId, desiredClassId])
}

model AdmissionDocument {
  id            String               @id @default(cuid())
  applicationId String
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  label         String
  fileUrl       String
  mimeType      String
  sizeBytes     Int
  uploadedAt    DateTime             @default(now())
  isVerified    Boolean              @default(false)
  verifiedAt    DateTime?
}

model AdmissionReview {
  id            String               @id @default(cuid())
  applicationId String
  reviewerId    String
  decision      ApplicationStatus
  notes         String?
  reviewedAt    DateTime             @default(now())
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewer      User                 @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
}

model AdmissionConfig {
  id                        String           @id @default(cuid())
  schoolId                  String
  academicSessionId         String?
  termId                    String?
  name                      String
  isActive                  Boolean          @default(true)
  minAge                    Int?
  maxAge                    Int?
  requiredDocuments         Json
  formFields                Json
  applicationFeeAmount      Decimal          @default(0) @db.Decimal(12, 2)
  applicationFeeRequired    Boolean          @default(false)
  screeningRequired         Boolean          @default(true)
  principalApprovalRequired Boolean          @default(true)
  bursarClearanceRequired   Boolean          @default(true)
  offerExpiryDays           Int              @default(14)
  branding                  Json?
  communicationTemplates    Json?
  school                    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession           AcademicSession? @relation(fields: [academicSessionId], references: [id], onDelete: SetNull)
  term                      Term?            @relation(fields: [termId], references: [id], onDelete: SetNull)
  openClasses               ClassRoom[]      @relation("AdmissionConfigOpenClasses")
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  @@index([schoolId, isActive])
}

model AdmissionScreening {
  id             String               @id @default(cuid())
  schoolId       String
  applicationId  String
  interviewerId  String?
  scheduledAt    DateTime
  venue          String?
  score          Float?
  maxScore       Float                @default(100)
  result         String?
  remarks        String?
  recommendation String?
  attachmentUrl  String?
  completedAt    DateTime?
  school         School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  application    AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewer    User?                @relation("AdmissionScreeningInterviewer", fields: [interviewerId], references: [id], onDelete: SetNull)

  @@index([schoolId, scheduledAt])
  @@index([applicationId])
}

model AdmissionOffer {
  id            String               @id @default(cuid())
  schoolId      String
  applicationId String
  issuedById    String?
  offerNumber   String
  status        OfferStatus          @default(DRAFT)
  conditions    String?
  checklist     Json?
  letterUrl     String?
  sentAt        DateTime?
  viewedAt      DateTime?
  acceptedAt    DateTime?
  declinedAt    DateTime?
  expiresAt     DateTime
  school        School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  issuedBy      User?                @relation("AdmissionOfferIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  createdAt     DateTime             @default(now())

  @@unique([schoolId, offerNumber])
  @@index([applicationId, status])
}

model AdmissionStatusHistory {
  id            String               @id @default(cuid())
  schoolId      String
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  changedById   String?
  note          String?
  metadata      Json?
  createdAt     DateTime             @default(now())
  school        School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy     User?                @relation("AdmissionStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([schoolId, applicationId, createdAt])
}

model AdmissionComment {
  id            String               @id @default(cuid())
  schoolId      String
  applicationId String
  authorId      String?
  body          String
  isInternal    Boolean              @default(true)
  createdAt     DateTime             @default(now())
  school        School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author        User?                @relation("AdmissionCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
}

model AdmissionPaymentLink {
  id            String                 @id @default(cuid())
  schoolId      String
  applicationId String
  invoiceId     String?
  paymentId     String?
  verifiedById  String?
  reference     String
  amount        Decimal                @db.Decimal(12, 2)
  status        AdmissionPaymentStatus @default(PENDING)
  waived        Boolean                @default(false)
  verifiedAt    DateTime?
  metadata      Json?
  school        School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  application   AdmissionApplication   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  verifiedBy    User?                  @relation("AdmissionPaymentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@unique([schoolId, reference])
  @@index([applicationId, status])
}

model EnrollmentConversionLog {
  id                    String               @id @default(cuid())
  schoolId              String
  applicationId         String               @unique
  studentId             String
  convertedById         String?
  portalAccountsCreated Boolean              @default(false)
  notes                 String?
  createdAt             DateTime             @default(now())
  school                School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  application           AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  convertedBy           User?                @relation("EnrollmentConvertedBy", fields: [convertedById], references: [id], onDelete: SetNull)
}

model StaffProfile {
  id                      String                   @id @default(cuid())
  schoolId                String
  campusId                String?
  departmentId            String?
  userId                  String                   @unique
  school                  School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus                  Campus?                  @relation(fields: [campusId], references: [id], onDelete: SetNull)
  department              Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeNo              String
  designation             String
  staffType               String                   @default("ACADEMIC")
  employmentType          String?
  staffCategory           String?
  qualification           String?
  yearsOfExperience       Int?
  supervisorId            String?
  notes                   String?
  employmentDate          DateTime
  emergencyContactName    String?
  emergencyContactPhone   String?
  salaryBand              String?
  /// The band and the rung on it the person is paid at. Nobody is paid a typed figure.
  payBandId               String?
  payStep                 Int?
  payMethod               String?
  payMappedAt             DateTime?
  payBand                 PayBand?                 @relation(fields: [payBandId], references: [id], onDelete: SetNull)
  offCyclePayments        OffCyclePayment[]
  payrollItems            PayrollItem[]
  appraisals              StaffAppraisal[]         @relation("StaffAppraisalSubject")
  leaveRequests           LeaveRequest[]
  libraryLoans            LibraryLoan[]
  trainingParticipants    TrainingParticipant[]
  parentMeetings          ParentMeeting[]
  invigilationAssignments InvigilationAssignment[]
  idCards                 IdCard[]

  @@unique([schoolId, employeeNo])
}

model LeaveRequest {
  id           String       @id @default(cuid())
  schoolId     String
  staffId      String
  type         String
  startDate    DateTime
  endDate      DateTime
  reason       String
  status       LeaveStatus  @default(PENDING)
  reviewedAt   DateTime?
  /// Working days the leave covers, counted when it was asked for or recorded.
  days         Int?
  /// Who covers the classes, in words, and whether that has been arranged.
  cover        String?
  coverState   String       @default("Not arranged")
  /// The stage of the approval sequence the request is at.
  stage        String?
  /// REQUEST, or RECORDED when it was written up after it happened.
  source       String       @default("REQUEST")
  decisionNote String?
  decidedById  String?
  createdAt    DateTime     @default(now())
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff        StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model StaffAttendance {
  id             String                 @id @default(cuid())
  schoolId       String
  userId         String
  date           DateTime
  status         StaffAttendanceStatus
  checkInAt      DateTime?
  checkOutAt     DateTime?
  totalMinutes   Int?
  clockInMethod  String?
  clockOutMethod String?
  notes          String?
  school         School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  audits         StaffAttendanceAudit[]

  @@unique([schoolId, userId, date])
}

model StaffAttendancePolicy {
  id             String   @id @default(cuid())
  schoolId       String   @unique
  resumptionTime String   @default("07:45")
  closingTime    String   @default("15:30")
  graceMinutes   Int      @default(10)
  timezone       String   @default("Africa/Lagos")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model StaffAttendanceAudit {
  id                String          @id @default(cuid())
  schoolId          String
  staffAttendanceId String
  actorId           String?
  action            String
  note              String?
  createdAt         DateTime        @default(now())
  school            School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staffAttendance   StaffAttendance @relation(fields: [staffAttendanceId], references: [id], onDelete: Cascade)
  actor             User?           @relation("StaffAttendanceAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([schoolId, staffAttendanceId, createdAt])
}

model Subject {
  id                            String                         @id @default(cuid())
  schoolId                      String
  departmentId                  String?
  subjectCategoryId             String?
  school                        School                         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  department                    Department?                    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  subjectCategory               SubjectCategory?               @relation(fields: [subjectCategoryId], references: [id], onDelete: SetNull)
  name                          String
  code                          String
  section                       SchoolSection?
  applicableClassLevels         Json?
  description                   String?
  waecCode                      String?
  necoCode                      String?
  isWaecSubject                 Boolean                        @default(false)
  subjectCombination            String?
  periodsPerWeek                Int                            @default(3)
  requiresLab                   Boolean                        @default(false)
  sortOrder                     Int                            @default(0)
  isActive                      Boolean                        @default(true)
  isCore                        Boolean                        @default(false)
  isOptional                    Boolean                        @default(false)
  religionSpecific              Boolean                        @default(false)
  trackSpecific                 String?
  tradeSubject                  Boolean                        @default(false)
  status                        String                         @default("ACTIVE")
  deletedAt                     DateTime?
  classSubjects                 ClassSubject[]
  learningMaterials             LearningMaterial[]
  lessonPlans                   LessonPlan[]
  questionBankItems             QuestionBankItem[]
  scores                        ScoreEntry[]
  academicAssessments           AcademicAssessment[]
  seniorSecondaryResultArchives SeniorSecondaryResultArchive[]
  timetable                     TimetableEntry[]
  exams                         ExamTimetableEntry[]
  assignments                   Assignment[]
  curriculumTopics              CurriculumTopic[]
  teacherHistory                SubjectTeacherHistory[]
  schemeOfWork                  SchemeOfWork[]

  @@unique([schoolId, code])
  @@index([schoolId, isActive, deletedAt])
  @@index([schoolId, departmentId])
  @@index([schoolId, subjectCategoryId])
}

model CurriculumTopic {
  id                   String                   @id @default(cuid())
  schoolId             String
  academicSessionId    String
  termId               String
  classId              String
  subjectId            String
  teacherId            String?
  weekNumber           Int
  topic                String
  subTopic             String?
  learningObjectives   String?
  teacherNotes         String?
  recommendedResources String?
  assignmentNote       String?
  status               CurriculumStatus         @default(DRAFT)
  progressStatus       CurriculumProgressStatus @default(NOT_STARTED)
  actualDateTaught     DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  school               School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession      AcademicSession          @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  term                 Term                     @relation(fields: [termId], references: [id], onDelete: Cascade)
  classRoom            ClassRoom                @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject              Subject                  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([schoolId, termId, classId, subjectId, weekNumber, topic])
  @@index([schoolId, termId, classId, subjectId, status])
  @@index([schoolId, teacherId, progressStatus])
}

model SchemeOfWork {
  id                String             @id @default(cuid())
  schoolId          String
  subjectId         String
  classId           String
  academicSessionId String
  termId            String
  teacherId         String?
  status            SchemeOfWorkStatus @default(DRAFT)
  submittedAt       DateTime?
  submittedById     String?
  approvedAt        DateTime?
  approvedById      String?
  returnReason      String?
  /// Periods a week and minutes a period this scheme is planned on — the arithmetic behind "teaching time".
  periodsPerWeek    Int?
  lessonMinutes     Int?
  /// The curriculum it began from ("NERDC"), what it cites, and the book it teaches from.
  curriculum        String?
  source            String?
  book              String?
  /// A subject the teacher added themselves, because the school had not mapped it to them yet.
  addedByTeacher    Boolean            @default(false)
  /// The first week of the term it is planned for, when it begins part-way through.
  startWeek         Int                @default(1)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject           Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classRoom         ClassRoom          @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicSession   AcademicSession    @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  term              Term               @relation(fields: [termId], references: [id], onDelete: Cascade)
  teacher           User?              @relation("SchemeOfWorkTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  submittedBy       User?              @relation("SchemeOfWorkSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  approvedBy        User?              @relation("SchemeOfWorkApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  topics            SowTopic[]
  lessonPlans       LessonPlan[]

  @@unique([subjectId, classId, termId])
  @@index([schoolId, termId, status])
  @@index([schoolId, teacherId, termId])
  @@index([schoolId, classId, subjectId])
}

model SowTopic {
  id                    String                 @id @default(cuid())
  schoolId              String
  schemeOfWorkId        String
  weekNumber            Int
  topic                 String
  subtopics             Json?
  behaviouralObjectives String?
  content               String?
  teachingMethods       Json?
  teachingAids          Json?
  referenceMaterials    Json?
  evaluation            String?
  assignment            String?
  isCovered             Boolean                @default(false)
  coveredDate           DateTime?
  coveredById           String?
  actualTopicTaught     String?
  coverageNotes         String?
  weekType              SchemeOfWorkWeekType   @default(TEACHING)
  sortOrder             Int                    @default(0)
  /// "Postponed", "Partly taught"… set by the teacher; empty means the status is read from the calendar and what is covered.
  statusOverride        String?
  /// Which of the sub-topics have been covered, by position.
  coveredSubtopics      Int[]                  @default([])
  assessment            String?
  /// Periods this week takes, when it differs from the scheme's usual.
  periods               Int?
  /// [{ kind, label }] — a chapter, a worksheet, apparatus, a link.
  resourceList          Json?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  school                School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schemeOfWork          SchemeOfWork           @relation(fields: [schemeOfWorkId], references: [id], onDelete: Cascade)
  coveredBy             User?                  @relation("SowTopicCoveredBy", fields: [coveredById], references: [id], onDelete: SetNull)
  resources             SowTopicResource[]
  lessonPlans           LessonPlan[]           @relation("LessonPlanSowTopic")
  studentProgress       StudentTopicProgress[]

  @@unique([schemeOfWorkId, weekNumber])
  @@index([schoolId, schemeOfWorkId, isCovered])
  @@index([schoolId, weekType, weekNumber])
}

model SowTopicResource {
  id           String   @id @default(cuid())
  schoolId     String
  sowTopicId   String
  resourceType String
  title        String
  url          String?
  filePath     String?
  uploadedById String?
  createdAt    DateTime @default(now())
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sowTopic     SowTopic @relation(fields: [sowTopicId], references: [id], onDelete: Cascade)
  uploadedBy   User?    @relation("SowTopicResourceUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([schoolId, sowTopicId, createdAt])
}

model StudentTopicProgress {
  id            String              @id @default(cuid())
  schoolId      String
  sowTopicId    String
  studentId     String
  understanding TopicUnderstanding?
  assessedById  String?
  assessedAt    DateTime            @default(now())
  notes         String?
  school        School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sowTopic      SowTopic            @relation(fields: [sowTopicId], references: [id], onDelete: Cascade)
  student       Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assessedBy    User?               @relation("StudentTopicProgressAssessedBy", fields: [assessedById], references: [id], onDelete: SetNull)

  @@unique([sowTopicId, studentId])
  @@index([schoolId, studentId, assessedAt])
}

model ClassSubject {
  id                 String    @id @default(cuid())
  schoolId           String
  classId            String
  subjectId          String
  teacherId          String?
  /// A second teacher on the same subject-arm — the "assistant" a mapping can name.
  assistantTeacherId String?
  assignedById       String?
  assignedAt         DateTime  @default(now())
