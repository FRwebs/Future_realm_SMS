generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SchoolCategory {
  NURSERY
  PRIMARY
  SECONDARY
  COLLEGE
  MIXED
}

enum SchoolSection {
  CRECHE
  NURSERY
  PRIMARY
  JUNIOR_SECONDARY
  SENIOR_SECONDARY
}

enum UserRole {
  SUPER_ADMIN
  SCHOOL_OWNER
  PROPRIETOR
  ADMINISTRATOR
  PRINCIPAL
  HEAD_TEACHER
  VICE_PRINCIPAL_ACADEMICS
  VICE_PRINCIPAL_ADMINISTRATION
  VICE_PRINCIPAL_SPECIAL_DUTIES
  ADMIN_OFFICER
  TEACHER
  EXAM_OFFICER
  HEAD_OF_DEPARTMENT
  CLASS_TEACHER
  SUBJECT_TEACHER
  ACCOUNTANT
  PARENT
  STUDENT
  ADMISSIONS_OFFICER
  GUIDANCE_COUNSELLOR
  LIBRARIAN
  LABORATORY_STAFF
  ICT_CBT_ADMIN
  ATTENDANCE_OFFICER
  NURSE
  TRANSPORT_MANAGER
  HOSTEL_MANAGER
  HOSTEL_MASTER
  HOSTEL_MISTRESS
  STORE_OFFICER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  REVIEWING
  INCOMPLETE
  AWAITING_DOCUMENTS
  PAYMENT_PENDING
  SCREENING_SCHEDULED
  SCREENING_COMPLETED
  RECOMMENDED
  APPROVED
  CONDITIONALLY_APPROVED
  REJECTED
  WAITLISTED
  OFFER_SENT
  ACCEPTED
  DECLINED
  FINANCIALLY_CLEARED
  ENROLLED
  ACTIVE
}

enum AdmissionPaymentStatus {
  NOT_REQUIRED
  PENDING
  WAIVED
  VERIFIED
}

enum OfferStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  WITHDRAWN
  SUSPENDED
  ALUMNI
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum StaffAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  ON_LEAVE
  OFFICIAL_DUTY
}

enum CurriculumStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CurriculumProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  TAUGHT
  COMPLETED
}

enum TrainingCategory {
  PEDAGOGY
  CLASSROOM_MANAGEMENT
  SUBJECT_MASTERY
  CHILD_PROTECTION
  ASSESSMENT_GRADING
  ICT_DIGITAL_LITERACY
  CURRICULUM_ORIENTATION
  COMPLIANCE_PROFESSIONAL_DEVELOPMENT
}

enum TrainingType {
  INTERNAL
  EXTERNAL
  ONLINE
  PHYSICAL
  BLENDED
}

enum TrainingParticipantStatus {
  INVITED
  ATTENDED
  ABSENT
  COMPLETED
  OVERDUE
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum AssessmentType {
  ASSIGNMENT
  CLASSWORK
  QUIZ
  TEST
  MID_TERM_TEST
  PRACTICAL
  PROJECT
  EXAMINATION
}

enum AssessmentSubmissionMode {
  PAPER
  CBT
  PRACTICAL
  ORAL
}

enum AcademicAssessmentStatus {
  DRAFT
  ACTIVE
  CLOSED
  MARKED
  APPROVED
  PUBLISHED
}

enum AssessmentAttendanceState {
  PRESENT
  ABSENT
  EXCUSED
  MALPRACTICE_PENDING_REVIEW
}

enum AssessmentScoreFlag {
  NONE
  ABSENT
  INCOMPLETE
  WITHHELD
  MALPRACTICE
}

enum ResultWorkflowStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
  RETURNED
}

enum ResultApprovalAction {
  SUBMIT
  REVIEW
  APPROVE
  REJECT
  RETURN
  PUBLISH
  UNPUBLISH
}

enum AcademicApprovalStage {
  SUBJECT_TEACHER
  HEAD_OF_DEPARTMENT
  CLASS_TEACHER
  EXAM_OFFICER
  VICE_PRINCIPAL_ACADEMICS
  PRINCIPAL
  PUBLISHED
}

enum AcademicApprovalAction {
  SUBMIT
  APPROVE
  REJECT
  REQUEST_CORRECTION
  COMPILE
  PUBLISH
  UNLOCK
}

enum BroadsheetStatus {
  DRAFT
  IN_REVIEW
  CORRECTION_REQUESTED
  APPROVED
  PUBLISHED
  LOCKED
}

enum ReportCardStatus {
  DRAFT
  GENERATED
  PUBLISHED
  LOCKED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum PaymentMethod {
  CASH
  TRANSFER
  POS
  ONLINE
}

enum FeeComponentType {
  TUITION
  DEVELOPMENT_LEVY
  EXAM_FEE
  ICT_FEE
  PTA_FEE
  TRANSPORT
  HOSTEL
  BOOKS
  UNIFORM
  OTHER
}

enum FeeRecurrence {
  TERM
  SESSION
  ONE_TIME
}

enum InvoiceAdjustmentType {
  DISCOUNT
  WAIVER
  SCHOLARSHIP
  FINE
  REVERSAL
}

enum AdjustmentValueType {
  FIXED
  PERCENTAGE
}

enum ReceiptStatus {
  ISSUED
  VOID
}

enum InstallmentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum FinancialClearanceStatus {
  PENDING
  CLEARED
  WAIVED
  REVOKED
}

enum NotificationChannel {
  SMS
  EMAIL
  PUSH
  IN_APP
}

enum SyncDraftType {
  ATTENDANCE
  SCORE_ENTRY
}

enum IntegrationProvider {
  PAYSTACK
  FLUTTERWAVE
  SMTP
  S3
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  EXPORT
  APPROVE
  REJECT
  PAYMENT
}

model School {
  id                            String                         @id @default(cuid())
  name                          String
  slug                          String                         @unique
  category                      SchoolCategory
  isGroup                       Boolean                        @default(false)
  timezone                      String                         @default("Africa/Lagos")
  currency                      String                         @default("NGN")
  academicYearLabel             String                         @default("Session")
  termLabel                     String                         @default("Term")
  lowBandwidthMode              Boolean                        @default(true)
  address                       String?
  state                         String?
  country                       String                         @default("Nigeria")
  logoUrl                       String?
  primaryColor                  String?                        @default("#25593f")
  secondaryColor                String?                        @default("#c28c3d")
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  campuses                      Campus[]
  academicSessions              AcademicSession[]
  terms                         Term[]
  departments                   Department[]
  classLevels                   ClassLevel[]
  classRooms                    ClassRoom[]
  users                         User[]
  guardians                     Guardian[]
  students                      Student[]
  promotions                    PromotionRecord[]
  staffProfiles                 StaffProfile[]
  leaveRequests                 LeaveRequest[]
  staffAttendancePolicy         StaffAttendancePolicy?
  staffAttendanceAudits         StaffAttendanceAudit[]
  curriculumTopics              CurriculumTopic[]
  trainingPrograms              TrainingProgram[]
  trainingParticipants          TrainingParticipant[]
  admissionConfigs              AdmissionConfig[]
  admissions                    AdmissionApplication[]
  admissionHistories            AdmissionStatusHistory[]
  admissionComments             AdmissionComment[]
  admissionScreenings           AdmissionScreening[]
  admissionOffers               AdmissionOffer[]
  admissionPayments             AdmissionPaymentLink[]
  enrollmentConversions         EnrollmentConversionLog[]
  subjects                      Subject[]
  classSubjects                 ClassSubject[]
  gradingSchemes                GradingScheme[]
  gradeBands                    GradeBand[]
  assessments                   AssessmentComponent[]
  sectionAssessmentComponents   SectionAssessmentComponent[]
  academicAssessments           AcademicAssessment[]
  assessmentCandidates          AssessmentCandidate[]
  assessmentScoreAudits         AssessmentScoreAudit[]
  resultSheets                  ResultSheet[]
  scoreEntries                  ScoreEntry[]
  resultApprovals               ResultApproval[]
  resultPublications            ResultPublication[]
  broadsheets                   Broadsheet[]
  broadsheetApprovals           BroadsheetApprovalHistory[]
  reportCards                   ReportCard[]
  seniorSecondaryResultArchives SeniorSecondaryResultArchive[]
  studentAttendance             StudentAttendance[]
  staffAttendance               StaffAttendance[]
  assignments                   Assignment[]
  assignmentSubmissions         AssignmentSubmission[]
  feeStructures                 FeeStructure[]
  invoices                      Invoice[]
  payments                      Payment[]
  expenses                      Expense[]
  announcements                 Announcement[]
  internalMessages              InternalMessage[]
  notificationLogs              NotificationLog[]
  calendarEvents                CalendarEvent[]
  timetableEntries              TimetableEntry[]
  examTimetableEntries          ExamTimetableEntry[]
  transportRoutes               TransportRoute[]
  transportAssignments          TransportAssignment[]
  hostelBuildings               HostelBuilding[]
  hostelRooms                   HostelRoom[]
  hostelAllocations             HostelAllocation[]
  libraryBooks                  LibraryBook[]
  libraryLoans                  LibraryLoan[]
  auditLogs                     AuditLog[]
  syncDrafts                    SyncDraft[]
  integrationConfigs            IntegrationConfig[]
}

model Campus {
  id         String                 @id @default(cuid())
  schoolId   String
  school     School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name       String
  code       String
  address    String?
  phone      String?
  createdAt  DateTime               @default(now())
  classRooms ClassRoom[]
  students   Student[]
  staff      StaffProfile[]
  admissions AdmissionApplication[]
  events     CalendarEvent[]

  @@unique([schoolId, code])
}

model AcademicSession {
  id                            String                         @id @default(cuid())
  schoolId                      String
  school                        School                         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name                          String
  startDate                     DateTime
  endDate                       DateTime
  isCurrent                     Boolean                        @default(false)
  students                      Student[]
  terms                         Term[]
  curriculumTopics              CurriculumTopic[]
  promotionsFrom                PromotionRecord[]              @relation("PromotionFromSession")
  promotionsTo                  PromotionRecord[]              @relation("PromotionToSession")
  hostelAllocs                  HostelAllocation[]
  feeStructures                 FeeStructure[]
  AdmissionApplication          AdmissionApplication[]
  AdmissionConfig               AdmissionConfig[]
  academicAssessments           AcademicAssessment[]
  sectionAssessmentComponents   SectionAssessmentComponent[]
  broadsheets                   Broadsheet[]
  reportCards                   ReportCard[]
  seniorSecondaryResultArchives SeniorSecondaryResultArchive[]

  @@unique([schoolId, name])
}

model Term {
  id                            String                         @id @default(cuid())
  schoolId                      String
  academicSessionId             String
  school                        School                         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession               AcademicSession                @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  name                          String
  order                         Int
  startDate                     DateTime
  endDate                       DateTime
  isCurrent                     Boolean                        @default(false)
  resultSheets                  ResultSheet[]
  attendance                    StudentAttendance[]
  feeStructures                 FeeStructure[]
  assessments                   AssessmentComponent[]
  timetableEntries              TimetableEntry[]
  exams                         ExamTimetableEntry[]
  resultPublications            ResultPublication[]
  curriculumTopics              CurriculumTopic[]
  AdmissionApplication          AdmissionApplication[]
  AdmissionConfig               AdmissionConfig[]
  academicAssessments           AcademicAssessment[]
  sectionAssessmentComponents   SectionAssessmentComponent[]
  broadsheets                   Broadsheet[]
  reportCards                   ReportCard[]
  seniorSecondaryResultArchives SeniorSecondaryResultArchive[]

  @@unique([academicSessionId, order])
}

model Department {
  id         String         @id @default(cuid())
  schoolId   String
  school     School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name       String
  code       String
  subjects   Subject[]
  classRooms ClassRoom[]
  staff      StaffProfile[]

  @@unique([schoolId, code])
}

model ClassLevel {
  id            String         @id @default(cuid())
  schoolId      String
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name          String
  section       SchoolCategory
  schoolSection SchoolSection?
  order         Int
  classRooms    ClassRoom[]

  @@unique([schoolId, name])
}

model ClassRoom {
  id                            String                         @id @default(cuid())
  schoolId                      String
  campusId                      String?
  classLevelId                  String
  departmentId                  String?
  school                        School                         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus                        Campus?                        @relation(fields: [campusId], references: [id], onDelete: SetNull)
  classLevel                    ClassLevel                     @relation(fields: [classLevelId], references: [id], onDelete: Restrict)
  department                    Department?                    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  name                          String
  arm                           String
  capacity                      Int                            @default(40)
  students                      Student[]
  admissions                    AdmissionApplication[]
  classSubjects                 ClassSubject[]
  resultSheets                  ResultSheet[]
  attendance                    StudentAttendance[]
  timetable                     TimetableEntry[]
  exams                         ExamTimetableEntry[]
  assignments                   Assignment[]
  curriculumTopics              CurriculumTopic[]
  resultPublications            ResultPublication[]
  feeStructures                 FeeStructure[]
  openAdmissions                AdmissionConfig[]              @relation("AdmissionConfigOpenClasses")
  classTeacherId                String?
  academicAssessments           AcademicAssessment[]
  broadsheets                   Broadsheet[]
  reportCards                   ReportCard[]
  seniorSecondaryResultArchives SeniorSecondaryResultArchive[]

  @@unique([schoolId, name, arm])
}

model User {
  id                          String                      @id @default(cuid())
  schoolId                    String
  school                      School                      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  email                       String                      @unique
  phone                       String?
  firstName                   String
  lastName                    String
  passwordHash                String
  role                        UserRole
  isActive                    Boolean                     @default(true)
  lastLoginAt                 DateTime?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  guardian                    Guardian?
  student                     Student?
  staffProfile                StaffProfile?
  admissionsReviewed          AdmissionReview[]
  admissionScreeningsAssigned AdmissionScreening[]        @relation("AdmissionScreeningInterviewer")
  admissionComments           AdmissionComment[]          @relation("AdmissionCommentAuthor")
  admissionStatusChanges      AdmissionStatusHistory[]    @relation("AdmissionStatusChangedBy")
  admissionOffersIssued       AdmissionOffer[]            @relation("AdmissionOfferIssuedBy")
  admissionPaymentsVerified   AdmissionPaymentLink[]      @relation("AdmissionPaymentVerifiedBy")
  enrollmentConversions       EnrollmentConversionLog[]   @relation("EnrollmentConvertedBy")
  resultSheets                ResultSheet[]               @relation("ResultSheetCreatedBy")
  scoresEntered               ScoreEntry[]                @relation("ScoreEntryCreatedBy")
  academicAssessmentsAssigned AcademicAssessment[]        @relation("AcademicAssessmentTeacher")
  academicAssessmentsCreated  AcademicAssessment[]        @relation("AcademicAssessmentCreatedBy")
  assessmentScoresEntered     AssessmentCandidate[]       @relation("AssessmentScoreEnteredBy")
  assessmentScoresEdited      AssessmentCandidate[]       @relation("AssessmentScoreLastEditedBy")
  assessmentScoreAudits       AssessmentScoreAudit[]      @relation("AssessmentScoreAuditActor")
  resultApprovals             ResultApproval[]            @relation("ResultApprovalActor")
  resultPublications          ResultPublication[]         @relation("ResultPublicationActor")
  broadsheetsCompiled         Broadsheet[]                @relation("BroadsheetCompiledBy")
  broadsheetApprovals         BroadsheetApprovalHistory[] @relation("BroadsheetApprovalActor")
  reportCardsGenerated        ReportCard[]                @relation("ReportCardGeneratedBy")
  attendanceMarked            StudentAttendance[]         @relation("AttendanceMarkedBy")
  assignmentsCreated          Assignment[]                @relation("AssignmentCreatedBy")
  invoicesCreated             Invoice[]                   @relation("InvoiceCreatedBy")
  paymentsRecorded            Payment[]                   @relation("PaymentRecordedBy")
  announcements               Announcement[]
  messagesSent                InternalMessage[]           @relation("MessageSender")
  messagesReceived            InternalMessage[]           @relation("MessageRecipient")
  logs                        AuditLog[]
  drafts                      SyncDraft[]
  staffAttendance             StaffAttendance[]
  staffAttendanceAudits       StaffAttendanceAudit[]      @relation("StaffAttendanceAuditActor")
  trainingProgramsCreated     TrainingProgram[]           @relation("TrainingProgramCreatedBy")
  trainingParticipants        TrainingParticipant[]
}

model Guardian {
  id              String            @id @default(cuid())
  schoolId        String
  userId          String?           @unique
  school          School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName       String
  lastName        String
  phone           String
  email           String?
  relationship    String
  occupation      String?
  address         String?
  canReceiveSms   Boolean           @default(true)
  canReceiveEmail Boolean           @default(true)
  students        StudentGuardian[]

  @@index([schoolId, phone])
}

model Student {
  id                            String                         @id @default(cuid())
  schoolId                      String
  campusId                      String?
  userId                        String?                        @unique
  currentClassId                String?
  currentSessionId              String?
  school                        School                         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus                        Campus?                        @relation(fields: [campusId], references: [id], onDelete: SetNull)
  user                          User?                          @relation(fields: [userId], references: [id], onDelete: SetNull)
  currentClass                  ClassRoom?                     @relation(fields: [currentClassId], references: [id], onDelete: SetNull)
  currentSession                AcademicSession?               @relation(fields: [currentSessionId], references: [id], onDelete: SetNull)
  admissionNumber               String
  studentNumber                 String?
  firstName                     String
  lastName                      String
  middleName                    String?
  gender                        Gender
  dateOfBirth                   DateTime
  admissionDate                 DateTime
  registeredAdmission           AdmissionApplication?          @relation("AdmissionRegisteredStudent")
  status                        StudentStatus                  @default(ACTIVE)
  nationality                   String                         @default("Nigerian")
  stateOfOrigin                 String?
  religion                      String?
  medicalRecord                 MedicalRecord?
  documents                     StudentDocument[]
  behaviorLogs                  BehaviorLog[]
  guardians                     StudentGuardian[]
  promotions                    PromotionRecord[]
  resultSheets                  ResultSheet[]
  scoreEntries                  ScoreEntry[]
  attendance                    StudentAttendance[]
  assignmentSubmissions         AssignmentSubmission[]
  invoices                      Invoice[]
  payments                      Payment[]
  installmentPlans              InstallmentPlan[]
  financialClearances           FinancialClearance[]
  transport                     TransportAssignment[]
  hostelAllocation              HostelAllocation[]
  libraryLoans                  LibraryLoan[]
  assessmentCandidates          AssessmentCandidate[]
  reportCards                   ReportCard[]
  seniorSecondaryResultArchives SeniorSecondaryResultArchive[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId, currentClassId])
}

model StudentGuardian {
  studentId  String
  guardianId String
  isPrimary  Boolean  @default(false)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
}

model MedicalRecord {
  id         String  @id @default(cuid())
  studentId  String  @unique
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  bloodGroup String?
  genotype   String?
  allergies  String?
  conditions String?
  notes      String?
}

model StudentDocument {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  label     String
  fileName  String
  fileUrl   String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())
}

model BehaviorLog {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  category    String
  description String
  severity    String
  loggedAt    DateTime @default(now())
}

model PromotionRecord {
  id            String           @id @default(cuid())
  schoolId      String
  studentId     String
  fromClassId   String?
  toClassId     String?
  fromSessionId String?
  toSessionId   String?
  decision      String
  promotedAt    DateTime         @default(now())
  school        School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student       Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromSession   AcademicSession? @relation("PromotionFromSession", fields: [fromSessionId], references: [id], onDelete: SetNull)
  toSession     AcademicSession? @relation("PromotionToSession", fields: [toSessionId], references: [id], onDelete: SetNull)
}

model AdmissionApplication {
  id                    String                   @id @default(cuid())
  schoolId              String
  campusId              String?
  academicSessionId     String?
  termId                String?
  desiredClassId        String?
  reviewerId            String?
  registeredStudentId   String?                  @unique
  school                School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus                Campus?                  @relation(fields: [campusId], references: [id], onDelete: SetNull)
  academicSession       AcademicSession?         @relation(fields: [academicSessionId], references: [id], onDelete: SetNull)
  term                  Term?                    @relation(fields: [termId], references: [id], onDelete: SetNull)
  desiredClass          ClassRoom?               @relation(fields: [desiredClassId], references: [id], onDelete: SetNull)
  registeredStudent     Student?                 @relation("AdmissionRegisteredStudent", fields: [registeredStudentId], references: [id], onDelete: SetNull)
  applicationNo         String
  firstName             String
  lastName              String
  middleName            String?
  gender                Gender
  dateOfBirth           DateTime
  guardianName          String
  guardianPhone         String
  guardianEmail         String?
  emergencyContactName  String?
  emergencyContactPhone String?
  address               String?
  previousSchool        String?
  medicalNotes          String?
  duplicateFlag         Boolean                  @default(false)
  duplicateReason       String?
  applicationFeeStatus  AdmissionPaymentStatus   @default(PENDING)
  feeWaived             Boolean                  @default(false)
  applicantPortalToken  String?
  documents             AdmissionDocument[]
  reviews               AdmissionReview[]
  screenings            AdmissionScreening[]
  offers                AdmissionOffer[]
  comments              AdmissionComment[]
  history               AdmissionStatusHistory[]
  paymentLinks          AdmissionPaymentLink[]
  conversionLog         EnrollmentConversionLog?
  status                ApplicationStatus        @default(SUBMITTED)
  notes                 String?
  submittedAt           DateTime                 @default(now())
  decidedAt             DateTime?
  acceptedAt            DateTime?
  enrolledAt            DateTime?

  @@unique([schoolId, applicationNo])
  @@index([schoolId, status])
  @@index([schoolId, guardianPhone])
  @@index([schoolId, desiredClassId])
}

model AdmissionDocument {
  id            String               @id @default(cuid())
  applicationId String
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  label         String
  fileUrl       String
  mimeType      String
  sizeBytes     Int
  uploadedAt    DateTime             @default(now())
  isVerified    Boolean              @default(false)
  verifiedAt    DateTime?
}

model AdmissionReview {
  id            String               @id @default(cuid())
  applicationId String
  reviewerId    String
  decision      ApplicationStatus
  notes         String?
  reviewedAt    DateTime             @default(now())
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewer      User                 @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
}

model AdmissionConfig {
  id                        String           @id @default(cuid())
  schoolId                  String
  academicSessionId         String?
  termId                    String?
  name                      String
  isActive                  Boolean          @default(true)
  minAge                    Int?
  maxAge                    Int?
  requiredDocuments         Json
  formFields                Json
  applicationFeeAmount      Decimal          @default(0) @db.Decimal(12, 2)
  applicationFeeRequired    Boolean          @default(false)
  screeningRequired         Boolean          @default(true)
  principalApprovalRequired Boolean          @default(true)
  bursarClearanceRequired   Boolean          @default(true)
  offerExpiryDays           Int              @default(14)
  branding                  Json?
  communicationTemplates    Json?
  school                    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession           AcademicSession? @relation(fields: [academicSessionId], references: [id], onDelete: SetNull)
  term                      Term?            @relation(fields: [termId], references: [id], onDelete: SetNull)
  openClasses               ClassRoom[]      @relation("AdmissionConfigOpenClasses")
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  @@index([schoolId, isActive])
}

model AdmissionScreening {
  id             String               @id @default(cuid())
  schoolId       String
  applicationId  String
  interviewerId  String?
  scheduledAt    DateTime
  venue          String?
  score          Float?
  maxScore       Float                @default(100)
  result         String?
  remarks        String?
  recommendation String?
  attachmentUrl  String?
  completedAt    DateTime?
  school         School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  application    AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
