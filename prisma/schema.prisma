  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  outgoingOwner   User      @relation("OwnershipTransferOutgoingOwner", fields: [outgoingOwnerId], references: [id])
  incomingOwner   User?     @relation("OwnershipTransferIncomingOwner", fields: [incomingOwnerId], references: [id], onDelete: SetNull)
  approver1       User?     @relation("OwnershipTransferApprover1", fields: [approver1Id], references: [id], onDelete: SetNull)
  approver2       User?     @relation("OwnershipTransferApprover2", fields: [approver2Id], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([status])
}

