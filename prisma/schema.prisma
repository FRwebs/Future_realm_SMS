model School {
  id                            String                         @id @default(cuid())
  name                          String
  slug                          String                         @unique
  /// What the school calls itself in short — used in SMS, where characters cost money.
  shortName                     String?
  motto                         String?
  vision                        String?
  /// Co-educational, boys only or girls only — how the school describes its intake.
  composition                   String?
  /// "Day", "Boarding", or both — how its students attend.
  attendancePattern             String[]                       @default([])
  /// The stages the school says it operates ("Nursery", "Primary" …). Class levels
  /// say what exists; this says what the school has told us it runs.
  stagesOperated                String[]                       @default([])
  foundedYear                   Int?
  mainPhone                     String?
  postalCode                    String?
  /// Who regulates the school, and when its approval to operate runs out.
  regulatingAuthority           String?
  approvalExpiresAt             DateTime?
  /// The principal's signature and the school stamp, as files on record.
  signatureUrl                  String?
  stampUrl                      String?
  showMottoUnderLogo            Boolean                        @default(true)
  /// Which documents carry the school's branding: report cards, receipts, …
  brandingAppliesTo             String[]                       @default([])
  category                      SchoolCategory
  isGroup                       Boolean                        @default(false)
  isPersonalWorkspace           Boolean                        @default(false)
  timezone                      String                         @default("Africa/Lagos")
  currency                      String                         @default("NGN")
  academicYearLabel             String                         @default("Session")
  termLabel                     String                         @default("Term")
  lowBandwidthMode              Boolean                        @default(true)
  address                       String?
  city                          String?
  lga                           String?
  state                         String?
  country                       String                         @default("Nigeria")
  website                       String?
  schoolType                    String?
  curriculumPreference          String?
  estimatedStudentCount         Int?
  ownerName                     String?
  ownerEmail                    String?
  ownerPhone                    String?
  cacNumber                     String?
  ministryApprovalNumber        String?
  flaggedForReviewReason        String?
  riskScore                     Int?
  riskSignals                   Json?
  signupIp                      String?
  verifiedAt                    DateTime?
  verificationRejectedAt        DateTime?
  verificationRejectionReason   String?
  subdomain                     String?                        @unique
  schoolCode                    String?                        @unique
  logoUrl                       String?
  primaryColor                  String?                        @default("#25593f")
  secondaryColor                String?                        @default("#c28c3d")
  plan                          SubscriptionPlan               @default(BASIC)
  status                        TenantStatus                   @default(TRIAL)
  billingStatus                 BillingStatus                  @default(TRIAL)
  trialEndsAt                   DateTime?
  suspendedAt                   DateTime?
  suspendedReason               String?
  archivedAt                    DateTime?
  lastPaymentAt                 DateTime?
  nextBillingAt                 DateTime?
  healthScore                   Int                            @default(70)
  storageUsedGb                 Float                          @default(0)
  studentLimit                  Int?
  staffLimit                    Int?
  storageLimitGb                Float?
  smsLimitPerMonth              Int?
  emailLimitPerMonth            Int?
  apiUsageCount                 Int                            @default(0)
  dpaStatus                     String                         @default("PENDING")
  dpaVersion                    String?
  dpaAcceptedAt                 DateTime?
  dpaAcceptedById               String?
  accountManagerId              String?
  schoolGroupId                 String?
  featureFlags                  Json?
  prioritySupport               Boolean                        @default(false)
  dataExportedAt                DateTime?
  statusReason                  String?
  statusChangedAt               DateTime?
  deletedAt                     DateTime?
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  contacts                      SchoolContact[]
  migrationJobs                 MigrationJob[]
  partnerDeals                  PartnerDeal[]
  campuses                      Campus[]
  academicSessions              AcademicSession[]
  terms                         Term[]
  departments                   Department[]
  classLevels                   ClassLevel[]
  classRooms                    ClassRoom[]
  classAcademicAssignments      ClassAcademicAssignment[]
  configurationItems            ConfigurationItem[]
  skillDefinitions              SkillDefinition[]
  studentSkills                 StudentSkill[]
  users                         User[]
  profileDocuments              ProfileDocument[]
  profileEditRequests           ProfileEditRequest[]
  roles                         Role[]
  userRoles                     UserRoleAssignment[]
  userPermissionOverrides       UserPermissionOverride[]
  guardians                     Guardian[]
  students                      Student[]
  promotions                    PromotionRecord[]
  staffProfiles                 StaffProfile[]
  leaveRequests                 LeaveRequest[]
  staffAttendancePolicy         StaffAttendancePolicy?
  staffAttendanceAudits         StaffAttendanceAudit[]
  subjectCategories             SubjectCategory[]
  curriculumTopics              CurriculumTopic[]
  schemeOfWork                  SchemeOfWork[]
  sowTopics                     SowTopic[]
  sowTopicResources             SowTopicResource[]
  studentTopicProgress          StudentTopicProgress[]
  trainingPrograms              TrainingProgram[]
  trainingParticipants          TrainingParticipant[]
  admissionConfigs              AdmissionConfig[]
  admissions                    AdmissionApplication[]
  admissionHistories            AdmissionStatusHistory[]
  admissionComments             AdmissionComment[]
  admissionScreenings           AdmissionScreening[]
  admissionOffers               AdmissionOffer[]
