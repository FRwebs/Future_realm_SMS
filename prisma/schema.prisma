/// When one assessment component can be scored in one term, and when its result
/// reaches a guardian. The component says what is worth how much; the window
/// says when. A component with no window for a term is open whenever it is active.
model AssessmentWindow {
  id             String              @id @default(cuid())
  schoolId       String
  termId         String
  componentId    String
  opensAt        DateTime
  closesAt       DateTime
  releaseAt      DateTime
  appliesTo      String              @default("Every class")
  remindTeachers Boolean             @default(true)
  allowLateEntry Boolean             @default(false)
  /// Set when a closed window is opened again, with the reason it was given.
  reopenedAt     DateTime?
  reopenedReason String?
