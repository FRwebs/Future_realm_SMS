/// Something a family sent in: a query, an explanation, a request. It has an owner, a state and an age.
model GuardianSubmission {
  id          String    @id @default(cuid())
  schoolId    String
  guardianId  String
  studentId   String?
  type        String
  detail      String
  state       String    @default("NEW")
  ownerUserId String?
  ownerName   String?
  ownerRole   String?
  outcome     String?
  channel     String?
  /// What the family says backs it up — "Hospital card photographed". Their words, not a file.
  evidence    String?
  /// The days an absence explanation covers, as the family named them (YYYY-MM-DD).
  dates       String[]  @default([])
  /// What a type needs beyond words — a collection change names who will collect, and when.
  payload     Json?
  /// The school message this answers, when a family replies to one.
  deliveryId  String?
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  guardian    Guardian  @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  student     Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([schoolId, state, createdAt])
  @@index([deliveryId])
  @@index([guardianId, createdAt])
  @@index([studentId, state])
}

/// A consent is recorded against the family, never the child — one guardian answers once.
model FamilyConsent {
  id           String   @id @default(cuid())
  schoolId     String
  guardianId   String
  typeCode     String
  status       String   @default("GIVEN")
  means        String?
  note         String?
  recordedById String?
  recordedAt   DateTime @default(now())
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  guardian     Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([guardianId, typeCode])
  @@index([schoolId, typeCode, status])
}

/// Everything the school has sent a family that is not a fee conversation: invitations, consent requests, merges.
model GuardianContact {
  id          String   @id @default(cuid())
  schoolId    String
  guardianId  String
  kind        String
  channel     String?
  summary     String
  detail      Json?
  createdById String?
  createdAt   DateTime @default(now())
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  guardian    Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@index([schoolId, guardianId, createdAt])
}

/// How this school is billed: its tier, what it expects to pay, and how it wants to be told. Rows are made when the school first changes something; until then the tier is read from the school's plan.
model SchoolSubscription {
  id                 String          @id @default(cuid())
  /// A price this school keeps until the date, whatever the plan's price becomes meanwhile.
  lockedMonthlyPrice Decimal?        @db.Decimal(12, 2)
  priceLockedUntil   DateTime?
  priceLockReason    String?
  schoolId           String          @unique
  tier               String          @default("STANDARD")
  ratePerStudent     Decimal?        @db.Decimal(12, 2)
  baseSms            Int?
  baseWhatsapp       Int?
  autoRenew          Boolean         @default(false)
  remindDays         Int             @default(14)
  invoiceTo          String?
  receiptEmail       String?
  pendingTier        String?
  pendingFrom        DateTime?
  switchReason       String?
  keepCredits        Boolean         @default(true)
  autoTopup          Json?
  warnAt             Int             @default(2000)
  warnWho            String          @default("The Bursar")
  billingContact     String?
  billingEmail       String?
  schoolContact      String?
  productOnly        Boolean         @default(true)
  dpoName            String?
  dpoEmail           String?
  hosting            String?
  retentionDays      Int?
  /// ACTIVE, PENDING_DOWNGRADE or CANCELLED. A downgrade is scheduled rather than
  /// applied, so the subscription says so for the rest of the paid term.
  status             String          @default("ACTIVE")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  school             School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  ledger             BillingLedger[]
}

/// Why a school was charged what it was charged.
///
/// A per-head termly bill is arithmetic, but a mid-term upgrade is arithmetic
/// against a roll that moves — so the count and the part-term ratio used are
/// frozen here at the moment of the calculation. Without that an invoice cannot
/// be explained six months later, only recomputed against a roll that has since
/// changed.
model BillingLedger {
  id                   String              @id @default(cuid())
  schoolId             String
  subscriptionId       String?
  /// The term the charge belongs to. Null only if the school has no term yet.
  termId               String?
  /// INITIAL_BILL, MIDTERM_UPGRADE_CHARGE or MIDTERM_DOWNGRADE_CREDIT.
  type                 String
  amount               Decimal             @db.Decimal(12, 2)
  /// The active roll at the instant of calculation, never recounted afterwards.
  studentCountSnapshot Int
  /// The part of the term that was still unused, as a fraction. 1 for a full term.
  prorationRatio       Decimal             @default(1) @db.Decimal(6, 5)
  fromTier             String?
  toTier               String?
  description          String
  invoiceId            String?
  createdById          String?
  createdAt            DateTime            @default(now())
  school               School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subscription         SchoolSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  term                 Term?               @relation(fields: [termId], references: [id], onDelete: SetNull)

  @@index([schoolId, termId])
  @@index([schoolId, createdAt])
}

/// Every credit that came onto, or went off, the messaging wallet — so a balance can be explained.
model CreditLedger {
  id          String   @id @default(cuid())
  schoolId    String
  channel     String
  kind        String
  credits     Int
  amount      Decimal  @default(0) @db.Decimal(12, 2)
  invoiceId   String?
  method      String?
  note        String?
  createdById String?
  createdAt   DateTime @default(now())
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, channel, createdAt])
}

/// A full-school export: asked for with the password (and a code), noticed by the leadership, and downloadable once per dataset until it expires.
model FullExport {
  id            String    @id @default(cuid())
  schoolId      String
  requestedById String
  token         String    @unique
  datasets      Json
  rows          Int       @default(0)
  expiresAt     DateTime
  downloadedAt  DateTime?
  createdAt     DateTime  @default(now())
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
}

/// Closing the account is blocked until a full export has been downloaded.
model AccountClosureRequest {
  id            String   @id @default(cuid())
  schoolId      String
  requestedById String
  exportId      String?
  reason        String
  status        String   @default("REQUESTED")
  retentionDays Int      @default(90)
  createdAt     DateTime @default(now())
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
}

/// One arm's register for one day. Its presence is what separates "everyone was present"
/// from "nobody took the register" — the second is unknown, and is never counted as the first.
model AttendanceRegister {
  id             String    @id @default(cuid())
  schoolId       String
  classId        String
  termId         String
  date           DateTime
  /// DRAFT while the marker is still working; SUBMITTED once written to the day.
  status         String    @default("SUBMITTED")
  /// Marks entered but not submitted: { studentId: { status, reason } }.
  draft          Json?
  markedById     String
  startedAt      DateTime  @default(now())
  /// Null on registers that predate the clock — their marking time is not known.
  submittedAt    DateTime?
  roll           Int       @default(0)
  late           Boolean   @default(false)
  backdated      Boolean   @default(false)
  backdateReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([classId, date])
  @@index([schoolId, date])
  @@index([schoolId, markedById, date])
}

/// A change to a register already saved: the old mark, the new one, why, and who agreed.
model AttendanceCorrection {
  id            String    @id @default(cuid())
  schoolId      String
  classId       String
  studentId     String
  date          DateTime
  fromStatus    String
  toStatus      String
  /// SAME_DAY (free), PRIOR_DAY (needs approval), GUARDIAN (an explanation accepted).
  kind          String
  reasonCode    String
  explanation   String
  evidence      Boolean   @default(false)
  /// APPLIED, AWAITING, DECLINED.
  status        String
  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime  @default(now())
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status, createdAt])
  @@index([schoolId, studentId, date])
}

/// A formal chronic-absence case. It opens itself below the threshold and cannot be closed
/// without a recorded outcome.
model AttendanceCase {
  id           String    @id @default(cuid())
  schoolId     String
  studentId    String
  termId       String
  classId      String?
  openedAt     DateTime  @default(now())
  openedAtRate Float
  automatic    Boolean   @default(true)
  openedById   String?
  status       String    @default("OPEN")
  outcome      String?
  outcomeNote  String?
  closedAt     DateTime?
  closedById   String?
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([studentId, termId])
  @@index([schoolId, status])
}

/// One subject in one arm for one term: the unit a teacher enters, an Exam Officer approves
/// and a report card waits for. It pins the assessment framework it was entered under.
model ScoreSheet {
  id            String    @id @default(cuid())
  schoolId      String
  termId        String
  classId       String
  subjectId     String
  /// IN_PROGRESS, SUBMITTED, RETURNED, APPROVED. No row at all is "Not started".
  status        String    @default("IN_PROGRESS")
  /// The components this sheet was entered under, pinned: [{ id, code, name, max, weight }].
  framework     Json
  frameworkAt   DateTime  @default(now())
  /// Children marked absent from a component: { studentId: [componentId] }. Never stored as zero.
  absences      Json      @default("{}")
  /// Outcomes recorded against a verification flag: { key: { outcome, note, by, at } }.
  flagOutcomes  Json      @default("{}")
  enteredByIds  String[]  @default([])
  submittedById String?
  submittedAt   DateTime?
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  returnedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([termId, classId, subjectId])
  @@index([schoolId, termId, status])
}

/// A change to a score that has already been approved: the old mark, the new one, the reason
/// and the consequence, decided in two steps once a parent has seen the result.
model ScoreCorrection {
  id            String    @id @default(cuid())
  schoolId      String
  termId        String
  classId       String
  subjectId     String
  studentId     String
  sheetId       String?
  componentId   String
  componentName String
  fromScore     Float?
  toScore       Float
  reasonCode    String
  explanation   String
  evidence      String?
  /// AWAITING (first step), IN_REVIEW (second step), APPROVED, DECLINED.
  status        String    @default("AWAITING")
  reachedParent Boolean   @default(false)
  requestedById String
  stepOneById   String?
  stepOneAt     DateTime?
  stepOneNote   String?
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  /// Before/after average and position, written when it is decided.
  effect        Json?
  revision      Int?
  approvalId    String?
  createdAt     DateTime  @default(now())
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status, createdAt])
  @@index([schoolId, classId, subjectId])
}

/// What a form master or the Principal wrote about a child's term, kept as a draft until it is submitted
/// onto the card. A submitted remark is also written to the result sheet, where older readers look.
model ReportRemark {
  id          String    @id @default(cuid())
  schoolId    String
  studentId   String
  termId      String
  classId     String?
  /// FORM_MASTER or PRINCIPAL.
  author      String
  text        String
  tone        String?
  flags       String[]  @default([])
  /// DRAFT or SUBMITTED.
  state       String    @default("SUBMITTED")
  authorId    String
  onBehalf    Boolean   @default(false)
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([studentId, termId, author])
  @@index([schoolId, termId, classId])
}

/// Every version of a card that has reached a family. A correction is stored beside the original,
/// never over it.
model ReportCardRevision {
  id          String   @id @default(cuid())
  schoolId    String
  cardId      String
  studentId   String
  termId      String
  revision    Int
  /// ISSUE, CORRECTION or REISSUE.
  kind        String
  reason      String
  data        Json
  createdById String?
  notified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, cardId, revision])
  @@index([schoolId, termId])
}

/// A run of printing, publishing or sending: who did it, for what scope, how many cards, and when.
model CardBatch {
  id        String   @id @default(cuid())
  schoolId  String
  termId    String
  /// PRINT, PUBLISH, SEND or UNPUBLISH.
  kind      String
  scope     String
  cards     Int
  skipped   Int      @default(0)
  channels  String[] @default([])
  byId      String
  cardIds   String[] @default([])
  createdAt DateTime @default(now())
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, termId, createdAt])
}

/// A send: who it went to, what it cost, and where it got to.
///
/// Separate from `Campaign`, which carries no schoolId and belongs to platform
/// marketing. A school's send has to be scoped to the school, countable in
/// credits, and answerable to the mass-communication threshold.
model MessageCampaign {
  id             String                @id @default(cuid())
  schoolId       String
  name           String
  channel        NotificationChannel   @default(SMS)
  /// The criteria, kept as criteria rather than a frozen list, so a family who
  /// clears their fees drops out of a saved segment on its own.
  audience       Json?
  audienceLabel  String                @default("Guardians")
  body           String
  status         MessageCampaignStatus @default(DRAFT)
  /// Set when the send is above the school's threshold and needs a decision.
  thresholdAt    Int?
  scheduledAt    DateTime?
  sentAt         DateTime?
  recipientCount Int                   @default(0)
  deliveredCount Int                   @default(0)
  failedCount    Int                   @default(0)
  /// What it actually cost, in credits — never an estimate after the fact.
  creditsUsed    Int                   @default(0)
  decisionNote   String?
  createdById    String?
  approvedById   String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  school         School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy      User?                 @relation("MessageCampaignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy     User?                 @relation("MessageCampaignApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  deliveries     MessageDelivery[]

  @@index([schoolId, status, createdAt])
  @@index([schoolId, sentAt])
}

/// One recipient's outcome. The failures table is read from here, with the
/// reason attached to the row that fixes it rather than to the campaign.
model MessageDelivery {
  id               String                @id @default(cuid())
  schoolId         String
  campaignId       String
  guardianId       String?
  recipientName    String
  destination      String?
  status           MessageDeliveryStatus @default(PENDING)
  /// Why it failed, in words somebody can act on.
  failureReason    String?
  deliveredAt      DateTime?
  createdAt        DateTime              @default(now())
  /// The words this recipient was sent, merge fields resolved — what the family's inbox shows.
  body             String?
  channel          NotificationChannel?
  /// What this one recipient cost, in credits: a long SMS is more than one.
  credits          Int                   @default(0)
  readAt           DateTime?
  acknowledgeAsked Boolean               @default(false)
  acknowledgedAt   DateTime?
  /// The queued carrier message that takes it out of the building, so the carrier's answer can come back here.
  logId            String?
  school           School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campaign         MessageCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([campaignId, status])
  @@index([guardianId, createdAt])
  @@index([logId])
}

/// A school's own message wording, versioned so a sent message always renders
/// as the version that was sent rather than as the template reads today.
model SchoolMessageTemplate {
  id         String              @id @default(cuid())
  schoolId   String
  name       String
  channel    NotificationChannel @default(SMS)
  body       String
  /// Merge fields the body uses, validated before a send unlocks.
  variables  String[]            @default([])
  owner      TemplateOwner       @default(SCHOOL)
  version    Int                 @default(1)
  lastUsedAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  school     School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, name])
  @@index([schoolId, owner])
}

enum MessageCampaignStatus {
  DRAFT
  AWAITING_APPROVAL
  SCHEDULED
  SENT
  CANCELLED
  RETURNED
}

enum MessageDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  EXCLUDED
}

/// Who owns the wording: the school, the system, or Future Realm's
/// pre-approved library.
enum TemplateOwner {
  SCHOOL
  SYSTEM
  PLATFORM
}

/// A return this school owes somebody: a ministry, a board, an examinations
/// council, an inspectorate. Unlike analytics, a return has a recipient, a
/// deadline and a format, and it is either filed or it is not.
model ComplianceReturn {
  id        String                 @id @default(cuid())
  schoolId  String
  name      String
  /// Who it goes to. Not an enum: every country has its own bodies.
  body      String
  period    String
  dueOn     DateTime
  format    String
  covers    String
  status    ComplianceReturnStatus @default(NOT_STARTED)
  filedOn   DateTime?
  /// The officer answerable for it, by role, so it survives them leaving.
  ownerRole String?
  ownerId   String?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  school    School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  owner     User?                  @relation("ComplianceReturnOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@unique([schoolId, name, period])
  @@index([schoolId, status, dueOn])
}

/// A data subject exercising a right. The clock is statutory, so the days left
/// are computed from receivedOn rather than stored and left to go stale.
model DataSubjectRequest {
  id            String                   @id @default(cuid())
  schoolId      String
  reference     String
  kind          DataSubjectRequestKind
  requesterName String
  /// Whose data it is about, when that is not the requester.
  subjectName   String?
  status        DataSubjectRequestStatus @default(OPEN)
  receivedOn    DateTime                 @default(now())
  /// Statutory response window in days — 30 under the NDPA, but set per case.
  dueDays       Int                      @default(30)
  closedOn      DateTime?
  outcome       String?
  ownerId       String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  school        School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  owner         User?                    @relation("DataSubjectRequestOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@unique([schoolId, reference])
  @@index([schoolId, status, receivedOn])
}

/// How long a class of data is kept, and on what basis.
///
/// The one control on the Data Protection tab that cannot be derived: it has to
/// be decided and then enforced. Until a row exists, the honest answer is that
/// the data is held indefinitely.
model RetentionPolicy {
  id        String   @id @default(cuid())
  schoolId  String
  dataClass String
  /// Null means permanent — a transcript may be asked for decades later.
  years     Int?
  untilAge  Int?
  basis     String
  hostedIn  String   @default("Nigeria")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, dataClass])
}

/// Something a monitor found that a person should look at. Raised by the
/// integrity checks, cleared by somebody who says why.
model IntegrityFlag {
  id           String              @id @default(cuid())
  schoolId     String
  monitor      String
  detail       String
  severity     IntegritySeverity   @default(ATTENTION)
  status       IntegrityFlagStatus @default(OPEN)
  entityType   String?
  entityId     String?
  resolution   String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  school       School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  resolvedBy   User?               @relation("IntegrityFlagResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([schoolId, status, createdAt])
}

enum ComplianceReturnStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  FILED
  AMENDED
}

enum DataSubjectRequestKind {
  ACCESS
  CORRECTION
  ERASURE
  PORTABILITY
  OBJECTION
}

enum DataSubjectRequestStatus {
  OPEN
  RESPONDED
  CLOSED
  REFUSED
}

enum IntegritySeverity {
  NORMAL
  ATTENTION
  CRITICAL
}

enum IntegrityFlagStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// The last few passwords, kept as hashes so a new one cannot be one of them.
model PasswordHistory {
  id        String   @id @default(cuid())
  userId    String
  hash      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// A teacher who signed up alone asking to be linked to a school that is already on the platform. The school's administrator decides.
model SchoolJoinRequest {
  id          String    @id @default(cuid())
  userId      String
  schoolId    String
  nameClaimed String
  subjects    String[]  @default([])
  levels      String[]  @default([])
  status      String    @default("PENDING")
  note        String?
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation("JoinRequester", fields: [userId], references: [id], onDelete: Cascade)
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([userId])
}

/// A time-boxed discount grant for an NGO or a mission school: who verified it, on what evidence, and when it must be verified again.
/// status: PENDING (asked for, not yet verified), VERIFIED, EXPIRED (the year ran out and the plan was moved off the discount), REVOKED.
model SchoolConcession {
  id            String    @id @default(cuid())
  schoolId      String
  kind          String
  status        String    @default("PENDING")
  evidence      String?
  evidenceRef   String?
  verifiedAt    DateTime?
  verifiedById  String?
  expiresAt     DateTime?
  revokedReason String?
  priorPlan     String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
}

/// One line of commission: what was collected on a reconciled invoice, at what rate, in which year of the relationship.
/// kind ACCRUAL is money earned; CLAWBACK is negative, from a payment that was reversed or refunded.
model PartnerAccrual {
  id               String            @id @default(cuid())
  partnerId        String
  dealId           String?
  schoolId         String
  invoiceId        String?
  transactionId    String?
  stream           String            @default("B")
  kind             String            @default("ACCRUAL")
  collected        Decimal           @db.Decimal(14, 2)
  ratePercent      Decimal           @db.Decimal(5, 2)
  relationshipYear Int?
  commission       Decimal           @db.Decimal(14, 2)
  reconciledAt     DateTime
  statementId      String?
  voidedAt         DateTime?
  voidReason       String?
  note             String?
  createdAt        DateTime          @default(now())
  partner          Partner           @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  deal             PartnerDeal?      @relation(fields: [dealId], references: [id], onDelete: SetNull)
  statement        PartnerStatement? @relation(fields: [statementId], references: [id], onDelete: SetNull)

  @@index([partnerId, statementId])
  @@index([schoolId])
  @@index([invoiceId, kind])
}

/// A statement of account, issued whether or not the amount is positive. Its lines are kept as they were issued.
model PartnerStatement {
  id          String           @id @default(cuid())
  partnerId   String
  ref         String           @unique
  period      String
  periodStart DateTime
  periodEnd   DateTime
  gross       Decimal          @db.Decimal(14, 2)
  clawbacks   Decimal          @db.Decimal(14, 2)
  net         Decimal          @db.Decimal(14, 2)
  invoices    Int              @default(0)
  status      String           @default("ISSUED")
  lines       Json
  issuedAt    DateTime         @default(now())
  issuedById  String?
  dueAt       DateTime
  settledAt   DateTime?
  settledById String?
  paymentRef  String?
  partner     Partner          @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  accruals    PartnerAccrual[]

  @@index([partnerId, status])
}

/// Two parties claiming one school. Decided against the registration record; where it is upheld, commission moves from the point of attribution.
model PartnerDispute {
  id                String    @id @default(cuid())
  schoolId          String
  raisedByPartnerId String?
  counterpartyLabel String
  grounds           String
  evidence          String?
  status            String    @default("OPEN")
  outcome           String?
  decidedById       String?
  decidedAt         DateTime?
  reattributedTo    String?
  recalculation     Json?
  createdById       String?
  createdAt         DateTime  @default(now())

  @@index([status])
}

/// How long a page took to become usable on a real person's device, and on what kind of connection.
model PageLoadSample {
  id         String   @id @default(cuid())
  schoolId   String?
  path       String
  loadMs     Int
  connection String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([connection, createdAt])
}

/// One run of the result computation for an arm: how many students and scores it read, how long it took, and whether it re-ran over results already published.
model ComputationRun {
  id           String   @id @default(cuid())
  /// How many results this run could trace back to recorded component scores, out of how many it checked.
  traceChecked Int?
  traceMatched Int?
  schoolId     String
  classId      String
  termId       String
  students     Int
  records      Int
  durationMs   Int
  recompute    Boolean  @default(false)
  reason       String?
  createdAt    DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([createdAt])
}

/// What the platform owes a regulator, one row per obligation, with the date it is next due and the proof it was met.
model ComplianceObligation {
  id          String    @id @default(cuid())
  code        String    @unique
  title       String
  cadence     String
  ownerRole   String
  /// NOT_STARTED, IN_PROGRESS or COMPLIANT. "Overdue" is worked out from dueAt, never stored.
  status      String    @default("NOT_STARTED")
  dueAt       DateTime?
  lastDoneAt  DateTime?
  reference   String?
  notes       String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Every version of the data processing agreement the platform has published; exactly one is current.
model DpaVersion {
  id            String   @id @default(cuid())
  version       String   @unique
  effectiveFrom DateTime
  summary       String?
  isCurrent     Boolean  @default(false)
  createdById   String?
  createdAt     DateTime @default(now())
}

/// How long a class of data is kept, why, and what starts the clock.
model RetentionRule {
  id            String   @id @default(cuid())
  dataClass     String   @unique
  retentionDays Int
  basis         String
  trigger       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// A copy of the audit trail taken out of the system: who took it, why, which filters, and exactly what they got.
model AuditExport {
  id        String   @id @default(cuid())
  actorId   String?
  reason    String
  format    String   @default("CSV")
  filters   Json
  rowCount  Int
  truncated Boolean  @default(false)
  content   String
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

/// Every stage a feature flag has been through: who moved it, when, and what they said was met.
model FeatureFlagStage {
  id        String              @id @default(cuid())
  flagId    String
  fromStage String
  toStage   String
  percent   Int                 @default(0)
  note      String?
  byId      String?
  createdAt DateTime            @default(now())
  flag      PlatformFeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@index([flagId, createdAt])
}

/// A change to who may use a feature: what it was, what it became, why, and how many schools it touched.
model TierFeatureChange {
  id              String   @id @default(cuid())
  featureName     String
  kind            String
  before          Json?
  after           Json
  reason          String
  migrationPlan   String?
  affectedSchools Int      @default(0)
  byId            String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

/// A snapshot of a plan as it stood, taken whenever it changes — the plan's own history.
model PlanVersion {
  id          String   @id @default(cuid())
  planId      String
  version     Int
  snapshot    Json
  summary     String
  changedById String?
  effectiveAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([planId, version])
}

/// A new price for a plan, announced to the schools on it and applied only once the notice period has run.
model PlanPriceChange {
  id              String    @id @default(cuid())
  planId          String
  oldMonthly      Decimal   @db.Decimal(12, 2)
  newMonthly      Decimal   @db.Decimal(12, 2)
  oldAnnual       Decimal   @db.Decimal(12, 2)
  newAnnual       Decimal   @db.Decimal(12, 2)
  announcedAt     DateTime  @default(now())
  effectiveAt     DateTime
  status          String    @default("SCHEDULED")
  subscribersTold Int       @default(0)
  reason          String?
  createdById     String?
  appliedAt       DateTime?

  @@index([status, effectiveAt])
}

/// A device a platform admin has chosen to trust, so MFA is not re-asked for
/// thirty days.
///
/// The token is stored hashed and never returned after issue: a trusted-device
/// cookie is a second factor in its own right, and a table of readable ones
/// would be a list of ways past MFA.
model AdminTrustedDevice {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  label      String?
  ipAddress  String?
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
}

/// How a subject in one curriculum version became a subject in the next, so a child's history stays explainable.
model TemplateSubjectMapping {
  id             String   @id @default(cuid())
  fromTemplateId String
  toTemplateId   String
  fromSubject    String
  toSubject      String
  /// RENAMED, MERGED (several old into one new), SPLIT (one old into several new), DROPPED has no toSubject so is not stored here.
  relationship   String   @default("RENAMED")
  createdById    String?
  createdAt      DateTime @default(now())

  @@unique([fromTemplateId, toTemplateId, fromSubject, toSubject])
}

/// What the platform knows about a country, held as data so a launch there is configuration, not code.
model CountryProfile {
  id                    String   @id @default(cuid())
  country               String   @unique
  currency              String   @default("NGN")
  phonePattern          String?
  phonePrefixes         String[] @default([])
  educationAuthority    String?
  registrationAuthority String?
  defaultChannel        String?
  consentAge            Int?
  dataProtectionRegime  String?
  verificationSources   String[] @default([])
  isLive                Boolean  @default(false)
  /// When the support desk is staffed there, e.g. "08:00–17:00 WAT, Mon–Fri". Service-level clocks pause outside it.
  supportHours          String?
  publicHolidays        Int?
  /// IANA name, e.g. Africa/Lagos. Service-level clocks for a school in this country run in this zone.
  timeZone              String?
  workStart             String?
  workEnd               String?
  /// ISO weekdays the desk is staffed, 1 = Monday … 7 = Sunday.
  workDays              Int[]    @default([1, 2, 3, 4, 5])
  /// Dates the desk is closed, as YYYY-MM-DD.
  holidayDates          String[] @default([])
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

/// Which master template version a school's setup copied — the school then owns its copy.
model TemplateAdoption {
  id           String   @id @default(cuid())
  schoolId     String
  kind         String
  templateId   String
  templateName String
  version      String
  adoptedAt    DateTime @default(now())

  @@index([schoolId])
  @@index([templateId])
}

/// A school's standing on one day — what makes a retention curve possible, because "active today" cannot say what it was last term.
model SchoolSnapshot {
  id        String   @id @default(cuid())
  day       String
  schoolId  String
  status    String
  plan      String
  createdAt DateTime @default(now())

  @@unique([day, schoolId])
  @@index([day])
}

/// How many schools used a module in the 60 days to a given day, kept weekly so a trend can be drawn.
model ModuleSnapshot {
  id     String @id @default(cuid())
  day    String
  module String
  using  Int
  total  Int

  @@unique([day, module])
}

/// Who is accountable for a growth-funnel stage.
model FunnelStageOwner {
  stage     String   @id
  ownerId   String
  updatedAt DateTime @updatedAt
}

/// What the team knows about a Back Office person beyond their role: where they sit, who they answer to, and what they may see.
model InternalProfile {
  userId           String   @id
  departmentId     String?
  level            String?
  /// Empty means the whole platform. Otherwise this person sees only schools in these states.
  scopeStates      String[] @default([])
  managerId        String?
  staffNumber      String?
  isExternal       Boolean  @default(false)
  /// What this person answers for — DPO, Support Lead, Comms Lead … Alerts and "who to ask" go to whoever holds one.
  responsibilities String[] @default([])
  /// A role defined in the Back Office rather than built in. Its grid is what this person starts from.
  customRoleId     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Something about a Back Office account's behaviour that a person should look at: out-of-hours access, an unfamiliar device, a large export, two places at once.
model InternalAnomaly {
  id           String    @id @default(cuid())
  userId       String
  kind         String
  detail       String
  detectedAt   DateTime  @default(now())
  status       String    @default("OPEN")
  reviewedById String?
  reviewedAt   DateTime?
  note         String?

  @@index([status, detectedAt])
  @@index([userId, kind, detectedAt])
}

/// A school a group of individual teachers named, kept for someone to approach — never a message to the school itself.
model TeacherApproach {
  id          String   @id @default(cuid())
  schoolName  String
  teacherIds  String[] @default([])
  /// LISTED until someone routes it; ROUTED once it sits under a registered partner deal.
  status      String   @default("LISTED")
  dealId      String?
  note        String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolName])
}

/// One step of the trial communication schedule for one school: sent, or suppressed because it would be absurd.
model TrialMessage {
  id        String   @id @default(cuid())
  schoolId  String
  step      String
  status    String
  reason    String?
  logId     String?
  createdAt DateTime @default(now())

  @@unique([schoolId, step])
  @@index([step, status])
}

/// One attempt by the platform to refill a school's credits when its balance fell below the floor, and how it ended.
model AutoTopupAttempt {
  id        String   @id @default(cuid())
  schoolId  String
  channel   String
  credits   Int
  amount    Decimal  @default(0) @db.Decimal(12, 2)
  trigger   String
  invoiceId String?
  /// Set when the card on file was charged; the gateway's own reference, and why a charge failed.
  reference String?
  failure   String?
  charged   Boolean  @default(false)
  /// ISSUED (an invoice was raised and the owner told), STOPPED (three unpaid in a row — a person now owns it).
  outcome   String
  attempt   Int      @default(1)
  createdAt DateTime @default(now())

  @@index([schoolId, createdAt])
}

/// What a Back Office person opened lately, so My Work can put them back where they left off. One row per person and record.
model AdminView {
  id       String   @id @default(cuid())
  userId   String
  kind     String
  entityId String
  label    String
  href     String
  viewedAt DateTime @default(now())

  @@unique([userId, kind, entityId])
  @@index([userId, viewedAt])
}

/// A card a school has agreed to be charged automatically. Only the gateway's reusable authorization is kept — never a card number.
model SavedCard {
  id            String    @id @default(cuid())
  schoolId      String
  provider      String
  authorization String
  signature     String
  last4         String
  brand         String?
  bank          String?
  expMonth      String?
  expYear       String?
  email         String
  createdById   String?
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime?
  removedAt     DateTime?

  @@unique([schoolId, signature])
  @@index([schoolId, removedAt])
}

/// A person who belongs to a school other than the one their account was created in, with the role they hold there.
/// One account, many schools: they switch between them without a second login. `expiresAt` makes it time-boxed (an external examiner).
model SchoolMembership {
  id          String    @id @default(cuid())
  userId      String
  schoolId    String
  role        UserRole
  status      String    @default("ACTIVE")
  expiresAt   DateTime?
  invitedById String?
  note        String?
  createdAt   DateTime  @default(now())
  removedAt   DateTime?

  @@unique([userId, schoolId])
  @@index([schoolId, status])
}

/// A feature request that arrived by call, visit or WhatsApp, logged by hand so it carries the same weight as a tagged ticket.
/// A request merged into an earlier one points at it with mergedIntoId and adds its school's weight to that request.
model FeatureRequestLog {
  id            String   @id @default(cuid())
  title         String
  detail        String?
  module        String?
  schoolId      String
  personName    String?
  channel       String
  severity      String   @default("MEDIUM")
  blocksRenewal Boolean  @default(false)
  raisedOn      DateTime
  mergedIntoId  String?
  tellSchool    Boolean  @default(true)
  roadmapFlag   Boolean  @default(false)
  ticketRef     String?
  loggedById    String
  createdAt     DateTime @default(now())

  @@index([mergedIntoId])
  @@index([schoolId])
}

/// A rule the platform follows without anyone pressing a button: when this happens, tell these people, on these channels, in these words.
/// A new rule is created disabled and only starts sending once somebody deliberately enables it.
model TriggerRule {
  id          String            @id @default(cuid())
  /// INVOICE_OVERDUE, INVOICE_DUE_SOON or SCHOOL_INACTIVE.
  event       String
  /// The condition's number of days.
  days        Int
  /// Limits the rule to one plan; null means every plan.
  plan        String?
  recipients  String[]          @default([])
  channels    String[]          @default([])
  templateId  String?
  /// The hour of the day, in the platform's time zone, from which it may send.
  sendHour    Int               @default(9)
  groupName   String
  enabled     Boolean           @default(false)
  createdById String
  createdAt   DateTime          @default(now())
  enabledAt   DateTime?
  lastFiredAt DateTime?
  fires       TriggerRuleFire[]

  @@index([enabled])
}

/// One firing of a rule at one invoice or school — also what stops it firing twice for the same thing.
model TriggerRuleFire {
  id       String      @id @default(cuid())
  ruleId   String
  rule     TriggerRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  entityId String
  schoolId String
  sent     Int         @default(0)
  summary  String
  firedAt  DateTime    @default(now())

  @@unique([ruleId, entityId])
  @@index([firedAt])
}

/// A person at a partner who signs in to the partner portal. Separate from school and platform accounts: it can only ever see the
/// schools the partner brought, never student, staff or guardian data, and never what a school pays.
model PartnerAccount {
  id              String    @id @default(cuid())
  partnerId       String
  partner         Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  email           String    @unique
  name            String
  isPrimary       Boolean   @default(true)
  passwordHash    String?
  /// Only the hash of the single-use link is kept; the link itself goes by email and is valid for 48 hours.
  inviteHash      String?
  inviteExpiresAt DateTime?
  invitedAt       DateTime?
  lastLoginAt     DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())

  @@index([partnerId])
}

/// A role made in the Back Office. It carries a grid of module levels; whoever holds it starts from that grid.
model InternalRole {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  /// The built-in role the platform's own checks see this person as.
  baseRole    String    @default("PLATFORM_ADMIN")
  grid        Json
  createdById String
  retiredAt   DateTime?
  createdAt   DateTime  @default(now())
}

/// Who answers for each outside service the platform depends on.
model IntegrationOwner {
  name      String   @id
  ownerId   String
  updatedAt DateTime @updatedAt
}

/// One run of the golden-dataset checks: fixed inputs with known answers, run through the real calculation code.
model RegressionRun {
  id       String   @id @default(cuid())
  ranAt    DateTime @default(now())
  passed   Int
  total    Int
  failures Json
  trigger  String   @default("MANUAL")
  ranById  String?

  @@index([ranAt])
}

/// A class running a particular version of a curriculum template — JSS 1 on the 2025 structure while SSS 3 stays on 2024.
model ClassTemplateAssignment {
  id           String   @id @default(cuid())
  schoolId     String
  classId      String   @unique
  templateId   String
  templateName String
  version      String
  assignedById String
  assignedAt   DateTime @default(now())

  @@index([schoolId])
  @@index([templateId])
}

/// A register taken for one period by the teacher who teaches it. Subordinate to the daily register: a child the daily register
/// has absent is already absent here, and a period register never overwrites the daily figure — it only adds what the period saw.
model PeriodRegister {
  id           String    @id @default(cuid())
  schoolId     String
  classId      String
  subjectId    String
  termId       String
  date         DateTime
  periodNumber Int
  /// DRAFT while the teacher is still working; SUBMITTED once written to the day.
  status       String    @default("SUBMITTED")
  /// Marks entered but not submitted: { studentId: { status, reason } }.
  draft        Json?
  markedById   String
  startedAt    DateTime  @default(now())
  submittedAt  DateTime?
  roll         Int       @default(0)
  /// Marked before the period ended.
  inPeriod     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([classId, date, periodNumber])
  @@index([schoolId, markedById, date])
  @@index([schoolId, termId, subjectId])
}

/// A worry about a child, raised by any member of staff. It goes to the school's safeguarding lead and to nobody else: it is never
/// on the child's record a teacher reads, and the lead's reading of it is on a separate audit stream.
model SafeguardingConcern {
  id           String    @id @default(cuid())
  schoolId     String
  studentId    String
  raisedById   String
  /// What was seen or said, in the words of the person who raised it.
  summary      String
  /// Whether anyone is in immediate danger.
  urgent       Boolean   @default(false)
  status       String    @default("OPEN")
  leadId       String?
  decisionNote String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status, createdAt])
  @@index([schoolId, studentId])
}

/// A day a staff member told the school they would not be in. What they hold is listed for cover until someone is named.
model StaffAbsence {
  id         String   @id @default(cuid())
  schoolId   String
  userId     String
  day        DateTime @db.Date
  reason     String
  reportedAt DateTime @default(now())
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([schoolId, day])
}

/// Someone holding a colleague's class for a stated period. An end date is mandatory: cover is time-boxed by rule, and it
/// stops granting access the day it ends without anyone remembering to take it away.
model CoverAssignment {
  id          String    @id @default(cuid())
  schoolId    String
  coverUserId String
  /// Who is being covered, when it is one named person.
  ownerUserId String?
  classId     String
  /// The subject covered; empty means the arm's daily register and its form class work.
  subjectId   String?
  /// REGISTER_AND_SCORES, or REGISTER only.
  scope       String    @default("REGISTER_AND_SCORES")
  startsOn    DateTime  @db.Date
  endsOn      DateTime  @db.Date
  reason      String?
  createdById String?
  endedAt     DateTime?
  createdAt   DateTime  @default(now())
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, coverUserId, endsOn])
  @@index([schoolId, classId])
}

/// A self-paced course: lessons with a question each, ending in a certificate the school recognises.
model TrainingCourse {
  id              String              @id @default(cuid())
  schoolId        String
  title           String
  summary         String?
  /// The catalogue section it sits under.
  section         String              @default("School courses")
  provider        String
  hours           Float
  format          String              @default("Self-paced")
  certificateName String
  /// Months a certificate stays valid; empty means it does not expire.
  validMonths     Int?
  /// A pathway level this course counts towards, e.g. "Foundation".
  pathway         String?
  /// What it costs, in kobo. Null is free — which is what a school's own courses are.
  priceKobo       Int?
  currency        String              @default("NGN")
  outcomes        String[]            @default([])
  task            String?
  /// Who it fits: persona slugs, or empty for everyone.
  personas        String[]            @default([])
  /// Subject words a teacher's own subjects are matched against.
  subjects        String[]            @default([])
  /// What it is about, in the words the work itself raises: "assessment", "reporting", "planning", "large classes", "inclusion". A course is
  /// recommended to a teacher when their own classes, results or deadlines raise one of its topics.
  topics          String[]            @default([])
  /// Personas who must finish it, and by when.
  requiredFor     String[]            @default([])
  requiredBy      DateTime?
  requiredNote    String?
  publishedAt     DateTime?
  archivedAt      DateTime?
  createdById     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  school          School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  lessons         TrainingLesson[]
  enrolments      TrainingEnrolment[]
  purchases       TrainingPurchase[]

  @@index([schoolId, archivedAt])
}

/// A paid course a member of staff has put in their basket, asked the school to fund, or paid for.
model TrainingPurchase {
  id          String         @id @default(cuid())
  schoolId    String
  userId      String
  courseId    String
  /// The price when it went in the basket, so a later change never moves a settled figure.
  priceKobo   Int
  currency    String         @default("NGN")
  /// SELF or SCHOOL — who is paying.
  payer       String         @default("SCHOOL")
  /// BASKET, REQUESTED (waiting on the school), APPROVED, DECLINED or PAID.
  state       String         @default("BASKET")
  /// Why it is wanted; the school reads this when it decides.
  reason      String?
  /// The school's answer, whichever way it went.
  decision    String?
  reference   String?
  addedAt     DateTime       @default(now())
  requestedAt DateTime?
  decidedAt   DateTime?
  decidedById String?
  school      School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  course      TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([schoolId, state])
}

model TrainingLesson {
  id           String         @id @default(cuid())
  courseId     String
  position     Int
  title        String
  minutes      Int            @default(10)
  body         String
  question     String
  options      String[]
  correctIndex Int
  explanation  String?
  course       TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, position])
}

model TrainingEnrolment {
  id               String         @id @default(cuid())
  schoolId         String
  courseId         String
  userId           String
  completedLessons Int[]          @default([])
  startedAt        DateTime       @default(now())
  completedAt      DateTime?
  school           School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  course           TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([schoolId, userId])
}

/// Earned on finishing a course, or brought from elsewhere and verified by the office. It stays the person's.
model TrainingCertificate {
  id           String    @id @default(cuid())
  schoolId     String
  userId       String
  courseId     String?
  name         String
  issuedBy     String
  issuedAt     DateTime
  expiresAt    DateTime?
  hours        Float     @default(0)
  /// Anyone can check a certificate against this.
  code         String    @unique
  /// VALID, PENDING (waiting for the office to verify) or REJECTED.
  state        String    @default("VALID")
  external     Boolean   @default(false)
  evidence     String?
  note         String?
  verifiedById String?
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, userId])
}

model TrainingSuggestion {
  id        String   @id @default(cuid())
  schoolId  String
  userId    String
  topic     String
  why       String?
  createdAt DateTime @default(now())
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
}

/// What an early-years teacher saw a child do — described in words against the school's own learning areas, never scored.
model ChildObservation {
  id           String   @id @default(cuid())
  schoolId     String
  studentId    String
  classId      String
  termId       String
  /// 1 or 2: the half-term it counts towards.
  halfTerm     Int
  /// { "Literacy": "Developing", ... } — only the areas seen this time.
  areas        Json
  note         String?
  /// Photographs the teacher attached, each shrunk in the browser and kept on the record as a data address — nothing depends on a file store.
  photos       String[] @default([])
  observedById String
  observedAt   DateTime @default(now())
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, classId, termId])
  @@index([studentId, termId])
}

/// What a child's teachers must do to help them learn. The strategies are shared with every teacher of the child; the background
/// behind them is held only by the people who write the plan and never travels with it.
model LearningSupportPlan {
  id               String    @id @default(cuid())
  schoolId         String
  studentId        String
  /// [{ area, strategy }] — "Seating", "Front of the room, away from the window".
  strategies       Json
  /// The reasons and any diagnosis. Never shown to a teacher.
  confidentialNote String?
  reviewedOn       DateTime  @db.Date
  nextReviewOn     DateTime  @db.Date
  /// ACTIVE, or ENDED when the child no longer needs one.
  status           String    @default("ACTIVE")
  authorId         String
  endedAt          DateTime?
  endedReason      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  school           School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, studentId, status])
  @@index([schoolId, nextReviewOn])
}

/// One subject's outline for one stage and term, from a published curriculum (NERDC, say) — loaded by the platform for every school, or by a
/// school for its own. A teacher fills a scheme of work from it; nothing is copied until they choose to.
model CurriculumCatalogueEntry {
  id           String   @id @default(cuid())
  /// Null for the platform's catalogue, offered to every school.
  schoolId     String?
  /// "platform" or the school's id — so one scope cannot hold two entries for the same subject, stage and term.
  scopeKey     String
  curriculum   String
  subject      String
  stage        String
  /// 1, 2 or 3.
  term         Int
  source       String?
  book         String?
  /// [{ week, topic, subtopics: string[], assessment }]
  topics       Json
  version      String   @default("1")
  importedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([scopeKey, curriculum, subject, stage, term])
  @@index([scopeKey])
  @@index([subject, stage])
}

/// The conversation on a lesson note: what the reviewer asked to be changed, and what the teacher said they changed.
model LessonNoteComment {
  id        String   @id @default(cuid())
  schoolId  String
  planId    String
  authorId  String
  /// RETURN (a reviewer sent it back), REPLY (the teacher answered on resubmitting), SIGN (signed), NOTE (a remark).
  kind      String
  section   String?
  body      String
  createdAt DateTime @default(now())
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, planId, createdAt])
}

/// What a subject teacher says about one child in one subject for the term. It prints on the report card beside the subject's line,
/// under the form master's remark. One per child, subject and term; the author is whoever wrote it last.
model SubjectComment {
  id        String   @id @default(cuid())
  schoolId  String
  termId    String
  classId   String
  subjectId String
  studentId String
  authorId  String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([termId, subjectId, studentId])
  @@index([schoolId, termId, classId, subjectId])
}

/// A ready-made assessment framework a school may pick at setup: named components, each with a maximum raw score and a weight that together total 100.
model AssessmentFrameworkTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  /// [{ code, name, max, weight }]
  components  Json
  typicalUser String?
  isCustom    Boolean  @default(false)
  isActive    Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// One run of the portability tests against a master — what was checked, what each test found, and who ran it.
model PortabilityRun {
  id         String   @id @default(cuid())
  kind       String
  targetId   String
  targetName String
  /// [{ test, state: PASS | PARTIAL | FAIL, note }]
  results    Json
  passed     Boolean
  ranById    String?
  ranAt      DateTime @default(now())

  @@index([kind, targetId])
}
