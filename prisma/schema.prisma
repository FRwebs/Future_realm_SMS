  dueAt        DateTime
  paidAt       DateTime?
  metadata     Json?
  school       School                       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  transactions PlatformBillingTransaction[]

  @@index([schoolId, status, dueAt])
}

model PlatformDiscount {
  id        String    @id @default(cuid())
  schoolId  String
  type      String
  value     Decimal   @db.Decimal(12, 2)
  reason    String
  appliedBy String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, expiresAt])
}

model PromoCode {
  id        String    @id @default(cuid())
  code      String    @unique
  type      String
  value     Decimal   @db.Decimal(12, 2)
  maxUses   Int?
  uses      Int       @default(0)
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model PlatformRefund {
  id          String    @id @default(cuid())
  schoolId    String
  amount      Decimal   @db.Decimal(12, 2)
  reason      String
  status      String    @default("PENDING")
  requestedBy String?
  approvedBy  String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([schoolId, status])
}

model TaxRate {
  id        String   @id @default(cuid())
  country   String
  region    String?
  rate      Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([country, region])
}

model SupportTicket {
  id           String                 @id @default(cuid())
  schoolId     String
  userId       String?
  createdById  String?
  assignedToId String?
  ticketNo     String                 @unique
  category     PlatformTicketCategory
  subject      String
  description  String
  priority     PlatformTicketPriority @default(MEDIUM)
  status       PlatformTicketStatus   @default(OPEN)
  slaDueAt     DateTime?
  resolvedAt   DateTime?
  closedAt     DateTime?
  attachments  Json?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  school       School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy    User?                  @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo   User?                  @relation("TicketAssignedAgent", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages     TicketMessage[]

  @@index([schoolId, status, priority])
  @@index([assignedToId, status])
}

model TicketMessage {
  id           String        @id @default(cuid())
  ticketId     String
  authorId     String?
  body         String
  internalOnly Boolean       @default(false)
  attachments  Json?
  createdAt    DateTime      @default(now())
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author       User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

model PlatformFeatureFlag {
  id               String                        @id @default(cuid())
  key              String                        @unique
  name             String
  description      String?
  enabledGlobally  Boolean                       @default(false)
  rolloutPercent   Int                           @default(0)
  planRestrictions Json?
  createdById      String?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt
  createdBy        User?                         @relation("FeatureFlagCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  overrides        PlatformFeatureFlagOverride[]

  @@index([enabledGlobally])
}

model PlatformFeatureFlagOverride {
  id        String              @id @default(cuid())
  flagId    String
  schoolId  String
  enabled   Boolean
  setById   String?
  createdAt DateTime            @default(now())
  flag      PlatformFeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)
  school    School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([flagId, schoolId])
  @@index([schoolId])
}

model PlatformAnnouncement {
  id          String                     @id @default(cuid())
  authorId    String?
  title       String
  body        String
  type        PlatformAnnouncementType   @default(INFO)
  target      Json
  scheduledAt DateTime?
  publishedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  author      User?                      @relation("PlatformAnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  views       PlatformAnnouncementView[]

  @@index([type, publishedAt, expiresAt])
}

model PlatformAnnouncementView {
  id             String               @id @default(cuid())
  announcementId String
  schoolId       String
  viewedAt       DateTime?
  dismissedAt    DateTime?
  announcement   PlatformAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  school         School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([announcementId, schoolId])
}

model CrmInteraction {
  id          String    @id @default(cuid())
  schoolId    String
  createdById String?
  type        String
  summary     String
  outcome     String?
  nextAction  String?
  followUpAt  DateTime?
  createdAt   DateTime  @default(now())
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy   User?     @relation("CrmInteractionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
}

model CrmNote {
  id          String   @id @default(cuid())
  schoolId    String
  createdById String?
  note        String
  tags        Json?
  createdAt   DateTime @default(now())
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation("CrmNoteCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
}

model Lead {
  id           String       @id @default(cuid())
  assignedToId String?
  prospectName String
  contactName  String
  email        String
  phone        String?
  source       String?
  stage        CrmLeadStage @default(LEAD)
  estimatedMrr Decimal      @default(0) @db.Decimal(12, 2)
  notes        String?
  wonReason    String?
  lostReason   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  assignedTo   User?        @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([stage, assignedToId])
}

model NpsResponse {
  id        String   @id @default(cuid())
  schoolId  String
  score     Int
  comment   String?
  role      String?
  createdAt DateTime @default(now())
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
}

model OnboardingChecklistItem {
  id          String    @id @default(cuid())
  schoolId    String
  key         String
  label       String
  completedAt DateTime?
  metadata    Json?
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, key])
}

model SchoolGroup {
  id          String   @id @default(cuid())
  name        String
  ownerName   String?
  ownerEmail  String?
  billingMode String   @default("GROUP")
  createdAt   DateTime @default(now())
  schools     School[]
}

model DataPrivacyRequest {
  id          String                   @id @default(cuid())
  schoolId    String?
  userId      String?
  handledById String?
  type        DataPrivacyRequestType
  status      DataPrivacyRequestStatus @default(OPEN)
  subject     String
  details     String?
  resolvedAt  DateTime?
  createdAt   DateTime                 @default(now())
  school      School?                  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  handledBy   User?                    @relation("PrivacyRequestHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, type, createdAt])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  subject   String
  body      String
  variables Json?
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model MaintenanceWindow {
  id          String   @id @default(cuid())
  createdById String?
  title       String
  message     String
  startsAt    DateTime
  endsAt      DateTime
  isActive    Boolean  @default(false)
  whitelist   Json?
  createdAt   DateTime @default(now())
  createdBy   User?    @relation("MaintenanceWindowCreator", fields: [createdById], references: [id], onDelete: SetNull)
}

model PlatformSession {
  id             String    @id @default(cuid())
  userId         String
  schoolId       String?
  tokenHash      String
  ipAddress      String?
  device         String?
  lastActivityAt DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  school         School?   @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt, expiresAt])
  @@index([schoolId, lastActivityAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  userId    String?
  schoolId  String?
  email     String
  success   Boolean
  reason    String?
  ipAddress String?
  device    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  school    School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([success, createdAt])
}

model IpAccessRule {
  id        String   @id @default(cuid())
  ipAddress String
  type      String
  reason    String?
  createdAt DateTime @default(now())

  @@unique([ipAddress, type])
}

model BackupRecord {
  id        String    @id @default(cuid())
  schoolId  String?
  scope     String
  status    String
  sizeMb    Float?
  location  String?
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  school    School?   @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([schoolId, startedAt])
}

model KnowledgeBaseArticle {
  id          String    @id @default(cuid())
  authorId    String?
  title       String
  slug        String    @unique
  category    String
  roleTarget  String?
  body        String
  videoUrl    String?
  status      String    @default("DRAFT")
  views       Int       @default(0)
  helpfulYes  Int       @default(0)
  helpfulNo   Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  author      User?     @relation("KnowledgeBaseAuthor", fields: [authorId], references: [id], onDelete: SetNull)
}

model ApiKey {
  id        String    @id @default(cuid())
  schoolId  String?
  name      String
  keyHash   String
  scope     Json
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([schoolId, revokedAt])
}

model ApiUsageLog {
  id         String   @id @default(cuid())
  schoolId   String?
  endpoint   String
  method     String
  status     Int
  durationMs Int?
  createdAt  DateTime @default(now())
  school     School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
}

model WebhookEndpoint {
  id        String   @id @default(cuid())
  schoolId  String?
  url       String
  events    Json
  secret    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model WebhookDeliveryLog {
  id          String    @id @default(cuid())
  endpointId  String
  event       String
  status      String
  attempts    Int       @default(0)
  response    String?
  nextRetryAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([endpointId, status])
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String
  source    String
  message   String
  schoolId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([level, createdAt])
  @@index([schoolId, createdAt])
}

model AuditLog {
  id         String      @id @default(cuid())
  schoolId   String?
  actorId    String?
  action     AuditAction
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  metadata   Json?
  createdAt  DateTime    @default(now())
  school     School?     @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([schoolId, action, createdAt])
  @@index([actorId, createdAt])
}

model PlatformSetting {
  id                       String   @id @default(cuid())
  maintenanceMode          Boolean  @default(false)
  platformAnnouncement     String?
  defaultGradingScale      Json
  globalModuleAvailability Json
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model SyncDraft {
  id        String        @id @default(cuid())
  schoolId  String
  userId    String
  type      SyncDraftType
  payload   Json
  syncedAt  DateTime?
  createdAt DateTime      @default(now())
  school    School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IntegrationConfig {
  id       String              @id @default(cuid())
  schoolId String
  provider IntegrationProvider
  settings Json
  enabled  Boolean             @default(false)
  school   School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, provider])
}
