  endsAt      DateTime
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus      Campus?  @relation(fields: [campusId], references: [id], onDelete: SetNull)
}

model Assignment {
  id            String                 @id @default(cuid())
  schoolId      String
  classId       String
  subjectId     String
  teacherId     String
  title         String
  description   String?
  dueAt         DateTime
  attachmentUrl String?
  status        AssignmentStatus       @default(PUBLISHED)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  school        School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classRoom     ClassRoom              @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject       Subject                @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher       User                   @relation("AssignmentCreatedBy", fields: [teacherId], references: [id], onDelete: Cascade)
  submissions   AssignmentSubmission[]

  @@index([schoolId, teacherId, dueAt])
  @@index([schoolId, classId, subjectId])
}

model AssignmentSubmission {
  id           String     @id @default(cuid())
  schoolId     String
  assignmentId String
  studentId    String
  submittedAt  DateTime?
  fileUrl      String?
  comment      String?
  score        Float?
  feedback     String?
  gradedAt     DateTime?
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([schoolId, studentId])
}

model TrainingProgram {
  id                String                @id @default(cuid())
  schoolId          String
  createdById       String?
  title             String
  description       String?
  category          TrainingCategory
  trainingType      TrainingType
  startsAt          DateTime
  endsAt            DateTime?
  durationHours     Float?
  facilitator       String?
  provider          String?
  location          String?
  meetingLink       String?
  targetRoles       Json?
  targetDepartments Json?
  mandatory         Boolean               @default(false)
  archivedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  school            School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy         User?                 @relation("TrainingProgramCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  participants      TrainingParticipant[]

  @@index([schoolId, startsAt, mandatory])
}

model TrainingParticipant {
  id                String                    @id @default(cuid())
  schoolId          String
  trainingProgramId String
  staffId           String?
  userId            String
  status            TrainingParticipantStatus @default(INVITED)
  attendedAt        DateTime?
  completedAt       DateTime?
  certificateUrl    String?
  cpdPoints         Float                     @default(0)
  notes             String?
  feedback          String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  school            School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  trainingProgram   TrainingProgram           @relation(fields: [trainingProgramId], references: [id], onDelete: Cascade)
  staff             StaffProfile?             @relation(fields: [staffId], references: [id], onDelete: SetNull)
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([trainingProgramId, userId])
  @@index([schoolId, userId, status])
}

model FeeStructure {
  id                String             @id @default(cuid())
  schoolId          String
  academicSessionId String?
  termId            String?
  classId           String?
  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession   AcademicSession?   @relation(fields: [academicSessionId], references: [id], onDelete: SetNull)
  term              Term?              @relation(fields: [termId], references: [id], onDelete: SetNull)
  classRoom         ClassRoom?         @relation(fields: [classId], references: [id], onDelete: SetNull)
  name              String
  currency          String             @default("NGN")
  studentCategory   String?
  recurrence        FeeRecurrence      @default(TERM)
  isOneTime         Boolean            @default(false)
  dueDate           DateTime?
  visibilityRules   Json?
  isActive          Boolean            @default(true)
  items             FeeStructureItem[]
  invoices          Invoice[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([schoolId, academicSessionId, termId, classId, isActive])
}

model FeeStructureItem {
  id             String           @id @default(cuid())
  feeStructureId String
  feeStructure   FeeStructure     @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  label          String
  componentType  FeeComponentType @default(OTHER)
  amount         Decimal          @db.Decimal(12, 2)
  isOptional     Boolean          @default(false)
  isActive       Boolean          @default(true)
  dueDate        DateTime?
}

model Invoice {
  id               String              @id @default(cuid())
  schoolId         String
  studentId        String
  feeStructureId   String?
  createdById      String?
  invoiceNumber    String
  issuedOn         DateTime
  dueOn            DateTime
  subtotal         Decimal             @db.Decimal(12, 2)
  discount         Decimal             @db.Decimal(12, 2)
  fine             Decimal             @db.Decimal(12, 2)
  total            Decimal             @db.Decimal(12, 2)
  balance          Decimal             @db.Decimal(12, 2)
  status           InvoiceStatus
  school           School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student          Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure     FeeStructure?       @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
  createdBy        User?               @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items            InvoiceItem[]
  payments         Payment[]
  allocations      PaymentAllocation[]
  receipts         Receipt[]
  adjustments      InvoiceAdjustment[]
  installmentPlans InstallmentPlan[]

  @@unique([schoolId, invoiceNumber])
  @@index([schoolId, studentId, status])
  @@index([schoolId, dueOn])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  amount      Decimal @db.Decimal(12, 2)
  quantity    Int     @default(1)
}

model Payment {
  id                    String              @id @default(cuid())
  schoolId              String
  studentId             String
  invoiceId             String?
  recordedById          String?
  reference             String
  provider              String?
  providerTransactionId String?
  amount                Decimal             @db.Decimal(12, 2)
  currency              String              @default("NGN")
  status                PaymentStatus
  method                PaymentMethod
  paidAt                DateTime?
  metadata              Json?
  school                School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student               Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  invoice               Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  recordedBy            User?               @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  verifiedAt            DateTime?
  reversedAt            DateTime?
  reversalReason        String?
  allocations           PaymentAllocation[]
  receipts              Receipt[]

  @@unique([schoolId, reference])
  @@index([schoolId, studentId, status])
  @@index([schoolId, paidAt])
}

model PaymentAllocation {
  id        String   @id @default(cuid())
  schoolId  String
  paymentId String
  invoiceId String
  amount    Decimal  @db.Decimal(12, 2)
  metadata  Json?
  createdAt DateTime @default(now())
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([schoolId, invoiceId])
  @@index([schoolId, paymentId])
}

model Receipt {
  id            String        @id @default(cuid())
  schoolId      String
  invoiceId     String
  paymentId     String?
  issuedById    String?
  receiptNumber String
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("NGN")
  status        ReceiptStatus @default(ISSUED)
  issuedAt      DateTime      @default(now())
  metadata      Json?
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payment       Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([schoolId, receiptNumber])
  @@index([schoolId, invoiceId])
}

model InvoiceAdjustment {
  id           String                @id @default(cuid())
  schoolId     String
  invoiceId    String
  appliedById  String?
  approvedById String?
  type         InvoiceAdjustmentType
  valueType    AdjustmentValueType   @default(FIXED)
  value        Decimal               @db.Decimal(12, 2)
  amount       Decimal               @db.Decimal(12, 2)
  reason       String
  createdAt    DateTime              @default(now())
  metadata     Json?
  invoice      Invoice               @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([schoolId, invoiceId, type])
}

model InstallmentPlan {
  id          String                @id @default(cuid())
  schoolId    String
  studentId   String
  invoiceId   String?
  createdById String?
  planNumber  String
  totalAmount Decimal               @db.Decimal(12, 2)
  balance     Decimal               @db.Decimal(12, 2)
  status      InstallmentStatus     @default(PENDING)
  notes       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  student     Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  invoice     Invoice?              @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  items       InstallmentPlanItem[]

  @@unique([schoolId, planNumber])
  @@index([schoolId, studentId, status])
}

model InstallmentPlanItem {
  id         String            @id @default(cuid())
  planId     String
  dueOn      DateTime
  amount     Decimal           @db.Decimal(12, 2)
  paidAmount Decimal           @default(0) @db.Decimal(12, 2)
  status     InstallmentStatus @default(PENDING)
  plan       InstallmentPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, dueOn])
}

model FinancialClearance {
  id                     String                   @id @default(cuid())
  schoolId               String
  studentId              String?
  admissionApplicationId String?
  invoiceId              String?
  clearedById            String?
  status                 FinancialClearanceStatus @default(PENDING)
  reason                 String?
  clearedAt              DateTime?
  createdAt              DateTime                 @default(now())
  metadata               Json?
  student                Student?                 @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([schoolId, studentId, status])
  @@index([schoolId, admissionApplicationId])
}

model Expense {
  id          String   @id @default(cuid())
  schoolId    String
  title       String
  category    String
  amount      Decimal  @db.Decimal(12, 2)
  expenseDate DateTime
  notes       String?
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model Announcement {
  id          String              @id @default(cuid())
  schoolId    String
  createdById String?
  title       String
  body        String
  audience    String
  channel     NotificationChannel @default(IN_APP)
  publishedAt DateTime            @default(now())
  expiresAt   DateTime?
  school      School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy   User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
}

model InternalMessage {
  id          String    @id @default(cuid())
  schoolId    String
  senderId    String
  recipientId String
  subject     String
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sender      User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User      @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
}

model NotificationLog {
  id       String              @id @default(cuid())
  schoolId String
  userId   String?
  channel  NotificationChannel
  title    String
  body     String
  status   String
  metadata Json?
  sentAt   DateTime?
  school   School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model TransportRoute {
  id           String                @id @default(cuid())
  schoolId     String
  name         String
  code         String
  driverName   String
  driverPhone  String
  vehicleRegNo String
  capacity     Int
  school       School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments  TransportAssignment[]

  @@unique([schoolId, code])
}

model TransportAssignment {
  id        String         @id @default(cuid())
  schoolId  String
  routeId   String
  studentId String
  stopName  String
  amount    Decimal        @db.Decimal(12, 2)
  school    School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  route     TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  student   Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model HostelBuilding {
  id       String       @id @default(cuid())
  schoolId String
  name     String
  gender   Gender
  school   School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  rooms    HostelRoom[]
}

model HostelRoom {
  id               String             @id @default(cuid())
  schoolId         String
  hostelBuildingId String
  name             String
  capacity         Int
  school           School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  building         HostelBuilding     @relation(fields: [hostelBuildingId], references: [id], onDelete: Cascade)
  allocations      HostelAllocation[]
}

model HostelAllocation {
  id                String          @id @default(cuid())
  schoolId          String
  roomId            String
  studentId         String
  academicSessionId String
  startDate         DateTime
  endDate           DateTime?
  school            School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  room              HostelRoom      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  student           Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
}

model LibraryBook {
  id              String        @id @default(cuid())
  schoolId        String
  isbn            String?
  title           String
  author          String
  copiesTotal     Int
  copiesAvailable Int
  shelfCode       String?
  school          School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  loans           LibraryLoan[]
}

model LibraryLoan {
  id         String        @id @default(cuid())
  schoolId   String
  bookId     String
  studentId  String?
  staffId    String?
  borrowedAt DateTime
  dueAt      DateTime
  returnedAt DateTime?
  fineAmount Decimal       @default(0) @db.Decimal(12, 2)
  school     School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  book       LibraryBook   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  student    Student?      @relation(fields: [studentId], references: [id], onDelete: SetNull)
  staff      StaffProfile? @relation(fields: [staffId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id         String      @id @default(cuid())
  schoolId   String
  actorId    String?
  action     AuditAction
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime    @default(now())
  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
}

model SyncDraft {
  id        String        @id @default(cuid())
  schoolId  String
  userId    String
  type      SyncDraftType
  payload   Json
  syncedAt  DateTime?
  createdAt DateTime      @default(now())
  school    School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IntegrationConfig {
  id       String              @id @default(cuid())
  schoolId String
  provider IntegrationProvider
  settings Json
  enabled  Boolean             @default(false)
  school   School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, provider])
}
