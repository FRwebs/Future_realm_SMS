model Term {
  id                            String                         @id @default(cuid())
  schoolId                      String
  academicSessionId             String
  school                        School                         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession               AcademicSession                @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  name                          String
  order                         Int
  startDate                     DateTime
  endDate                       DateTime
  isCurrent                     Boolean                        @default(false)
  /// The mid-term break, when the school takes one — taken out of the school days.
  breakStart                    DateTime?
  breakEnd                      DateTime?
  /// Make this the active term the day it opens, without anyone switching to it.
  activateOnOpen                Boolean                        @default(false)
  /// Which weekdays the school sits, as "MON" … "SUN". Counts the term's school days.
  schoolDays                    String[]                       @default(["MON", "TUE", "WED", "THU", "FRI"])
  assessmentWindows             AssessmentWindow[]
  timetableVersions             TimetableVersion[]
  resultSheets                  ResultSheet[]
  attendance                    StudentAttendance[]
  feeStructures                 FeeStructure[]
  assessments                   AssessmentComponent[]
  timetableEntries              TimetableEntry[]
  timetablePublishLogs          TimetablePublishLog[]
  exams                         ExamTimetableEntry[]
  resultPublications            ResultPublication[]
  curriculumTopics              CurriculumTopic[]
  schemeOfWork                  SchemeOfWork[]
  AdmissionApplication          AdmissionApplication[]
  AdmissionConfig               AdmissionConfig[]
  academicAssessments           AcademicAssessment[]
  sectionAssessmentComponents   SectionAssessmentComponent[]
  broadsheets                   Broadsheet[]
  reportCards                   ReportCard[]
  seniorSecondaryResultArchives SeniorSecondaryResultArchive[]
  lessonPlans                   LessonPlan[]
  resultEntryWindows            ResultEntryWindow[]
  classAcademicAssignments      ClassAcademicAssignment[]
  studentSkills                 StudentSkill[]
  feeItems                      FeeItem[]
  invoices                      Invoice[]
  feeAssignments                FeeAssignment[]
  staffAppraisals               StaffAppraisal[]

  @@unique([academicSessionId, order])
}

model Department {
  id                 String              @id @default(cuid())
  schoolId           String
  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name               String
  code               String
  subjects           Subject[]
  classRooms         ClassRoom[]
  staff              StaffProfile[]
  lessonPlans        LessonPlan[]
  questionBankItems  QuestionBankItem[]
  resultEntryWindows ResultEntryWindow[]

  @@unique([schoolId, code])
}

model SubjectCategory {
  id          String    @id @default(cuid())
  schoolId    String?
  name        String
  description String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  school      School?   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjects    Subject[]

  @@unique([schoolId, name])
  @@index([schoolId, sortOrder])
}

model ClassLevel {
  id               String              @id @default(cuid())
  schoolId         String
  school           School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name             String
  section          SchoolCategory
  schoolSection    SchoolSection?
  order            Int
  isActive         Boolean             @default(true)
  /// Whether the guardian portal lists this class.
  visibleToParents Boolean             @default(true)
  classRooms       ClassRoom[]
  feeLevels        FeeStructureLevel[]

  @@unique([schoolId, name])
}

model ClassRoom {
  id                            String                         @id @default(cuid())
  schoolId                      String
  campusId                      String?
  classLevelId                  String
  departmentId                  String?
  shortName                     String?
  section                       String?
  category                      String?
  /// Science, Commercial, Arts or Technical — null for a class that is not streamed.
  stream                        String?
  assistantClassTeacherId       String?
  room                          String?
  isActive                      Boolean                        @default(true)
  displayOrder                  Int                            @default(0)
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @default(now()) @updatedAt
  deletedAt                     DateTime?
  school                        School                         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus                        Campus?                        @relation(fields: [campusId], references: [id], onDelete: SetNull)
  classLevel                    ClassLevel                     @relation(fields: [classLevelId], references: [id], onDelete: Restrict)
  department                    Department?                    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  name                          String
  arm                           String
  capacity                      Int                            @default(40)
  students                      Student[]
  admissions                    AdmissionApplication[]
  classSubjects                 ClassSubject[]
  resultSheets                  ResultSheet[]
  attendance                    StudentAttendance[]
  timetable                     TimetableEntry[]
  exams                         ExamTimetableEntry[]
  assignments                   Assignment[]
  curriculumTopics              CurriculumTopic[]
  resultPublications            ResultPublication[]
  feeStructures                 FeeStructure[]
  feeItems                      FeeItem[]
  invoices                      Invoice[]
  openAdmissions                AdmissionConfig[]              @relation("AdmissionConfigOpenClasses")
  classTeacherId                String?
  academicAssessments           AcademicAssessment[]
  broadsheets                   Broadsheet[]
  reportCards                   ReportCard[]
  seniorSecondaryResultArchives SeniorSecondaryResultArchive[]
  disciplineRecords             DisciplineRecord[]
  learningMaterials             LearningMaterial[]
  lessonPlans                   LessonPlan[]
  questionBankItems             QuestionBankItem[]
  externalExams                 ExternalExam[]
  resultEntryWindows            ResultEntryWindow[]
  SubjectCombination            SubjectCombination[]
  classTeacher                  User?                          @relation("ClassRoomClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  assistantClassTeacher         User?                          @relation("ClassRoomAssistantTeacher", fields: [assistantClassTeacherId], references: [id], onDelete: SetNull)
  academicAssignments           ClassAcademicAssignment[]
  studentSkills                 StudentSkill[]
  timetablePublishLogs          TimetablePublishLog[]
  schemeOfWork                  SchemeOfWork[]

  @@unique([schoolId, name, arm])
  @@index([schoolId, isActive, deletedAt])
  @@index([schoolId, category])
  @@index([schoolId, classTeacherId])
  @@index([schoolId, displayOrder])
}

model ClassAcademicAssignment {
  id                      String          @id @default(cuid())
  schoolId                String
  classId                 String
  academicSessionId       String
  termId                  String?
  classTeacherId          String?
  assistantClassTeacherId String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  school                  School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classRoom               ClassRoom       @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicSession         AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  term                    Term?           @relation(fields: [termId], references: [id], onDelete: Cascade)
  classTeacher            User?           @relation("ClassAcademicAssignmentTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  assistantClassTeacher   User?           @relation("ClassAcademicAssignmentAssistant", fields: [assistantClassTeacherId], references: [id], onDelete: SetNull)

  @@unique([classId, academicSessionId, termId])
  @@index([schoolId, academicSessionId, termId])
  @@index([schoolId, classTeacherId])
}

model ConfigurationItem {
  id           String    @id @default(cuid())
  schoolId     String
  resource     String
  name         String
  code         String?
  description  String?
  data         Json?
  status       String    @default("ACTIVE")
  isDefault    Boolean   @default(false)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  deletedAt    DateTime?
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, resource, name])
  @@unique([schoolId, resource, code])
  @@index([schoolId, resource, status])
  @@index([schoolId, resource, displayOrder])
}

model SkillDefinition {
  id            String         @id @default(cuid())
  schoolId      String
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name          String
  category      String
  displayOrder  Int            @default(0)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  studentSkills StudentSkill[]

  @@unique([schoolId, category, name])
  @@index([schoolId, category, displayOrder])
}

model StudentSkill {
  id           String          @id @default(cuid())
  schoolId     String
  studentId    String
  classId      String
  termId       String
  skillId      String
  rating       Int
  remark       String?
  assessedById String?
  assessedAt   DateTime        @default(now())
  school       School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classRoom    ClassRoom       @relation(fields: [classId], references: [id], onDelete: Cascade)
  term         Term            @relation(fields: [termId], references: [id], onDelete: Cascade)
  skill        SkillDefinition @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([studentId, termId, skillId])
  @@index([schoolId, classId, termId])
}

