/// One named timetable the school has built — the one running, drafts it is working
/// on, and the ones it has retired. The live week families see is `TimetableEntry`;
/// a version is what that week was, or will be, before and after it is published.
model TimetableVersion {
  id              String    @id @default(cuid())
  schoolId        String
  termId          String?
  name            String
  /// DRAFT, RUNNING or ARCHIVED. At most one per term is running.
  state           String    @default("DRAFT")
  note            String?
  periodsPerDay   Int       @default(8)
  periodMinutes   Int       @default(40)
  firstStarts     String    @default("08:00")
  /// The period the break follows; null when the day has no break.
  breakAfter      Int?
  schoolDays      String[]  @default(["MON", "TUE", "WED", "THU", "FRI"])
  appliesTo       String    @default("Every arm")
  checkClashes    Boolean   @default(true)
  /// When set, the timetable publishes itself on this day, with the options chosen at the time.
  scheduledFor    DateTime?
  scheduledById   String?
  scheduleOptions Json?
  /// { [classId]: { "<day 1-6>|<period>": { subjectId, teacherId, venue } } }
  grid            Json      @default("{}")
  builtById       String?
  publishedAt     DateTime?
  publishedById   String?
  /// What publishing it did: periods moved, rooms reassigned, staff told.
  publishSummary  Json?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  term            Term?     @relation(fields: [termId], references: [id], onDelete: SetNull)

  @@index([schoolId, termId, state])
}

