  @@index([schoolId, startedAt])
}

model KnowledgeBaseArticle {
  id          String    @id @default(cuid())
  authorId    String?
  title       String
  slug        String    @unique
  category    String
  roleTarget  String?
  body        String
  videoUrl    String?
  status      String    @default("DRAFT")
  views       Int       @default(0)
  helpfulYes  Int       @default(0)
  helpfulNo   Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  author      User?     @relation("KnowledgeBaseAuthor", fields: [authorId], references: [id], onDelete: SetNull)
}

model ApiKey {
  id        String    @id @default(cuid())
  schoolId  String?
  name      String
  keyHash   String
  scope     Json
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([schoolId, revokedAt])
}

model ApiUsageLog {
  id         String   @id @default(cuid())
  schoolId   String?
  endpoint   String
  method     String
  status     Int
  durationMs Int?
  createdAt  DateTime @default(now())
  school     School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
}

model WebhookEndpoint {
  id        String   @id @default(cuid())
  schoolId  String?
  url       String
  events    Json
  secret    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model WebhookDeliveryLog {
  id          String    @id @default(cuid())
  endpointId  String
  event       String
  status      String
  attempts    Int       @default(0)
  response    String?
  nextRetryAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([endpointId, status])
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String
  source    String
  message   String
  schoolId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([level, createdAt])
  @@index([schoolId, createdAt])
}

model AuditLog {
  id         String      @id @default(cuid())
  schoolId   String?
  actorId    String?
  action     AuditAction
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  metadata   Json?
  createdAt  DateTime    @default(now())
  school     School?     @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([schoolId, action, createdAt])
  @@index([actorId, createdAt])
}

model PlatformSetting {
  id                       String   @id @default(cuid())
  maintenanceMode          Boolean  @default(false)
  platformAnnouncement     String?
  defaultGradingScale      Json
  globalModuleAvailability Json
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

/// Something captured on a device with no connection, and what happened when it reached the school's record.
/// state: PENDING (arrived, not yet applied), APPLIED, CONFLICT (the record had changed — both versions kept until a leader chooses),
/// REJECTED (the record refused it, with the reason), RESOLVED (a conflict somebody chose), DISCARDED.
model SyncDraft {
  id           String        @id @default(cuid())
  schoolId     String
  userId       String
  type         SyncDraftType
  payload      Json
  syncedAt     DateTime?
  createdAt    DateTime      @default(now())
  clientId     String?
  state        String        @default("PENDING")
  capturedAt   DateTime?
  deviceLabel  String?
  message      String?
  conflict     Json?
  resolution   String?
  resolvedById String?
  resolvedAt   DateTime?
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, state])
  @@unique([userId, clientId])
}

model IntegrationConfig {
  id       String              @id @default(cuid())
  schoolId String
  provider IntegrationProvider
  settings Json
  enabled  Boolean             @default(false)
  school   School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, provider])
}

/// Where a staff appraisal is in its life.
///
/// The three states exist because an appraisal nobody has shown the person is
/// a secret file about them. DRAFT is the reviewer's working copy; SHARED
/// means the appraisee can read it; ACKNOWLEDGED means they have said so and
/// had the chance to respond in writing.
enum StaffAppraisalStatus {
  DRAFT
  SHARED
  ACKNOWLEDGED
}

/// One appraisal of one staff member, for one cycle.
model StaffAppraisal {
  id              String                 @id @default(cuid())
  schoolId        String
  staffId         String
  /// The person carrying out the review — a head of department or the principal.
  reviewerId      String
  termId          String?
  /// What this round is called in the school's own words, e.g. "Second Term 2025/2026".
  cycle           String
  status          StaffAppraisalStatus   @default(DRAFT)
  /// Mean of the criterion scores, stored so a list does not have to recompute it.
  overallScore    Float?
  strengths       String?
  improvements    String?
  reviewerComment String?
  /// The appraisee's own words. Only they can write here.
  staffComment    String?
  sharedAt        DateTime?
  acknowledgedAt  DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  school          School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff           StaffProfile           @relation("StaffAppraisalSubject", fields: [staffId], references: [id], onDelete: Cascade)
  reviewer        User                   @relation("StaffAppraisalReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  term            Term?                  @relation(fields: [termId], references: [id], onDelete: SetNull)
  ratings         StaffAppraisalRating[]

  @@unique([staffId, cycle])
  @@index([schoolId, status, createdAt])
  @@index([schoolId, reviewerId, status])
}

/// A score against one named criterion, out of five.
model StaffAppraisalRating {
  id          String         @id @default(cuid())
  appraisalId String
  criterion   String
  score       Int
  comment     String?
  /// What the staff member rated themselves, and the figure the product itself holds for it.
  selfScore   Int?
  autoScore   Float?
  weight      Int?
  evidence    String?
  appraisal   StaffAppraisal @relation(fields: [appraisalId], references: [id], onDelete: Cascade)

  @@unique([appraisalId, criterion])
}

/// What makes an automation fire.
enum AutomationTrigger {
  FEE_DUE_SOON
  FEE_OVERDUE
  CONSECUTIVE_ABSENCE
  RESULT_PUBLISHED
  TERM_STARTING
  BIRTHDAY
  /// The four a school cannot switch off, and the rest the mockup names.
  RESULT_REVISED
  PAYMENT_REVERSAL
  EMERGENCY_BROADCAST
  APPROVAL_DECISION
  ABSENCE_RECORDED
  INVOICE_PUBLISHED
}

/// A standing rule that sends something without anybody pressing a button.
///
/// Stored rather than hard-coded because the point of the page is that a
/// school can see — and switch off — every message the product sends on its
/// behalf. `lastRunAt` and `sendCount` are what make that auditable: a rule
/// nobody can see firing is indistinguishable from one that is broken.
model AutomationRule {
  id           String            @id @default(cuid())
  schoolId     String
  name         String
  trigger      AutomationTrigger
  /// Trigger-specific threshold, e.g. days before due, or absences in a row.
  threshold    Int?
  channel      String            @default("SMS")
  audience     String            @default("Guardians")
  template     String
  /// When it fires, in the words the rules table shows — "Immediately", "16:00 daily", "Day 14".
  timing       String?
  /// A mandatory rule cannot be switched off by the school. Four of them exist
  /// because a parent must be told: a result published or revised, money leaving
  /// a ledger, an emergency. Each carries its one-sentence reason.
  isMandatory  Boolean           @default(false)
  lockedReason String?
  isActive     Boolean           @default(true)
  lastRunAt    DateTime?
  sendCount    Int               @default(0)
  createdById  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  school       School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, isActive])
}

/// A report somebody actually generated.
///
/// /v1/reports streams a PDF and keeps no record of it, so the product could
/// not answer "who exported the whole student roll last term". This records
/// that: what was produced, by whom, over what period, and how large.
model GeneratedReport {
  id            String   @id @default(cuid())
  schoolId      String
  kind          String
  title         String
  format        String   @default("PDF")
  /// What the report covered, in the school's own terms.
  scope         String?
  rowCount      Int?
  sizeBytes     Int?
  generatedById String?
  generatedAt   DateTime @default(now())
  /// Which standard report, dataset, return or saved definition this was ("STANDARD:broadsheet", "RETURN:<id>").
  code          String?
  /// The file itself, kept so a filed return can be downloaded again exactly as it was produced.
  content       String?
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  generatedBy   User?    @relation("GeneratedReportBy", fields: [generatedById], references: [id], onDelete: SetNull)

  @@index([schoolId, generatedAt])
}

/// One rung ladder a person is mapped onto. `steps` is [{ name, gross }]; `allowances` is
/// [{ name, who, basis, rate, treat }]. A band is the only way a person gets paid.
model PayBand {
  id              String         @id @default(cuid())
  schoolId        String
  code            String
  name            String
  covers          String
  coversGroup     String         @default("Other")
  steps           Json
  allowances      Json
  employerPension Float          @default(10)
  currency        String         @default("NGN")
  nextReview      DateTime?
  isOpen          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  school          School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff           StaffProfile[]

  @@unique([schoolId, code])
  @@index([schoolId, isOpen])
}

/// Money owed or paid outside the monthly run, with the reason it exists.
model OffCyclePayment {
  id           String       @id @default(cuid())
  schoolId     String
  staffId      String
  kind         String
  amount       Decimal      @db.Decimal(15, 2)
  payOn        DateTime
  reason       String
  recover      String       @default("Not recoverable")
  statutory    Boolean      @default(true)
  status       String       @default("AWAITING_APPROVAL")
  createdById  String?
  approvedById String?
  paidAt       DateTime?
  createdAt    DateTime     @default(now())
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff        StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([schoolId, status, payOn])
}

/// A correction asked for on a student's own record — before and after, with whoever asked and whoever decided.
model StudentChangeRequest {
  id            String    @id @default(cuid())
  schoolId      String
  studentId     String
  field         String
  before        String?
  after         String
  reason        String?
  evidence      String?
  status        String    @default("PENDING")
  requestedById String?
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime  @default(now())
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, status, createdAt])
  @@index([studentId])
}

/// Who may collect a child from the gate. A collector with no photograph on file cannot collect.
model AuthorisedCollector {
  id         String    @id @default(cuid())
  schoolId   String
  studentId  String?
  guardianId String?
  name       String
  relation   String
  phone      String
  photoFile  String?
  until      DateTime?
  addedById  String?
  createdAt  DateTime  @default(now())
  school     School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student    Student?  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian   Guardian? @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@index([schoolId, studentId])
}

/// Something a family sent in: a query, an explanation, a request. It has an owner, a state and an age.
model GuardianSubmission {
  id          String    @id @default(cuid())
  schoolId    String
  guardianId  String
  studentId   String?
  type        String
  detail      String
  state       String    @default("NEW")
  ownerUserId String?
  ownerName   String?
  ownerRole   String?
  outcome     String?
  channel     String?
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  guardian    Guardian  @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  student     Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([schoolId, state, createdAt])
}

/// A consent is recorded against the family, never the child — one guardian answers once.
model FamilyConsent {
  id           String   @id @default(cuid())
  schoolId     String
  guardianId   String
  typeCode     String
  status       String   @default("GIVEN")
  means        String?
  note         String?
  recordedById String?
  recordedAt   DateTime @default(now())
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  guardian     Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([guardianId, typeCode])
  @@index([schoolId, typeCode, status])
}

/// Everything the school has sent a family that is not a fee conversation: invitations, consent requests, merges.
model GuardianContact {
  id          String   @id @default(cuid())
  schoolId    String
  guardianId  String
  kind        String
  channel     String?
  summary     String
  detail      Json?
  createdById String?
  createdAt   DateTime @default(now())
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  guardian    Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@index([schoolId, guardianId, createdAt])
}

/// How this school is billed: its tier, what it expects to pay, and how it wants to be told. Rows are made when the school first changes something; until then the tier is read from the school's plan.
model SchoolSubscription {
  id             String    @id @default(cuid())
  schoolId       String    @unique
  tier           String    @default("STANDARD")
  ratePerStudent Decimal?  @db.Decimal(12, 2)
  baseSms        Int?
  baseWhatsapp   Int?
  autoRenew      Boolean   @default(false)
  remindDays     Int       @default(14)
  invoiceTo      String?
  receiptEmail   String?
  pendingTier    String?
  pendingFrom    DateTime?
  switchReason   String?
  keepCredits    Boolean   @default(true)
  autoTopup      Json?
  warnAt         Int       @default(2000)
  warnWho        String    @default("The Bursar")
  billingContact String?
  billingEmail   String?
  schoolContact  String?
  productOnly    Boolean   @default(true)
  dpoName        String?
  dpoEmail       String?
  hosting        String?
  retentionDays  Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

/// Every credit that came onto, or went off, the messaging wallet — so a balance can be explained.
model CreditLedger {
  id          String   @id @default(cuid())
  schoolId    String
  channel     String
  kind        String
  credits     Int
  amount      Decimal  @default(0) @db.Decimal(12, 2)
  invoiceId   String?
  method      String?
  note        String?
  createdById String?
  createdAt   DateTime @default(now())
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, channel, createdAt])
}

/// A full-school export: asked for with the password (and a code), noticed by the leadership, and downloadable once per dataset until it expires.
model FullExport {
  id            String    @id @default(cuid())
  schoolId      String
  requestedById String
  token         String    @unique
  datasets      Json
  rows          Int       @default(0)
  expiresAt     DateTime
  downloadedAt  DateTime?
  createdAt     DateTime  @default(now())
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
}

/// Closing the account is blocked until a full export has been downloaded.
model AccountClosureRequest {
  id            String   @id @default(cuid())
  schoolId      String
  requestedById String
  exportId      String?
  reason        String
  status        String   @default("REQUESTED")
  retentionDays Int      @default(90)
  createdAt     DateTime @default(now())
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
}

/// One arm's register for one day. Its presence is what separates "everyone was present"
/// from "nobody took the register" — the second is unknown, and is never counted as the first.
model AttendanceRegister {
  id             String    @id @default(cuid())
  schoolId       String
  classId        String
  termId         String
  date           DateTime
  /// DRAFT while the marker is still working; SUBMITTED once written to the day.
  status         String    @default("SUBMITTED")
  /// Marks entered but not submitted: { studentId: { status, reason } }.
  draft          Json?
  markedById     String
  startedAt      DateTime  @default(now())
  /// Null on registers that predate the clock — their marking time is not known.
  submittedAt    DateTime?
  roll           Int       @default(0)
  late           Boolean   @default(false)
  backdated      Boolean   @default(false)
  backdateReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([classId, date])
  @@index([schoolId, date])
  @@index([schoolId, markedById, date])
}

/// A change to a register already saved: the old mark, the new one, why, and who agreed.
model AttendanceCorrection {
  id            String    @id @default(cuid())
  schoolId      String
  classId       String
  studentId     String
  date          DateTime
  fromStatus    String
  toStatus      String
  /// SAME_DAY (free), PRIOR_DAY (needs approval), GUARDIAN (an explanation accepted).
  kind          String
  reasonCode    String
  explanation   String
  evidence      Boolean   @default(false)
  /// APPLIED, AWAITING, DECLINED.
  status        String
  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime  @default(now())
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status, createdAt])
  @@index([schoolId, studentId, date])
}

/// A formal chronic-absence case. It opens itself below the threshold and cannot be closed
/// without a recorded outcome.
model AttendanceCase {
  id           String    @id @default(cuid())
  schoolId     String
  studentId    String
  termId       String
  classId      String?
  openedAt     DateTime  @default(now())
  openedAtRate Float
  automatic    Boolean   @default(true)
  openedById   String?
  status       String    @default("OPEN")
  outcome      String?
  outcomeNote  String?
  closedAt     DateTime?
  closedById   String?
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([studentId, termId])
  @@index([schoolId, status])
}

/// One subject in one arm for one term: the unit a teacher enters, an Exam Officer approves
/// and a report card waits for. It pins the assessment framework it was entered under.
model ScoreSheet {
  id            String    @id @default(cuid())
  schoolId      String
  termId        String
  classId       String
  subjectId     String
  /// IN_PROGRESS, SUBMITTED, RETURNED, APPROVED. No row at all is "Not started".
  status        String    @default("IN_PROGRESS")
  /// The components this sheet was entered under, pinned: [{ id, code, name, max, weight }].
  framework     Json
  frameworkAt   DateTime  @default(now())
  /// Children marked absent from a component: { studentId: [componentId] }. Never stored as zero.
  absences      Json      @default("{}")
  /// Outcomes recorded against a verification flag: { key: { outcome, note, by, at } }.
  flagOutcomes  Json      @default("{}")
  enteredByIds  String[]  @default([])
  submittedById String?
  submittedAt   DateTime?
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  returnedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([termId, classId, subjectId])
  @@index([schoolId, termId, status])
}

/// A change to a score that has already been approved: the old mark, the new one, the reason
/// and the consequence, decided in two steps once a parent has seen the result.
model ScoreCorrection {
  id            String    @id @default(cuid())
  schoolId      String
  termId        String
  classId       String
  subjectId     String
  studentId     String
  sheetId       String?
  componentId   String
  componentName String
  fromScore     Float?
  toScore       Float
  reasonCode    String
  explanation   String
  evidence      String?
  /// AWAITING (first step), IN_REVIEW (second step), APPROVED, DECLINED.
  status        String    @default("AWAITING")
  reachedParent Boolean   @default(false)
  requestedById String
  stepOneById   String?
  stepOneAt     DateTime?
  stepOneNote   String?
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  /// Before/after average and position, written when it is decided.
  effect        Json?
  revision      Int?
  approvalId    String?
  createdAt     DateTime  @default(now())
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status, createdAt])
  @@index([schoolId, classId, subjectId])
}

/// What a form master or the Principal wrote about a child's term, kept as a draft until it is submitted
/// onto the card. A submitted remark is also written to the result sheet, where older readers look.
model ReportRemark {
  id          String    @id @default(cuid())
  schoolId    String
  studentId   String
  termId      String
  classId     String?
  /// FORM_MASTER or PRINCIPAL.
  author      String
  text        String
  tone        String?
  flags       String[]  @default([])
  /// DRAFT or SUBMITTED.
  state       String    @default("SUBMITTED")
  authorId    String
  onBehalf    Boolean   @default(false)
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([studentId, termId, author])
  @@index([schoolId, termId, classId])
}

/// Every version of a card that has reached a family. A correction is stored beside the original,
/// never over it.
model ReportCardRevision {
  id          String   @id @default(cuid())
  schoolId    String
  cardId      String
  studentId   String
  termId      String
  revision    Int
  /// ISSUE, CORRECTION or REISSUE.
  kind        String
  reason      String
  data        Json
  createdById String?
  notified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, cardId, revision])
  @@index([schoolId, termId])
}

/// A run of printing, publishing or sending: who did it, for what scope, how many cards, and when.
model CardBatch {
  id        String   @id @default(cuid())
  schoolId  String
  termId    String
  /// PRINT, PUBLISH, SEND or UNPUBLISH.
  kind      String
  scope     String
  cards     Int
  skipped   Int      @default(0)
  channels  String[] @default([])
  byId      String
  cardIds   String[] @default([])
  createdAt DateTime @default(now())
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, termId, createdAt])
}

/// A send: who it went to, what it cost, and where it got to.
///
/// Separate from `Campaign`, which carries no schoolId and belongs to platform
/// marketing. A school's send has to be scoped to the school, countable in
/// credits, and answerable to the mass-communication threshold.
model MessageCampaign {
  id             String                @id @default(cuid())
  schoolId       String
  name           String
  channel        NotificationChannel   @default(SMS)
  /// The criteria, kept as criteria rather than a frozen list, so a family who
  /// clears their fees drops out of a saved segment on its own.
  audience       Json?
  audienceLabel  String                @default("Guardians")
  body           String
  status         MessageCampaignStatus @default(DRAFT)
  /// Set when the send is above the school's threshold and needs a decision.
  thresholdAt    Int?
  scheduledAt    DateTime?
  sentAt         DateTime?
  recipientCount Int                   @default(0)
  deliveredCount Int                   @default(0)
  failedCount    Int                   @default(0)
  /// What it actually cost, in credits — never an estimate after the fact.
  creditsUsed    Int                   @default(0)
  decisionNote   String?
  createdById    String?
  approvedById   String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  school         School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy      User?                 @relation("MessageCampaignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy     User?                 @relation("MessageCampaignApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  deliveries     MessageDelivery[]

  @@index([schoolId, status, createdAt])
  @@index([schoolId, sentAt])
}

/// One recipient's outcome. The failures table is read from here, with the
/// reason attached to the row that fixes it rather than to the campaign.
model MessageDelivery {
  id            String                @id @default(cuid())
  schoolId      String
  campaignId    String
  guardianId    String?
  recipientName String
  destination   String?
  status        MessageDeliveryStatus @default(PENDING)
  /// Why it failed, in words somebody can act on.
  failureReason String?
  deliveredAt   DateTime?
  createdAt     DateTime              @default(now())
  school        School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campaign      MessageCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([campaignId, status])
}

/// A school's own message wording, versioned so a sent message always renders
/// as the version that was sent rather than as the template reads today.
model SchoolMessageTemplate {
  id         String              @id @default(cuid())
  schoolId   String
  name       String
  channel    NotificationChannel @default(SMS)
  body       String
  /// Merge fields the body uses, validated before a send unlocks.
  variables  String[]            @default([])
  owner      TemplateOwner       @default(SCHOOL)
  version    Int                 @default(1)
  lastUsedAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  school     School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, name])
  @@index([schoolId, owner])
}

enum MessageCampaignStatus {
  DRAFT
  AWAITING_APPROVAL
  SCHEDULED
  SENT
  CANCELLED
  RETURNED
}

enum MessageDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  EXCLUDED
}

/// Who owns the wording: the school, the system, or Future Realm's
/// pre-approved library.
enum TemplateOwner {
  SCHOOL
  SYSTEM
  PLATFORM
}

/// A return this school owes somebody: a ministry, a board, an examinations
/// council, an inspectorate. Unlike analytics, a return has a recipient, a
/// deadline and a format, and it is either filed or it is not.
model ComplianceReturn {
  id        String                 @id @default(cuid())
  schoolId  String
  name      String
  /// Who it goes to. Not an enum: every country has its own bodies.
  body      String
  period    String
  dueOn     DateTime
  format    String
  covers    String
  status    ComplianceReturnStatus @default(NOT_STARTED)
  filedOn   DateTime?
  /// The officer answerable for it, by role, so it survives them leaving.
  ownerRole String?
  ownerId   String?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  school    School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  owner     User?                  @relation("ComplianceReturnOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@unique([schoolId, name, period])
  @@index([schoolId, status, dueOn])
}

/// A data subject exercising a right. The clock is statutory, so the days left
/// are computed from receivedOn rather than stored and left to go stale.
model DataSubjectRequest {
  id            String                   @id @default(cuid())
  schoolId      String
  reference     String
  kind          DataSubjectRequestKind
  requesterName String
  /// Whose data it is about, when that is not the requester.
  subjectName   String?
  status        DataSubjectRequestStatus @default(OPEN)
  receivedOn    DateTime                 @default(now())
  /// Statutory response window in days — 30 under the NDPA, but set per case.
  dueDays       Int                      @default(30)
  closedOn      DateTime?
  outcome       String?
  ownerId       String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  school        School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  owner         User?                    @relation("DataSubjectRequestOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@unique([schoolId, reference])
  @@index([schoolId, status, receivedOn])
}

/// How long a class of data is kept, and on what basis.
///
/// The one control on the Data Protection tab that cannot be derived: it has to
/// be decided and then enforced. Until a row exists, the honest answer is that
/// the data is held indefinitely.
model RetentionPolicy {
  id        String   @id @default(cuid())
  schoolId  String
  dataClass String
  /// Null means permanent — a transcript may be asked for decades later.
  years     Int?
  untilAge  Int?
  basis     String
  hostedIn  String   @default("Nigeria")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, dataClass])
}

/// Something a monitor found that a person should look at. Raised by the
/// integrity checks, cleared by somebody who says why.
model IntegrityFlag {
  id           String              @id @default(cuid())
  schoolId     String
  monitor      String
  detail       String
  severity     IntegritySeverity   @default(ATTENTION)
  status       IntegrityFlagStatus @default(OPEN)
  entityType   String?
  entityId     String?
  resolution   String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  school       School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  resolvedBy   User?               @relation("IntegrityFlagResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([schoolId, status, createdAt])
}

enum ComplianceReturnStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  FILED
  AMENDED
}

enum DataSubjectRequestKind {
  ACCESS
  CORRECTION
  ERASURE
  PORTABILITY
  OBJECTION
}

enum DataSubjectRequestStatus {
  OPEN
  RESPONDED
  CLOSED
  REFUSED
}

enum IntegritySeverity {
  NORMAL
  ATTENTION
  CRITICAL
}

enum IntegrityFlagStatus {
  OPEN
  RESOLVED
  DISMISSED
}
