  @@index([schoolId, startsAt, mandatory])
}

model TrainingParticipant {
  id                String                    @id @default(cuid())
  schoolId          String
  trainingProgramId String
  staffId           String?
  userId            String
  status            TrainingParticipantStatus @default(INVITED)
  attendedAt        DateTime?
  completedAt       DateTime?
  certificateUrl    String?
  cpdPoints         Float                     @default(0)
  notes             String?
  feedback          String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  school            School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  trainingProgram   TrainingProgram           @relation(fields: [trainingProgramId], references: [id], onDelete: Cascade)
  staff             StaffProfile?             @relation(fields: [staffId], references: [id], onDelete: SetNull)
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([trainingProgramId, userId])
  @@index([schoolId, userId, status])
}

model FeeCategory {
  id                  String        @id @default(cuid())
  schoolId            String
  school              School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  isMandatory         Boolean       @default(true)
  isRecurring         Boolean       @default(true)
  appliesToCategories String[]      @default([])
  sortOrder           Int           @default(0)
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())
  feeItems            FeeItem[]
  invoiceItems        InvoiceItem[]
  feeWaivers          FeeWaiver[]

  @@unique([schoolId, name])
  @@index([schoolId, isActive, sortOrder])
  @@map("fee_categories")
}

model FeeItem {
  id                String           @id @default(cuid())
  schoolId          String
  feeCategoryId     String
  classId           String?
  classLevel        String?
  classCategory     String?
  academicSessionId String?
  termId            String?
  school            School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feeCategory       FeeCategory      @relation(fields: [feeCategoryId], references: [id], onDelete: Restrict)
  classRoom         ClassRoom?       @relation(fields: [classId], references: [id], onDelete: SetNull)
  academicSession   AcademicSession? @relation(fields: [academicSessionId], references: [id], onDelete: SetNull)
  term              Term?            @relation(fields: [termId], references: [id], onDelete: SetNull)
  amount            Decimal          @db.Decimal(12, 2)
  currency          String           @default("NGN")
  dueDate           DateTime?
  lateFeeAmount     Decimal          @default(0) @db.Decimal(12, 2)
  lateFeeType       LateFeeType      @default(FIXED)
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  invoiceItems      InvoiceItem[]
  feeWaivers        FeeWaiver[]

  @@index([schoolId, academicSessionId, termId, classId, isActive])
  @@index([schoolId, classLevel, classCategory])
  @@map("fee_items")
}

model FeeStructure {
  id                String              @id @default(cuid())
  schoolId          String
  academicSessionId String?
  termId            String?
  classId           String?
  createdById       String?
  school            School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession   AcademicSession?    @relation(fields: [academicSessionId], references: [id], onDelete: SetNull)
  term              Term?               @relation(fields: [termId], references: [id], onDelete: SetNull)
  classRoom         ClassRoom?          @relation(fields: [classId], references: [id], onDelete: SetNull)
  name              String
  currency          String              @default("NGN")
  studentCategory   String?
  recurrence        FeeRecurrence       @default(TERM)
  isOneTime         Boolean             @default(false)
  dueDate           DateTime?
  visibilityRules   Json?
  isActive          Boolean             @default(true)
  /// DRAFT until someone publishes it, ARCHIVED once the term it belonged to has closed.
  /// A draft is also inactive, so nothing is billed from a list nobody has published.
  listState         String              @default("PUBLISHED")
  /// The person a family's question about the list comes back to.
  ownerName         String?
  /// Prints under the list: "All books must be covered and named before resumption."
  familyNote        String?
  /// Quoted on every invoice generated from it: FS-SS-D.
  ref               String?
  /// Day, Boarding supplement, Concession, Transport or One-off. A class sits on one structure of each kind.
  kind              String              @default("Day")
  /// A structure that charges every class, like the staff-children concession.
  allClasses        Boolean             @default(false)
  levels            FeeStructureLevel[]
  items             FeeStructureItem[]
  feeAssignments    FeeAssignment[]
  invoices          Invoice[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?

  @@index([schoolId, academicSessionId, termId, classId, isActive, deletedAt])
}

model FeeAssignment {
  id                String              @id @default(cuid())
  schoolId          String
  studentId         String
  feeStructureId    String
  invoiceId         String?
  academicSessionId String?
  termId            String?
  amountDue         Decimal             @db.Decimal(15, 2)
  discount          Decimal             @default(0) @db.Decimal(15, 2)
  finalAmount       Decimal             @db.Decimal(15, 2)
  dueDate           DateTime?
  status            FeeAssignmentStatus @default(UNPAID)
  discountReason    String?
  approvalStatus    String?
  createdById       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  school            School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student           Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure      FeeStructure        @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  invoice           Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  academicSession   AcademicSession?    @relation(fields: [academicSessionId], references: [id], onDelete: SetNull)
  term              Term?               @relation(fields: [termId], references: [id], onDelete: SetNull)

  @@index([schoolId, studentId, status])
  @@index([schoolId, academicSessionId, termId])
  @@index([schoolId, feeStructureId])
}

model FeeStructureItem {
  id             String           @id @default(cuid())
  feeStructureId String
  feeStructure   FeeStructure     @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  label          String
  componentType  FeeComponentType @default(OTHER)
  /// What a family is asked to buy, e.g. 2 sets of the daily uniform. `amount`
  /// stays the line total, so nothing that reads a structure has to multiply.
  quantity       Int              @default(1)
  /// The unit price, kept beside the line total so a printed list can show both.
  unitAmount     Decimal?         @db.Decimal(12, 2)
  /// What the item actually is, in the school's own words — "Hardback, 80 leaves".
  note           String?
  /// The school's own grouping for a printed list: Books, Uniform, Boarding kit.
  category       String?
  /// Where a family may buy it: "Any stationer", "School store only" …
  source         String?
  /// A named supplier, when the school names one.
  supplier       String?
  /// Who is asked for it: EVERYONE, BOARDERS or DAY.
  audience       String           @default("EVERYONE")
  /// Whether the printed sheet shows this line's price.
  showPrice      Boolean          @default(true)
  amount         Decimal          @db.Decimal(12, 2)
  isOptional     Boolean          @default(false)
  isActive       Boolean          @default(true)
  dueDate        DateTime?
  /// Mandatory, Optional or Concession. An optional item is billed only to the families who elect it.
  itemType       String           @default("Mandatory")
  /// Termly, Sessional or Once.
  frequency      String           @default("Termly")
}

/// The classes a fee structure charges. A class level sits on one structure of each kind at a time.
model FeeStructureLevel {
  id             String       @id @default(cuid())
  feeStructureId String
  classLevelId   String
  kind           String       @default("Day")
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  classLevel     ClassLevel   @relation(fields: [classLevelId], references: [id], onDelete: Cascade)

  @@unique([feeStructureId, classLevelId])
  @@index([classLevelId, kind])
}

/// Everything the school does about a family's balance: a reminder sent, a meeting asked for, a plan agreed.
model FeeContact {
  id          String    @id @default(cuid())
  schoolId    String
  guardianId  String?
  studentId   String?
  /// REMINDER, MEETING, PLAN, ADJUSTMENT, WRITE_OFF or NOTE.
  kind        String
  channel     String?
  summary     String
  detail      Json?
  meetingAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, guardianId, createdAt])
  @@index([schoolId, kind, createdAt])
}

/// A day's takings, counted against what was recorded. Closed once somebody has counted and signed it off.
model CashUpDay {
  id            String    @id @default(cuid())
  schoolId      String
  day           DateTime  @db.Date
  countedAmount Decimal?  @db.Decimal(15, 2)
  note          String?
  countedById   String?
  countedAt     DateTime?
  closedById    String?
  closedAt      DateTime?
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, day])
}

model Invoice {
  id                String              @id @default(cuid())
  schoolId          String
  studentId         String
  classId           String?
  academicSessionId String?
  termId            String?
  feeStructureId    String?
  createdById       String?
  invoiceNumber     String
  issuedOn          DateTime
  dueOn             DateTime
  subtotal          Decimal             @db.Decimal(12, 2)
  discount          Decimal             @db.Decimal(12, 2)
  fine              Decimal             @db.Decimal(12, 2)
  total             Decimal             @db.Decimal(12, 2)
  balance           Decimal             @db.Decimal(12, 2)
  status            InvoiceStatus
  school            School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student           Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classRoom         ClassRoom?          @relation(fields: [classId], references: [id], onDelete: SetNull)
  academicSession   AcademicSession?    @relation(fields: [academicSessionId], references: [id], onDelete: SetNull)
  term              Term?               @relation(fields: [termId], references: [id], onDelete: SetNull)
  feeStructure      FeeStructure?       @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
  createdBy         User?               @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items             InvoiceItem[]
  payments          Payment[]
  allocations       PaymentAllocation[]
  receipts          Receipt[]
  adjustments       InvoiceAdjustment[]
  feeAssignments    FeeAssignment[]
  feeWaivers        FeeWaiver[]
  installmentPlans  InstallmentPlan[]

  @@unique([schoolId, invoiceNumber])
  @@index([schoolId, studentId, status])
  @@index([schoolId, dueOn])
  @@index([schoolId, academicSessionId, termId, classId])
}

model InvoiceItem {
  id            String       @id @default(cuid())
  invoiceId     String
  feeItemId     String?
  feeCategoryId String?
  invoice       Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeItem       FeeItem?     @relation(fields: [feeItemId], references: [id], onDelete: SetNull)
  feeCategory   FeeCategory? @relation(fields: [feeCategoryId], references: [id], onDelete: SetNull)
  description   String
  amount        Decimal      @db.Decimal(12, 2)
  quantity      Int          @default(1)
  isWaived      Boolean      @default(false)
  waiverReason  String?
  createdAt     DateTime     @default(now())
  feeWaivers    FeeWaiver[]
}

model Payment {
  id                    String                    @id @default(cuid())
  schoolId              String
  studentId             String
  invoiceId             String?
  recordedById          String?
  reversedById          String?
  reference             String
  paymentNumber         String?
  provider              String?
  providerTransactionId String?
  amount                Decimal                   @db.Decimal(12, 2)
  currency              String                    @default("NGN")
  status                PaymentStatus
  method                PaymentMethod
  paymentChannel        String?
  gateway               PaymentGatewayProvider?
  gatewayReference      String?
  gatewayStatus         GatewayTransactionStatus?
  schoolBankReference   String?
  receiptNumber         String?
  paidAt                DateTime?
  metadata              Json?
  school                School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student               Student                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  invoice               Invoice?                  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  recordedBy            User?                     @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  reversedBy            User?                     @relation("PaymentReversedBy", fields: [reversedById], references: [id], onDelete: SetNull)
  verifiedAt            DateTime?
  isReversed            Boolean                   @default(false)
  reversedAt            DateTime?
  reversalReason        String?
  allocations           PaymentAllocation[]
  receipts              Receipt[]
  gatewayTransactions   GatewayTransaction[]

  @@unique([schoolId, reference])
  @@unique([schoolId, paymentNumber])
  @@unique([schoolId, gatewayReference])
  @@index([schoolId, studentId, status])
  @@index([schoolId, paidAt])
  @@index([schoolId, gateway, gatewayStatus])
}

model PaymentAllocation {
  id        String   @id @default(cuid())
  schoolId  String
  paymentId String
  invoiceId String
  amount    Decimal  @db.Decimal(12, 2)
  metadata  Json?
  createdAt DateTime @default(now())
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([schoolId, invoiceId])
  @@index([schoolId, paymentId])
}

model Receipt {
  id            String        @id @default(cuid())
  schoolId      String
  invoiceId     String
  paymentId     String?
  issuedById    String?
  receiptNumber String
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("NGN")
  status        ReceiptStatus @default(ISSUED)
  issuedAt      DateTime      @default(now())
  filePath      String?
  sentToParent  Boolean       @default(false)
  sentAt        DateTime?
  metadata      Json?
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payment       Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  issuedBy      User?         @relation("ReceiptIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)

  @@unique([schoolId, receiptNumber])
  @@index([schoolId, invoiceId])
}

model InvoiceAdjustment {
  id           String                @id @default(cuid())
  schoolId     String
  invoiceId    String
  appliedById  String?
  approvedById String?
  type         InvoiceAdjustmentType
  valueType    AdjustmentValueType   @default(FIXED)
  value        Decimal               @db.Decimal(12, 2)
  amount       Decimal               @db.Decimal(12, 2)
  reason       String
  createdAt    DateTime              @default(now())
  metadata     Json?
  invoice      Invoice               @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([schoolId, invoiceId, type])
}

model FeeWaiver {
  id            String          @id @default(cuid())
  schoolId      String
  studentId     String
  invoiceId     String
  feeItemId     String?
  invoiceItemId String?
  feeCategoryId String?
  waiverType    FeeWaiverType
  amount        Decimal         @default(0) @db.Decimal(12, 2)
  percentage    Decimal?        @db.Decimal(5, 2)
  reason        String
  requestedById String?
  approvedById  String?
  approvedAt    DateTime?
  status        FeeWaiverStatus @default(PENDING)
  createdAt     DateTime        @default(now())
  school        School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student       Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  invoice       Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeItem       FeeItem?        @relation(fields: [feeItemId], references: [id], onDelete: SetNull)
  invoiceItem   InvoiceItem?    @relation(fields: [invoiceItemId], references: [id], onDelete: SetNull)
  feeCategory   FeeCategory?    @relation(fields: [feeCategoryId], references: [id], onDelete: SetNull)
  requestedBy   User?           @relation("FeeWaiverRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedBy    User?           @relation("FeeWaiverApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([schoolId, studentId, status])
  @@index([schoolId, invoiceId, status])
  @@map("fee_waivers")
}

model Scholarship {
  id                  String               @id @default(cuid())
  schoolId            String
  name                String
  description         String?
  type                ScholarshipType
  amount              Decimal              @default(0) @db.Decimal(12, 2)
  percentage          Decimal?             @db.Decimal(5, 2)
  fundedBy            String?
  conditions          String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentScholarships StudentScholarship[]

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
  @@map("scholarships")
}

model StudentScholarship {
  id                String           @id @default(cuid())
  schoolId          String
  scholarshipId     String
  studentId         String
  academicSessionId String?
  approvedById      String?
  approvedAt        DateTime?
  validFrom         DateTime
  validTo           DateTime?
  notes             String?
  school            School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  scholarship       Scholarship      @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  student           Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicSession   AcademicSession? @relation(fields: [academicSessionId], references: [id], onDelete: SetNull)
  approvedBy        User?            @relation("StudentScholarshipApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([scholarshipId, studentId, academicSessionId])
  @@index([schoolId, studentId])
  @@map("student_scholarships")
}

model PaymentGatewayConfig {
  id            String                 @id @default(cuid())
  schoolId      String
  gateway       PaymentGatewayProvider
  publicKey     String?
  secretKey     String?
  webhookSecret String?
  isActive      Boolean                @default(false)
  isPrimary     Boolean                @default(false)
  testMode      Boolean                @default(true)
  createdById   String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  school        School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy     User?                  @relation("PaymentGatewayConfigCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([schoolId, gateway])
  @@index([schoolId, isActive, isPrimary])
  @@map("payment_gateways_config")
}

model GatewayTransaction {
  id              String                 @id @default(cuid())
  schoolId        String
  paymentId       String?
  gateway         PaymentGatewayProvider
  eventType       String
  reference       String
  amount          Decimal                @default(0) @db.Decimal(12, 2)
  currency        String                 @default("NGN")
  customerEmail   String?
  customerPhone   String?
  gatewayResponse Json
  processed       Boolean                @default(false)
  processedAt     DateTime?
  createdAt       DateTime               @default(now())
  school          School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payment         Payment?               @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([gateway, reference, eventType])
  @@index([schoolId, gateway, processed])
  @@index([schoolId, reference])
  @@map("gateway_transactions")
}

model InstallmentPlan {
  id          String                @id @default(cuid())
  schoolId    String
  studentId   String
  invoiceId   String?
  createdById String?
  planNumber  String
  totalAmount Decimal               @db.Decimal(12, 2)
  balance     Decimal               @db.Decimal(12, 2)
  status      InstallmentStatus     @default(PENDING)
  notes       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  student     Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  invoice     Invoice?              @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  items       InstallmentPlanItem[]

  @@unique([schoolId, planNumber])
  @@index([schoolId, studentId, status])
}

model InstallmentPlanItem {
  id         String            @id @default(cuid())
  planId     String
  dueOn      DateTime
  amount     Decimal           @db.Decimal(12, 2)
  paidAmount Decimal           @default(0) @db.Decimal(12, 2)
  status     InstallmentStatus @default(PENDING)
  plan       InstallmentPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, dueOn])
}

model FinancialClearance {
  id                     String                   @id @default(cuid())
  schoolId               String
  studentId              String?
  admissionApplicationId String?
  invoiceId              String?
  clearedById            String?
  status                 FinancialClearanceStatus @default(PENDING)
  reason                 String?
  clearedAt              DateTime?
  createdAt              DateTime                 @default(now())
  metadata               Json?
  student                Student?                 @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([schoolId, studentId, status])
  @@index([schoolId, admissionApplicationId])
}

model Expense {
  id            String    @id @default(cuid())
  schoolId      String
  title         String
  category      String
  amount        Decimal   @db.Decimal(12, 2)
  paymentMethod String?
  paidTo        String?
  receiptUrl    String?
  recordedById  String?
  expenseDate   DateTime
  notes         String?
  deletedAt     DateTime?
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, category, expenseDate])
}

model PayrollRun {
  id                String           @id @default(cuid())
  schoolId          String
  academicSessionId String?
  month             Int
  year              Int
  status            PayrollRunStatus @default(DRAFT)
  processedById     String?
  processedAt       DateTime?
  publishedAt       DateTime?
  metadata          Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  school            School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession   AcademicSession? @relation(fields: [academicSessionId], references: [id], onDelete: SetNull)
  items             PayrollItem[]

  @@unique([schoolId, month, year])
  @@index([schoolId, status, year, month])
}

model PayrollItem {
  id           String       @id @default(cuid())
  schoolId     String
  payrollRunId String
  staffId      String
  basicSalary  Decimal      @db.Decimal(15, 2)
  allowances   Json?
  deductions   Json?
  netSalary    Decimal      @db.Decimal(15, 2)
  payslipSent  Boolean      @default(false)
  paidAt       DateTime?
  /// DRAFT, AWAITING_APPROVAL, HELD or PAID. A held line stays on the run and in its total.
