model Campus {
  id         String                 @id @default(cuid())
  schoolId   String
  school     School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name       String
  code       String
  address    String?
  phone      String?
  createdAt  DateTime               @default(now())
  classRooms ClassRoom[]
  students   Student[]
  staff      StaffProfile[]
  admissions AdmissionApplication[]
  events     CalendarEvent[]

  @@unique([schoolId, code])
}

model AcademicSession {
  id                            String                         @id @default(cuid())
  schoolId                      String
  school                        School                         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name                          String
  startDate                     DateTime
  endDate                       DateTime
  isCurrent                     Boolean                        @default(false)
  students                      Student[]
  terms                         Term[]
  classAcademicAssignments      ClassAcademicAssignment[]
  curriculumTopics              CurriculumTopic[]
  schemeOfWork                  SchemeOfWork[]
  promotionsFrom                PromotionRecord[]              @relation("PromotionFromSession")
  promotionsTo                  PromotionRecord[]              @relation("PromotionToSession")
  hostelAllocs                  HostelAllocation[]
  feeStructures                 FeeStructure[]
  feeAssignments                FeeAssignment[]
  feeItems                      FeeItem[]
  invoices                      Invoice[]
  payrollRuns                   PayrollRun[]
  budgetAllocations             BudgetAllocation[]
  studentScholarships           StudentScholarship[]
  AdmissionApplication          AdmissionApplication[]
