model ProfileDocument {
  id                 String    @id @default(cuid())
  schoolId           String
  userId             String
  title              String
  type               String
  fileName           String?
  fileUrl            String?
  mimeType           String?
  sizeBytes          Int?
  verificationStatus String    @default("PENDING")
  notes              String?
  uploadedById       String?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  school             School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user               User      @relation("ProfileDocumentUser", fields: [userId], references: [id], onDelete: Cascade)
  uploadedBy         User?     @relation("ProfileDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([schoolId, userId, deletedAt])
  @@index([schoolId, type, verificationStatus])
}

model ProfileEditRequest {
  id            String    @id @default(cuid())
  schoolId      String
  targetUserId  String
  requestedById String
  reviewedById  String?
  fields        Json
  reason        String?
  status        String    @default("PENDING")
  reviewComment String?
  reviewedAt    DateTime?
